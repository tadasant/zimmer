# Copy to staging.tfvars and fill in. SECRETS are NOT set here -- pass them as
# TF_VAR_do_token / TF_VAR_tailscale_auth_key / TF_VAR_deploy_ssh_pubkey via env
# (CI: GitHub Actions secrets). This file holds only non-secret configuration and
# may be committed as an example.
#
# The app image, env, and data stores are NOT configured here anymore -- Kamal owns
# them (config/deploy.staging.yml). Terraform only provisions the persistent host.
environment          = "staging"
region               = "nyc3"
droplet_size         = "s-2vcpu-4gb"
ssh_key_fingerprints = [] # DO-registered SSH key fingerprints. Leave EMPTY: this argument is
# ForceNew on the droplet, so adding one here makes the deploy workflow's auto-approved
# `terraform apply` destroy and recreate the box without reaping the tailnet node. Authorize
# operator keys through admin_ssh_pubkeys instead -- the ADMIN_SSH_PUBKEYS Actions variable,
# see below -- because it rides cloud-init, which is under `ignore_changes`, so it can never
# force-replace the droplet.

# Admin/tooling SSH public keys authorized for root, on top of the Kamal deploy key.
# cloud-init appends them to /root/.ssh/authorized_keys, and they are reachable ONLY over
# the tailnet on :2222 (real OpenSSH; tailnet :22 is Tailscale SSH, which ignores publickey).
#
# NO KEY IS SET HERE, AND NONE MAY BE. This file is committed and the repository is
# public, while `deploy-staging.yml` runs `cp staging.tfvars.example staging.tfvars`
# VERBATIM -- so a key committed here is a key authorized for root on the droplet of
# whoever runs that workflow, which for a fork means a stranger's key on their own box.
# The deploy passes the list in as TF_VAR_admin_ssh_pubkeys from the ADMIN_SSH_PUBKEYS
# Actions variable instead (a JSON list of strings), so a fork that never sets it falls
# through to the module default of [].
#
# Un-commenting the line below does NOT "also" authorize the CI keys -- it REPLACES them.
# A `-var-file` value beats TF_VAR_* in Terraform's precedence order, so an assignment in
# this file silently wins over whatever the workflow exports. Set it locally only:
#
#   admin_ssh_pubkeys = ["ssh-ed25519 AAAA...replace-with-your-own-key you@example.com"]
#
# for a local `terraform apply -var-file=staging.tfvars` (your copy is gitignored). Put
# YOUR key in it, never someone else's, and do not commit it back into this example --
# test/infra/staging_tfvars_example_test.rb fails the build if key material or an active
# assignment reappears here.
#
# AN EMPTY LIST IS A WORKING DROPLET, NOT A BRICK. The Kamal deploy key is its own
# variable (TF_VAR_deploy_ssh_pubkey), so CI still deploys; humans on the tailnet still
# reach the box over Tailscale SSH on :22, which authenticates by tailnet identity. What
# an empty list costs is the publickey door on :2222 -- the ssh-* MCP servers in an agent
# session cannot attach, and there is no OpenSSH break-glass login for when the tailnet
# identity path is itself the thing that is broken.
#
# WHAT THE VARIABLE HOLDS, for this repo: the `zimmer-production-operator` key that
# Zimmer's own agent sessions carry (its private half rides Kamal's env.secret as
# ZIMMER_OPERATOR_SSH_KEY, and OperatorSshKeyProvisioner writes it into the container),
# the off-box orchestrator's key, and the maintainer's laptop key for break-glass. The
# operator key is authorized on STAGING and deliberately NOT on production, because the
# sessions holding it RUN ON production and this variable is root: a session with root on
# its own host can stop the containers out from under the service executing it. Staging
# is disposable, so the same key here costs a rebuild at worst -- and reaching staging is
# the point. If you are "fixing" that drift: don't. See
# docs/operate/ssh-access.md#who-is-authorized-where.
#
# Production's list is not this variable at all: it lives in the private companion repo
# (zimmer/admin_authorized_keys.pub) and is converged live by its own workflow. Nothing in
# THIS repo authorizes a key on production.
#
# Either way the list takes effect on the NEXT droplet creation only -- cloud-init runs
# once, and the droplet's lifecycle block ignores user_data changes -- so a live box also
# needs the key appended to /root/.ssh/authorized_keys by hand.

# Custom-domain HTTPS over the tailnet: turns on the Caddy TLS terminator on :443,
# fronting kamal-proxy. The cert and the `domain -> tailnet IP` A record are managed
# by the `domain-cert-staging` workflow (ACME DNS-01 via Cloudflare), NOT Terraform.
domain = "staging.zimmer.tadasant.com"

# Staging runs its own throwaway Postgres accessory via Kamal, so no managed cluster.
# Production sets this to a Managed Postgres cluster name so the DB survives rebuilds.
managed_db_cluster_name = ""
