# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Extensions are NOT baked into the core image. The extension registry
# auto-skips any missing app/extensions/<id>/ directory and falls back to the
# native path, so the core image ships without them. Operators opt in per
# extension via scripts/install-extension.sh.
/app/extensions/*/

# The documentation site is a standalone Astro project deployed to Cloudflare
# Pages. The Rails image never serves it, and the docs are single-source: a copy
# inside the image would be a second, drift-prone one that nobody deploys and
# nobody keeps true.
#
# This line is the only thing standing between the docs and the blanket `COPY . .`
# in Dockerfile, so it does not stand alone: scripts/assert-docs-excluded.sh runs
# against the final image in Dockerfile and against the build context in CI's
# image_excludes_docs job. Move the docs and you must move this line with them --
# the checks look for the docs by content, not by this path, and will fail.
