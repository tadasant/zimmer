<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CarPlay, as a voice-based conversational app (iOS 26.4+). Apple granted it to the team as a
  managed capability, and it is enabled on the App ID com.tadasant.zimmer. Signed into every
  build by `ios/bin/testflight` (merged with Push.entitlements when push is on); its guard
  refuses this file if it ever asks for anything but this key. Not set in the project's build
  settings, so a simulator build stays unsigned. See ios/README.md, "CarPlay".
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-voice-based-conversation</key>
	<true/>
</dict>
</plist>
