#!/usr/bin/env bash
#
# Archive the iOS app for a device, and optionally sign it and upload it to TestFlight.
#
#   ios/bin/testflight check    # ad hoc signed Release archive + assertions. No credential.
#   ios/bin/testflight upload   # the same, then sign, upload, and wait for processing.
#
# `check` is what the `ios` CI job runs on every change under ios/**, so the half of the
# pipeline that needs no Apple account is proven on every PR — the Release configuration,
# the device SDK, the icon, the Info.plist keys App Store Connect reads. `upload` is what
# `.github/workflows/testflight.yml` runs, and it is the same archive with signing and an
# upload after it rather than a second build path.
#
# A script rather than YAML for the reason `ios/bin/build-app` is one: a check that exists
# only in a workflow cannot be run by hand.
#
# SIGNING HAPPENS AT EXPORT, IN APPLE'S CLOUD. The archive is signed ad hoc; `-exportArchive`
# with `-allowProvisioningUpdates` and an App Store Connect API key (Admin role) signs it
# with the team's cloud-managed distribution certificate and creates the App Store
# provisioning profile itself. So there is no .p12, no profile and no keychain to import
# on the runner — one key is the whole credential. `ZIMMER_SIGNING=archive` is the fallback
# if export-time signing is ever refused: it signs during the archive instead, which also
# works from the key alone but mints a development certificate per run.
#
# TWO ENTITLEMENTS FILES ARE ADMITTED, each by name and with the one key it may ask for:
#   App/Zimmer/CarPlay.entitlements  com.apple.developer.carplay-voice-based-conversation,
#                                    always (Apple granted it; it is ticked on the App ID)
#   App/Zimmer/Push.entitlements     aps-environment, only when ZIMMER_IOS_PUSH_ENABLED=1
#                                    (set once Push Notifications is ticked on the App ID)
# An entitlement the App ID lacks fails a build to *sign*, not merely to lack the feature.
# With push on, the two are merged into one file under the work directory. The guard below
# refuses any other file, and either file if it asks for a key beyond its own.
#
# THE ARCHIVE IS SIGNED AD HOC, so it carries those entitlements. Export re-signs the app
# with the entitlements it finds in the archived binary, and an archive built with signing
# off has none: the upload would succeed and CarPlay would silently never connect. An ad
# hoc signature needs no certificate, so `check` signs the same way and proves on every PR
# that the archived app carries the admitted keys.
#
# `upload` reads, and never prints:
#   APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_ISSUER_ID,
#   APP_STORE_CONNECT_API_KEY_P8 (the .p8's contents), APPLE_TEAM_ID
# and, in both modes:
#   ZIMMER_BUILD_NUMBER            CFBundleVersion, default 1
#   ZIMMER_IOS_PUSH_ENABLED        1 to sign in App/Zimmer/Push.entitlements too; anything else, CarPlay only
#   ZIMMER_IOS_WEB_BASE_URL        where the build signs in (the OAuth issuer), https origin
#   ZIMMER_IOS_API_BASE_URL        where its machine calls go (the app host), https origin
#                                 Either alone means one origin for both; upload needs one.
set -euo pipefail

cd "$(dirname "$0")/.."

readonly BUNDLE_ID="com.tadasant.zimmer"
mode="${1:-}"

case "$mode" in
  check | upload) ;;
  *)
    printf 'usage: ios/bin/testflight check|upload\n' >&2
    exit 2
    ;;
esac

fail() {
  printf '\n\033[1;31m==> FAILED: %s\033[0m\n\n' "$1" >&2
  exit 1
}

if ! command -v xcodebuild >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    fail "no Xcode in CI — refusing to report green on an app nothing archived"
  fi
  printf '\n\033[1;33m==> SKIPPED: the iOS archive (no Xcode)\033[0m\n'
  printf '    Needs a Mac. CI archives it on a GitHub-hosted macOS runner; see ios/README.md.\n\n'
  exit 0
fi

build_number="${ZIMMER_BUILD_NUMBER:-1}"
base_url="${ZIMMER_IOS_API_BASE_URL:-}"
web_url="${ZIMMER_IOS_WEB_BASE_URL:-}"
push_enabled="${ZIMMER_IOS_PUSH_ENABLED:-}"
readonly PUSH_ENTITLEMENTS="Zimmer/Push.entitlements"
readonly CARPLAY_ENTITLEMENTS="Zimmer/CarPlay.entitlements"
readonly CARPLAY_KEY="com.apple.developer.carplay-voice-based-conversation"
signing="${ZIMMER_SIGNING:-export}"

# CFBundleVersion is one to three period-separated integers, and App Store Connect refuses
# a repeat for the same marketing version. The workflow passes run_number.run_attempt.
[[ "$build_number" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]] || fail "ZIMMER_BUILD_NUMBER '$build_number' is not a CFBundleVersion"
[ -z "$base_url" ] || [[ "$base_url" =~ ^https://[^/[:space:]]+/?$ ]] ||
  fail "ZIMMER_IOS_API_BASE_URL must be an https origin (it is refused by the app otherwise)"
[ -z "$web_url" ] || [[ "$web_url" =~ ^https://[^/[:space:]]+/?$ ]] ||
  fail "ZIMMER_IOS_WEB_BASE_URL must be an https origin (it is refused by the app otherwise)"
[[ "$signing" == export || "$signing" == archive ]] || fail "ZIMMER_SIGNING must be 'export' or 'archive'"

work="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/zimmer-testflight-$$"
mkdir -p "$work"
key_path=""
cleanup() {
  # The key first and unconditionally: a hosted runner is ephemeral, a laptop is not.
  if [ -n "$key_path" ]; then rm -f "$key_path"; fi
  rm -rf "$work"
}
trap cleanup EXIT

auth_args=()
if [ "$mode" = upload ]; then
  for name in APP_STORE_CONNECT_API_KEY_ID APP_STORE_CONNECT_API_ISSUER_ID APP_STORE_CONNECT_API_KEY_P8 APPLE_TEAM_ID; do
    [ -n "${!name:-}" ] || fail "$name is not set — see ios/README.md, 'Distribution'"
  done
  [ -n "$base_url$web_url" ] || fail "neither ZIMMER_IOS_WEB_BASE_URL nor ZIMMER_IOS_API_BASE_URL is set; a TestFlight build would ask for a server on first run"

  key_path="$work/AuthKey_${APP_STORE_CONNECT_API_KEY_ID}.p8"
  (umask 077 && printf '%s\n' "$APP_STORE_CONNECT_API_KEY_P8" >"$key_path")
  export APP_STORE_CONNECT_API_KEY_PATH="$key_path"
  auth_args=(
    -allowProvisioningUpdates
    -authenticationKeyPath "$key_path"
    -authenticationKeyID "$APP_STORE_CONNECT_API_KEY_ID"
    -authenticationKeyIssuerID "$APP_STORE_CONNECT_API_ISSUER_ID"
  )

  printf '==> checking the key and the app record before archiving\n'
  python3 tools/app_store_connect.py preflight --bundle-id "$BUNDLE_ID"
fi

printf '    using %s\n' "$(xcodebuild -version | head -1)"
printf '==> archiving build %s (signing: %s)\n' "$build_number" "$([ "$mode" = check ] && echo 'ad hoc' || echo "$signing")"

archive="$work/Zimmer.xcarchive"

# One list of build settings for the guard and the archive, so what is inspected is what is
# built. Never empty, because macOS's bash is 3.2, where "${empty[@]}" under `set -u` is an
# unbound-variable error.
build_settings=(
  CURRENT_PROJECT_VERSION="$build_number"
  ZIMMER_DEFAULT_API_BASE_URL="$base_url"
  ZIMMER_DEFAULT_WEB_BASE_URL="$web_url"
)
# The key set of a plist, from a JSON rendering rather than by splitting text: a value
# containing " = " must not be able to hide a second key.
plist_keys() {
  plutil -convert json -o - "$1" | python3 -c 'import json, sys; print(" ".join(sorted(json.load(sys.stdin))))'
}

# Each admitted file must ask for its own key and nothing else, whether or not this build
# signs it in — so every PR's `check` proves both are safe to sign. Asked of the PARSED
# plist (PlistBuddy drops comments), never of its bytes: both files' comments name the
# other's capability.
admit() {
  local file="App/$1" want="$2" keys
  [ -f "$file" ] || fail "$file is missing"
  /usr/libexec/PlistBuddy -c 'Print' "$file" >/dev/null 2>&1 || fail "$file is not a readable plist"
  keys="$(plist_keys "$file")" || fail "$file could not be read as JSON"
  [ "$keys" = "$want" ] || fail "$file asks for '$keys' — only $want is admitted"
  printf '    ok  %-44s %s only\n' "$1" "$want"
}
admit "$PUSH_ENTITLEMENTS" aps-environment
admit "$CARPLAY_ENTITLEMENTS" "$CARPLAY_KEY"

# What this build signs in. One file is named as is; two are merged under the work
# directory, because CODE_SIGN_ENTITLEMENTS names exactly one.
if [ "$push_enabled" = 1 ]; then
  signed_entitlements="$work/Zimmer.entitlements"
  cp "App/$CARPLAY_ENTITLEMENTS" "$signed_entitlements"
  /usr/libexec/PlistBuddy -c "Merge App/$PUSH_ENTITLEMENTS" "$signed_entitlements" >/dev/null ||
    fail "could not merge $PUSH_ENTITLEMENTS into $CARPLAY_ENTITLEMENTS"
  signed_keys="$CARPLAY_KEY aps-environment"
else
  signed_entitlements="$CARPLAY_ENTITLEMENTS"
  signed_keys="$CARPLAY_KEY"
fi
build_settings+=(CODE_SIGN_ENTITLEMENTS="$signed_entitlements")

# The entitlements guard is asked of the build settings, before anything is built, so a
# stray CODE_SIGN_ENTITLEMENTS in the project cannot override the one chosen above.
# Captured rather than piped into `grep -q`, which under pipefail can report a match as a
# miss when the writer dies of SIGPIPE.
settings="$(xcodebuild -showBuildSettings -project App/Zimmer.xcodeproj -scheme Zimmer -configuration Release "${build_settings[@]}" 2>/dev/null)"
# `sort -u`, because -showBuildSettings prints a block per target in the scheme and a
# setting passed on the command line is resolved in every one of them. Without it the
# answer is the same path repeated once per target, which matches neither "" nor the one
# permitted file — so the guard failed a correct build (run 34776726410). Deduplicating
# keeps the check it is actually making: *which* files are signed in, not how many blocks
# named them. Two genuinely different values remain two lines, and still fail.
entitlements="$(printf '%s\n' "$settings" \
  | awk '$1 == "CODE_SIGN_ENTITLEMENTS" { $1 = ""; $2 = ""; print }' | tr -d ' ' | sort -u)"
[ "$entitlements" = "$signed_entitlements" ] ||
  fail "CODE_SIGN_ENTITLEMENTS is '$entitlements' — expected $signed_entitlements"
printf '    ok  %-44s %s\n' "CODE_SIGN_ENTITLEMENTS" "$signed_keys"

# Options before build settings.
if [ "$mode" = upload ] && [ "$signing" = archive ]; then
  xcodebuild archive \
    -project App/Zimmer.xcodeproj -scheme Zimmer -configuration Release \
    -destination 'generic/platform=iOS' -archivePath "$archive" \
    "${auth_args[@]}" \
    "${build_settings[@]}" \
    CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES CODE_SIGN_STYLE=Automatic \
    DEVELOPMENT_TEAM="$APPLE_TEAM_ID"
else
  # Ad hoc: no certificate, no team, no profile — only the entitlements, so export has
  # them to sign in. Export replaces this signature with the distribution one.
  xcodebuild archive \
    -project App/Zimmer.xcodeproj -scheme Zimmer -configuration Release \
    -destination 'generic/platform=iOS' -archivePath "$archive" \
    "${build_settings[@]}" \
    CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=NO AD_HOC_CODE_SIGNING_ALLOWED=YES \
    CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER=
fi

# What App Store Connect would otherwise tell us at the end of an upload, asked of the
# archive instead. Every one of these compiles cleanly when wrong.
app="$archive/Products/Applications/Zimmer.app"
plist="$app/Info.plist"
[ -f "$plist" ] || fail "the archive has no Zimmer.app — did the scheme's archive action change?"

# A key that is absent fails, rather than reading as an empty string that happens to match.
value() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$plist" 2>/dev/null || fail "Info.plist has no $1"
}
expect() {
  local actual
  actual="$(value "$1")"
  [ "$actual" = "$2" ] || fail "Info.plist $1 is '$actual', expected '$2'"
  printf '    ok  %-44s %s\n' "$1" "matches"
}
present() {
  [ -n "$(value "$1")" ] || fail "Info.plist has an empty $1"
  printf '    ok  %-44s present\n' "$1"
}

printf '==> inspecting the archived app\n'
expect CFBundleIdentifier "$BUNDLE_ID"
expect CFBundleExecutable Zimmer
expect CFBundlePackageType APPL
expect CFBundleVersion "$build_number"
present CFBundleShortVersionString
expect ITSAppUsesNonExemptEncryption false
expect CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconName AppIcon
expect ZimmerDefaultAPIBaseURL "$base_url"
expect ZimmerDefaultWebBaseURL "$web_url"
[ -f "$app/Assets.car" ] || fail "no compiled asset catalog — the app icon is missing"
[ -f "$app/PrivacyInfo.xcprivacy" ] || fail "no privacy manifest in the app bundle"
if grep -aq '\$(' "$plist"; then fail "Info.plist carries a malformed \$(...) build setting"; fi

# The archived app's signature carries every admitted key — what export will sign in. A
# signature made with a team adds its own keys (application-identifier and the like), so
# this asks that each admitted key is present, not that nothing else is.
printf '==> inspecting the archived app signature\n'
signed_plist="$work/archived.entitlements"
codesign -d --entitlements - --xml "$app" >"$signed_plist" 2>/dev/null ||
  fail "the archived app is not signed — export would sign in no entitlements"
archived_keys=" $(plist_keys "$signed_plist" 2>/dev/null || true) "
for key in $signed_keys; do
  case "$archived_keys" in
    *" $key "*) printf '    ok  %-44s signed in\n' "$key" ;;
    *) fail "the archived app's signature has no $key (it has:$archived_keys)" ;;
  esac
done

version="$(value CFBundleShortVersionString)"

if [ "$mode" = check ]; then
  printf '\n\033[1;32m==> archive %s (%s) is uploadable in shape\033[0m\n' "$version" "$build_number"
  printf '    Distribution signing and the upload are not exercised here; they need the Apple key.\n\n'
  exit 0
fi

export_options="$work/ExportOptions.plist"
cat >"$export_options" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>${APPLE_TEAM_ID}</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
PLIST

printf '==> signing and uploading %s (%s) to App Store Connect\n' "$version" "$build_number"
xcodebuild -exportArchive \
  -archivePath "$archive" \
  -exportPath "$work/export" \
  -exportOptionsPlist "$export_options" \
  "${auth_args[@]}"

# What export actually signed, from the summary it leaves beside the upload. Asked after the
# upload because it is the upload's own record; a missing key fails the run, which is the
# only way a build that cannot reach CarPlay is noticed before someone sits in a car.
summary="$work/export/DistributionSummary.plist"
if [ -f "$summary" ]; then
  printf '==> checking what export signed in\n'
  exported="$(plutil -convert json -o - "$summary")" || fail "$summary could not be read as JSON"
  for key in $signed_keys; do
    printf '%s' "$exported" | python3 -c '
import json, sys
key = sys.argv[1]
def found(node):
    if isinstance(node, dict):
        return key in node or any(found(v) for v in node.values())
    if isinstance(node, list):
        return any(found(v) for v in node)
    return False
sys.exit(0 if found(json.load(sys.stdin)) else 1)' "$key" ||
      fail "export did not sign in $key — the uploaded build lacks it (is it enabled on the App ID?)"
    printf '    ok  %-44s signed in at export\n' "$key"
  done
else
  printf '::warning title=No DistributionSummary.plist::export left no summary, so what it signed in is unchecked; dump the build with codesign\n'
fi

printf '==> waiting for App Store Connect to process %s (%s)\n' "$version" "$build_number"
python3 tools/app_store_connect.py wait --bundle-id "$BUNDLE_ID" --version "$version" --build "$build_number"
