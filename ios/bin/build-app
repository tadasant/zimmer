#!/usr/bin/env bash
#
# Build the iOS app with Xcode, for the simulator.
#
# It needs Xcode, which exists on no machine in this project except a GitHub-hosted macOS
# runner, so the self-hosted Linux CI jobs never call it.
#
# It is a script rather than YAML, so that the check the `ios` job runs is a check
# anyone with a Mac can run by hand, unchanged. See ios/README.md.
#
# NOTHING HERE SIGNS ANYTHING, and that is the property to preserve: a simulator build
# needs no identity, no certificate, no provisioning profile and no App Store Connect key,
# which is what lets this run in CI with no credential and no human. Do not add signing,
# and do not set CODE_SIGN_ENTITLEMENTS — an entitlement Apple has not granted (CarPlay is
# granted by manual review) fails a build TO SIGN rather than merely lacking the feature.
#
# Usage:
#   ios/bin/build-app                                  # Debug, no default server
#   ios/bin/build-app --configuration Staging \
#                     --api-base-url https://example    # the staging variant
#
# NO HOSTNAME IS WRITTEN IN THIS REPOSITORY, and `--api-base-url` is how it stays that way:
# the server a build defaults to is passed in, exactly as `ios/bin/testflight` passes it
# from the `testflight` environment's variable. It defaults to $ZIMMER_IOS_API_BASE_URL so a
# CI job can set one variable and say nothing here.
set -euo pipefail

cd "$(dirname "$0")/.."

configuration=Debug
base_url="${ZIMMER_IOS_API_BASE_URL:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --configuration) configuration="${2:?--configuration needs a value}"; shift 2 ;;
    --api-base-url) base_url="${2:?--api-base-url needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

case "$configuration" in
  Debug|Release|Staging) ;;
  *) printf 'unknown configuration: %s (Debug, Release, Staging)\n' "$configuration" >&2; exit 2 ;;
esac

# https only, the same refusal `ServerURL` makes at runtime and for the same reason:
# a mistyped variable must not be able to point a build at a plaintext host. An empty value
# is fine and means "this build ships no default server", which is what every build in this
# repository does unless told otherwise.
if [ -n "$base_url" ] && [ "${base_url#https://}" = "$base_url" ]; then
  printf '\n\033[1;31m==> FAILED: --api-base-url must be https://\033[0m\n' >&2
  exit 2
fi

if ! command -v xcodebuild >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    printf '\n\033[1;31m==> FAILED: no Xcode in CI\033[0m\n'
    printf '    This script only runs on the macOS job, which has one. Refusing to report\n'
    printf '    green on an app nothing compiled.\n\n'
    exit 1
  fi
  printf '\n\033[1;33m==> SKIPPED: the iOS app (no Xcode)\033[0m\n'
  printf '    Needs a Mac. CI builds it on a GitHub-hosted macOS runner; see ios/README.md.\n\n'
  exit 0
fi

printf '    using %s\n' "$(xcodebuild -version | head -1)"
printf '    configuration %s, default server %s\n' \
  "$configuration" "${base_url:-none}"

# `generic/platform=iOS Simulator` compiles and links without booting a simulator, which is
# all this claims to prove. Running the app is device work — ios/README.md lists what a
# build cannot tell you, and `ios/bin/ui-test` is the one thing that boots a simulator.
xcodebuild build \
  -project App/Zimmer.xcodeproj \
  -scheme Zimmer \
  -configuration "$configuration" \
  -sdk iphonesimulator \
  -destination 'generic/platform=iOS Simulator' \
  ZIMMER_DEFAULT_API_BASE_URL="$base_url" \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO
