#!/usr/bin/env bash
#
# Drive the app on a booted simulator and collect the evidence.
#
# THIS IS THE ONLY THING IN THE PROJECT THAT RUNS THE APP. `ios/bin/ci-swift` tests the
# logic, `ios/bin/build-app` compiles and links without booting anything, and
# `ios/bin/testflight check` archives. None of them can say the screens do what they claim —
# that needs the app running, driven, and photographed.
#
# Its own script rather than YAML, for the reason every other check here is a script: a
# check that exists only in a workflow cannot be run by hand and will rot. The
# `ios-ui-tests.yml` workflow's whole body is a call to this, and the `ios` job in `ci.yml`
# calls exactly the same line.
#
# NOTHING HERE SIGNS ANYTHING and nothing here holds a credential: a simulator build needs
# no identity, and the app under test signs into nothing (an agent cannot complete a Google
# sign-in, so the flow drives the Debug-only `-ZimmerFixture`, an in-memory Zimmer).
#
# Usage:
#   ios/bin/ui-test                                       # Debug, no default server
#   ios/bin/ui-test --configuration Staging \
#                   --api-base-url https://example.test   # the staging variant
#   ios/bin/ui-test --artifacts out/                      # where video and results land
#
# NO HOSTNAME IS WRITTEN IN THIS REPOSITORY. `--api-base-url` defaults to
# $ZIMMER_IOS_API_BASE_URL, so a workflow sets one variable and this file names nothing.
set -euo pipefail

cd "$(dirname "$0")/.."

configuration=Debug
base_url="${ZIMMER_IOS_API_BASE_URL:-}"
artifacts="${ZIMMER_UI_TEST_ARTIFACTS:-$PWD/.ui-test}"

while [ $# -gt 0 ]; do
  case "$1" in
    --configuration) configuration="${2:?--configuration needs a value}"; shift 2 ;;
    --api-base-url) base_url="${2:?--api-base-url needs a value}"; shift 2 ;;
    --artifacts) artifacts="${2:?--artifacts needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

fail() { printf '\n\033[1;31m==> FAILED: %s\033[0m\n\n' "$1" >&2; exit 1; }

# Matches PRODUCT_BUNDLE_IDENTIFIER in App/Zimmer.xcodeproj. Only used to relaunch the app
# for the screenshot below; the test run resolves it from the built product itself.
BUNDLE_ID=com.tadasant.zimmer

case "$configuration" in
  Debug|Staging) ;;
  Release)
    # The fixture the test drives is `#if DEBUG`, so a Release build has no UI for this to
    # touch. Saying so beats twelve minutes and a confusing
    # "element not found".
    fail "Release strips the fixture this drives; use Debug or Staging" ;;
  *) fail "unknown configuration: $configuration (Debug, Staging)" ;;
esac

if [ -n "$base_url" ] && [ "${base_url#https://}" = "$base_url" ]; then
  fail "--api-base-url must be https://"
fi

if ! command -v xcodebuild >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    fail "no Xcode in CI — this only runs on the macOS job. Refusing to report green on an app nothing ran."
  fi
  printf '\n\033[1;33m==> SKIPPED: the iOS UI tests (no Xcode)\033[0m\n'
  printf '    Needs a Mac with a simulator runtime. CI runs it on a GitHub-hosted macOS\n'
  printf '    runner; see ios/README.md.\n\n'
  exit 0
fi

# What the app is expected to report about itself, derived from what it is being built
# with — so the two sides of the assertion cannot drift.
case "$configuration" in
  Staging) expect_env=staging ;;
  Debug) expect_env=development ;;
esac
expect_host=""
if [ -n "$base_url" ]; then
  expect_host="$(printf '%s' "$base_url" | sed -e 's#^https://##' -e 's#[:/].*$##' | tr 'A-Z' 'a-z')"
fi

rm -rf "$artifacts"
mkdir -p "$artifacts"
derived="$artifacts/DerivedData"

printf '    using %s\n' "$(xcodebuild -version | head -1)"
printf '    configuration %s, default server %s\n' "$configuration" "${base_url:-none}"

# ---------------------------------------------------------------------------------------
# A simulator of our own, by UDID.
#
# Never `-destination 'platform=iOS Simulator,name=iPhone 15'`: which devices a hosted
# runner has is a moving target, and a name that is not there fails as "Unable to find a
# device matching the provided destination specifier" several minutes into a build. Asking
# `simctl` which devices exist and taking one is the version that keeps working when the
# image changes under us.
# ---------------------------------------------------------------------------------------
udid="$(xcrun simctl list devices available --json | python3 -c '
import json, sys

runtimes = json.load(sys.stdin)["devices"]
best = None
for runtime, devices in runtimes.items():
    if "iOS" not in runtime:
        continue
    for device in devices:
        if not device.get("isAvailable"):
            continue
        if "iPhone" not in device.get("name", ""):
            continue
        # A lexicographic max over (runtime, name). Deliberately NOT a "newest device"
        # claim — `iOS-17-5` sorts above `iOS-17-10` and `iPhone SE (3rd generation)`
        # above `iPhone 16 Pro Max`. What it guarantees is a *stable, available* pick with
        # no model hard-coded, so a runner image bump changes nothing here.
        key = (runtime, device["name"])
        if best is None or key > best[0]:
            best = (key, device["udid"])
print(best[1] if best else "")
')"
[ -n "$udid" ] || fail "no available iPhone simulator; \`xcrun simctl list devices available\` shows none"
printf '    simulator %s\n' "$udid"

xcrun simctl boot "$udid" 2>/dev/null || true
xcrun simctl bootstatus "$udid" -b

recorder=""
cleanup() {
  # INT rather than TERM: `simctl io recordVideo` finalises the container on SIGINT and
  # leaves an unplayable file on SIGTERM, which is the difference between an artifact and
  # a zero-byte one.
  if [ -n "$recorder" ]; then kill -INT "$recorder" 2>/dev/null || true; wait "$recorder" 2>/dev/null || true; fi
  xcrun simctl shutdown "$udid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------------------
# Build, then check the built bundle before running anything.
# ---------------------------------------------------------------------------------------
printf '==> building for testing\n'
xcodebuild build-for-testing \
  -project App/Zimmer.xcodeproj \
  -scheme ZimmerUITests \
  -configuration "$configuration" \
  -sdk iphonesimulator \
  -destination "id=$udid" \
  -derivedDataPath "$derived" \
  ZIMMER_DEFAULT_API_BASE_URL="$base_url" \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO

# The substitution, proven from the artifact rather than from the command line.
#
# This is the half of "the staging variant resolves the staging API" that needs no test
# runner and no simulator: a build setting that never reached `Info.plist` is a build that
# would point at nothing, and it would look identical on the command line. The UI test
# proves the other half — what the *running* app made of these two keys.
plist="$derived/Build/Products/$configuration-iphonesimulator/Zimmer.app/Info.plist"
[ -f "$plist" ] || fail "no built Info.plist at $plist"
built_env="$(plutil -extract ZimmerBuildEnvironment raw -o - "$plist" 2>/dev/null || echo "")"
built_url="$(plutil -extract ZimmerDefaultAPIBaseURL raw -o - "$plist" 2>/dev/null || echo "")"
printf '    built Info.plist: ZimmerBuildEnvironment=%s ZimmerDefaultAPIBaseURL=%s\n' \
  "${built_env:-<empty>}" "${built_url:-<empty>}"
[ "$built_env" = "$expect_env" ] \
  || fail "built ZimmerBuildEnvironment is '$built_env', expected '$expect_env'"
[ "$built_url" = "$base_url" ] \
  || fail "built ZimmerDefaultAPIBaseURL is '$built_url', expected '${base_url:-<empty>}'"
# Deliberately no host and no URL. This file is uploaded as a workflow artifact, an
# artifact on a public repository is downloadable by anyone, and `::add-mask::` does
# nothing to file contents. What the check needed the host for has already happened above;
# what is recorded is that it matched.
printf '%s\n' "env=$expect_env host_matched=$([ -n "$expect_host" ] && echo yes || echo 'no server')" \
  >"$artifacts/build-target.txt"

# ---------------------------------------------------------------------------------------
# Run, with the camera on.
# ---------------------------------------------------------------------------------------
# Both spellings, because how a test *runner* process is handed an environment variable has
# differed between Xcode versions, and the test treats an absent expectation as an
# abstention rather than a failure — the Info.plist check above is what keeps such a run
# from being evidence-free.
export ZIMMER_UI_TEST_EXPECT_ENV="$expect_env"
export ZIMMER_UI_TEST_EXPECT_HOST="$expect_host"
export TEST_RUNNER_ZIMMER_UI_TEST_EXPECT_ENV="$expect_env"
export TEST_RUNNER_ZIMMER_UI_TEST_EXPECT_HOST="$expect_host"

xcrun simctl io "$udid" recordVideo --codec h264 --force "$artifacts/run.mp4" &
recorder=$!
# Crash reports newer than this are the run's own.
touch "$artifacts/.started"

printf '==> running the UI tests\n'
status=0
xcodebuild test-without-building \
  -project App/Zimmer.xcodeproj \
  -scheme ZimmerUITests \
  -configuration "$configuration" \
  -sdk iphonesimulator \
  -destination "id=$udid" \
  -derivedDataPath "$derived" \
  -resultBundlePath "$artifacts/ZimmerUITests.xcresult" \
  -test-timeouts-enabled YES \
  -maximum-test-execution-time-allowance 300 \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO || status=$?

# A screenshot whatever happened: on a red run it is the first thing worth looking at.
#
# Then the key screens, each from a fresh launch of the fixture. XCUITest terminates the app
# when the run ends, so a `simctl` screenshot taken now catches the springboard; relaunching
# with a fixture argument and photographing after it settles is what a pull request embeds.
# `simctl` can screenshot and cannot tap, which is why every screen worth a picture has a
# launch argument that opens it.
xcrun simctl io "$udid" screenshot "$artifacts/last-screen.png" 2>/dev/null || true

app="$derived/Build/Products/$configuration-iphonesimulator/Zimmer.app"
shoot() {
  local name="$1"; shift
  xcrun simctl launch "$udid" "$BUNDLE_ID" "$@" >/dev/null 2>&1 || true
  /bin/sleep 6
  xcrun simctl io "$udid" screenshot "$artifacts/screen-$name.png" 2>/dev/null || true
  xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true
}
if [ -d "$app" ]; then
  printf '==> photographing the key screens\n'
  xcrun simctl install "$udid" "$app" >/dev/null 2>&1 || true
  # Light mode and a fixed status bar, so pictures from different runs compare.
  xcrun simctl ui "$udid" appearance light >/dev/null 2>&1 || true
  xcrun simctl status_bar "$udid" override --time 9:41 --batteryState charged --batteryLevel 100 >/dev/null 2>&1 || true
  shoot sign-in -ZimmerFixture -ZimmerFixtureSignedOut
  shoot sessions -ZimmerFixture
  shoot sessions-active -ZimmerFixture -ZimmerFixtureFilter active
  shoot sessions-snoozed -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureBoard offBoard
  shoot search -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureSearch postgres
  shoot sessions-ranked -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureView ranked
  shoot board-filters -ZimmerFixture -ZimmerFixtureBoard all -ZimmerFixtureFilterSheet -ZimmerFixtureStatuses needs_input,failed
  shoot board-filtered -ZimmerFixture -ZimmerFixtureBoard all -ZimmerFixtureStatuses needs_input,failed -ZimmerFixtureClass priority
  shoot sessions-your-board -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureView user
  shoot session-detail -ZimmerFixture -ZimmerFixtureOpenSession 1038
  shoot session-detail-hierarchy -ZimmerFixture -ZimmerFixtureOpenSession 1042
  # The richest session (a long title, four PRs, a long goal, notes, a wide hierarchy) and a
  # failed one with its failure details: what the page has to stay legible on.
  shoot session-detail-long -ZimmerFixture -ZimmerFixtureOpenSession 1044
  shoot session-detail-failed -ZimmerFixture -ZimmerFixtureOpenSession 1027
  # The details card, opened: the goal by its catalog name, its check, the MCP servers' chips
  # (one failed), the hierarchy's origin, genesis and a row drawn under a senior, and the human
  # messages here and elsewhere under a Slack capture gap. Then a router judged on the PRs of
  # the session it spawned, and a goal in your own words.
  shoot session-detail-panels -ZimmerFixture -ZimmerFixtureOpenSession 1044 -ZimmerFixtureOpenPanels
  shoot session-detail-delegated -ZimmerFixture -ZimmerFixtureOpenSession 1040 -ZimmerFixtureOpenPanels
  shoot session-detail-free-goal -ZimmerFixture -ZimmerFixtureOpenSession 1035 -ZimmerFixtureOpenPanels
  # Why a session is waiting: the spot gate's hold with "Make this session priority", a turn
  # queued for a worker with Force, and a renewed MCP grant beside a message never delivered.
  shoot session-detail-waiting -ZimmerFixture -ZimmerFixtureOpenSession 1031
  shoot session-detail-queued -ZimmerFixture -ZimmerFixtureOpenSession 1029
  shoot session-detail-reconnect -ZimmerFixture -ZimmerFixtureOpenSession 1035
  shoot composer-attachment -ZimmerFixture -ZimmerFixtureOpenSession 1035 -ZimmerFixtureAttachment
  # A snooze to a time of your own, and when a trashed session is deleted, on its row and page.
  shoot session-detail-custom-snooze -ZimmerFixture -ZimmerFixtureOpenSession 1038 -ZimmerFixtureCustomSnooze
  shoot sessions-trash -ZimmerFixture -ZimmerFixtureFilter archived
  shoot session-detail-trashed -ZimmerFixture -ZimmerFixtureOpenSession 1019
  shoot quick-router -ZimmerFixture -ZimmerFixtureQuickRouter
  shoot quick-router-advanced -ZimmerFixture -ZimmerFixtureQuickRouter -ZimmerFixtureQuickRouterAdvanced
  shoot new-session -ZimmerFixture -ZimmerFixtureNewSession
  shoot trash-undo -ZimmerFixture -ZimmerFixtureTrash 1038
  shoot trash-queued -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureTrash 1042
  shoot inbox -ZimmerFixture -ZimmerFixtureTab inbox
  shoot triggers -ZimmerFixture -ZimmerFixtureTab triggers
  shoot more -ZimmerFixture -ZimmerFixtureTab more
  shoot trigger-detail -ZimmerFixture -ZimmerFixtureTrigger 5
  shoot costs -ZimmerFixture -ZimmerFixtureCosts
  shoot costs-root -ZimmerFixture -ZimmerFixtureCosts zimmer
  # Dark mode: the app draws its own (on the PWA manifest's navy), so every main screen is
  # photographed in it too.
  xcrun simctl ui "$udid" appearance dark >/dev/null 2>&1 || true
  shoot sign-in-dark -ZimmerFixture -ZimmerFixtureSignedOut
  shoot sessions-dark -ZimmerFixture
  shoot sessions-active-dark -ZimmerFixture -ZimmerFixtureFilter active
  shoot sessions-ranked-dark -ZimmerFixture -ZimmerFixtureFilter active -ZimmerFixtureView ranked
  shoot session-detail-dark -ZimmerFixture -ZimmerFixtureOpenSession 1038
  shoot session-detail-long-dark -ZimmerFixture -ZimmerFixtureOpenSession 1044
  shoot session-detail-panels-dark -ZimmerFixture -ZimmerFixtureOpenSession 1044 -ZimmerFixtureOpenPanels
  shoot session-detail-waiting-dark -ZimmerFixture -ZimmerFixtureOpenSession 1031
  shoot composer-attachment-dark -ZimmerFixture -ZimmerFixtureOpenSession 1035 -ZimmerFixtureAttachment
  shoot session-detail-custom-snooze-dark -ZimmerFixture -ZimmerFixtureOpenSession 1038 -ZimmerFixtureCustomSnooze
  shoot new-session-dark -ZimmerFixture -ZimmerFixtureNewSession
  shoot inbox-dark -ZimmerFixture -ZimmerFixtureTab inbox
  shoot triggers-dark -ZimmerFixture -ZimmerFixtureTab triggers
  shoot more-dark -ZimmerFixture -ZimmerFixtureTab more
  shoot trigger-detail-dark -ZimmerFixture -ZimmerFixtureTrigger 5
  shoot costs-dark -ZimmerFixture -ZimmerFixtureCosts
  xcrun simctl ui "$udid" appearance light >/dev/null 2>&1 || true
fi

# The app's crash reports, which the result bundle did not carry in the runs that needed them.
# A simulator app's crash lands in the host's DiagnosticReports. Collected after the screenshot
# pass, so a crash there is caught too and the crash reporter, which writes a moment after the
# crash, has had time to finish. Each is kept in the artifacts, and its exception and
# the crashed thread's frames are printed here, so a test that failed because the app died
# says where it died rather than only which assertion stopped waiting.
mkdir -p "$artifacts/crashes"
find "$HOME/Library/Logs/DiagnosticReports" -maxdepth 2 -name 'Zimmer-*.ips' -newer "$artifacts/.started" \
  -exec cp {} "$artifacts/crashes/" \; 2>/dev/null || true
for report in "$artifacts"/crashes/*.ips; do
  [ -e "$report" ] || continue
  printf '\n\033[1;31m==> the app crashed: %s\033[0m\n' "$(basename "$report")"
  python3 - "$report" <<'PY' 2>&1 || sed -n '1,80p' "$report"
import json, sys
text = open(sys.argv[1]).read()
body = json.loads(text[text.index("\n") + 1:])
print(json.dumps(body.get("exception", {})), body.get("termination", {}).get("indicator", ""))
asi = body.get("asi") or {}
for lines in asi.values():
    for line in lines:
        print("  asi:", line)
images = body.get("usedImages", [])
for thread in body.get("threads", []):
    if not thread.get("triggered"):
        continue
    for frame in thread.get("frames", [])[:30]:
        image = images[frame["imageIndex"]].get("name", "?") if 0 <= frame.get("imageIndex", -1) < len(images) else "?"
        where = (frame.get("symbol") or f"+{frame.get('imageOffset')}") + (f" ({frame.get('sourceFile')}:{frame.get('sourceLine')})" if frame.get("sourceFile") else "")
        print(f"  {image:<28} {where}")
PY
done
rm -f "$artifacts/.started"

# The derived data is a gigabyte of object files nobody wants in an artifact bundle; the
# result bundle, the video and the screenshots are the evidence.
rm -rf "$derived"

if [ "$status" -ne 0 ]; then
  fail "the UI tests did not pass (xcodebuild exit $status) — see $artifacts"
fi
printf '\n\033[1;32m==> the UI tests passed\033[0m\n    artifacts: %s\n\n' "$artifacts"
