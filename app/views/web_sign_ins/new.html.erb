<h1 class="text-lg font-semibold text-gray-900">Sign in</h1>

<% if @configuration.usable? %>
  <p class="mt-2 text-sm text-gray-600">
    Use your Google Workspace account from
    <strong class="font-medium text-gray-900"><%= @configuration.allowed_domains.to_sentence(two_words_connector: " or ", last_word_connector: ", or ") %></strong>.
    <% if @configuration.totp_required? %>
      Then enter a code from your authenticator app.
    <% end %>
  </p>

  <%= button_to google_sign_in_path, method: :post, data: { turbo: false },
        class: "mt-6 flex w-full items-center justify-center gap-3 rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-800 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
    <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
      <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
      <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
    </svg>
    Sign in with Google
  <% end %>
<% else %>
  <p class="mt-2 text-sm text-gray-600">
    This Zimmer requires sign-in, but sign-in is not set up correctly, so nobody can get in yet.
  </p>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-gray-800">
    <% @configuration.problems.each do |problem| %>
      <li><code class="text-xs"><%= problem %></code></li>
    <% end %>
  </ul>
  <p class="mt-3 text-sm text-gray-600">
    Whoever runs this deployment fixes it in its secret store. No restart is needed: the change is
    picked up within a minute.
  </p>
<% end %>
