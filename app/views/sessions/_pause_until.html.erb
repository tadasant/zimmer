<%# "Pause Until" — sleep this session now and schedule a one-time trigger to
    wake it at a chosen time. The web-UI counterpart of the wake_me_up_later MCP
    tool; both go through Sessions::ScheduleWakeUp.

    Locals:
      agent_session — the session to pause
      variant       — :button    (session detail header: a pill with a popover)
                      :menu_item (session card overflow menu: a full-width row
                                  whose panel expands inline, so the card never
                                  has to nest one popover inside another)

    Only wakeable sessions get the control. A failed or archived session would
    take the trigger and never sleep, leaving a wake pointed at a session that
    cannot be woken — SessionsController#pause_until re-checks server-side, since
    a stale card is exactly the case where the button outlives the state. %>
<% variant ||= :button %>
<% if Sessions::ScheduleWakeUp::WAKEABLE_STATUSES.include?(agent_session.status.to_s) %>
  <div class="<%= variant == :menu_item ? "block" : "relative inline-flex" %>"
       data-controller="pause-until"
       data-pause-until-url-value="<%= pause_until_session_path(agent_session) %>"
       data-pause-until-inline-value="<%= variant == :menu_item %>">
    <% if variant == :menu_item %>
      <button type="button"
              data-action="pause-until#toggle"
              data-pause-until-target="button"
              aria-expanded="false"
              class="w-full flex items-center gap-2 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 focus:outline-none focus:bg-gray-50 text-left">
        <svg class="h-4 w-4 text-gray-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Pause Until…
      </button>
    <% else %>
      <button type="button"
              data-action="pause-until#toggle"
              data-pause-until-target="button"
              aria-expanded="false"
              title="Sleep this session and wake it at a chosen time"
              class="inline-flex items-center px-4 py-2 border border-indigo-300 text-sm font-medium rounded-md shadow-sm text-indigo-700 bg-indigo-50 hover:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="ml-2">Pause Until</span>
      </button>
    <% end %>

    <%# The panel. Inline (in normal flow) inside the card's overflow menu, which
        already has its own positioned box; an absolutely-positioned popover on the
        detail header. max-w keeps it on screen at a 375px phone viewport. %>
    <div data-pause-until-target="panel"
         class="hidden <%= variant == :menu_item ? "border-t border-gray-100 px-3 py-3" : "absolute right-0 top-12 z-40 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-gray-200 bg-white shadow-lg p-3" %> text-left">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-900">Pause until</span>
        <span data-pause-until-target="zone" class="text-[10px] text-gray-400 font-mono truncate max-w-[9rem]"></span>
      </div>

      <div class="space-y-1">
        <% Session::PAUSE_UNTIL_PRESETS.each do |preset| %>
          <button type="button"
                  data-action="pause-until#choosePreset"
                  data-preset="<%= preset[:key] %>"
                  class="w-full flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 focus:outline-none focus:bg-indigo-50">
            <span class="whitespace-nowrap"><%= preset[:label] %></span>
            <span data-pause-until-target="presetTime" data-preset="<%= preset[:key] %>" class="text-[11px] text-gray-400 shrink-0 whitespace-nowrap"></span>
          </button>
        <% end %>
      </div>

      <div class="mt-3 pt-3 border-t border-gray-100">
        <label class="block text-xs font-medium text-gray-700 mb-1" for="pause_until_at_<%= agent_session.id %>_<%= variant %>">Or pick a time</label>
        <div class="flex items-center gap-2">
          <input type="datetime-local"
                 id="pause_until_at_<%= agent_session.id %>_<%= variant %>"
                 data-pause-until-target="customInput"
                 class="min-w-0 flex-1 rounded-md border-gray-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" />
          <button type="button"
                  data-action="pause-until#chooseCustom"
                  class="shrink-0 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-indigo-500">
            Schedule
          </button>
        </div>
      </div>

      <div class="mt-3">
        <label class="block text-xs font-medium text-gray-700 mb-1" for="pause_until_prompt_<%= agent_session.id %>_<%= variant %>">Resume with</label>
        <textarea id="pause_until_prompt_<%= agent_session.id %>_<%= variant %>"
                  data-pause-until-target="promptInput"
                  rows="2"
                  placeholder="Optional — defaults to a nudge to pick the work back up"
                  class="w-full rounded-md border-gray-300 text-xs focus:border-indigo-500 focus:ring-indigo-500"></textarea>
      </div>

      <p data-pause-until-target="status" class="mt-2 text-xs text-gray-500 empty:hidden" role="status" aria-live="polite"></p>
    </div>
  </div>
<% end %>
