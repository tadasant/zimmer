<%# A turn the starvation lane admitted past the spot gate. Rendered while the
    session carries the admission — from the moment the lane admits it until its
    next turn meets the gate — so a session running while /inference says "spot
    sessions held" explains itself rather than looking like a gate that leaked.
    The sentence is SpotSessionHold::StarvationAdmission's, the same one
    `get_session` prints. See "A hold has an age ceiling" in SpotSessionHold. %>
<% admission = SpotSessionHold.starvation_admission_for(agent_session) %>
<% if admission %>
  <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 p-4" data-spot-starvation-admission>
    <div class="flex items-start gap-3">
      <svg class="h-5 w-5 text-amber-500 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v4a1 1 0 00.293.707l2 2a1 1 0 001.414-1.414L11 10.586V7z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <h3 class="text-sm font-medium text-amber-900">Admitted by the starvation lane</h3>
        <p class="mt-1 text-sm text-amber-800"><%= admission.sentence(running: agent_session.running?) %></p>
      </div>
    </div>
  </div>
<% end %>
