<%# The Reprioritize button, at the top of the User view.

    It hands the board to the deployment's ONE durable reprioritizing session —
    reused across presses the way a trigger reuses a session, not spawned fresh
    each time (Sessions::DashboardReprioritizer). That is why this partial is
    replaceable over a turbo stream: after a press it names the session that took
    the job and links it, so the in-flight state is legible without a reload and
    the operator can watch it work.

    Locals:
      reprioritizer_session - the session that just took the job, or nil before
                              any press this page load %>
<div id="user_view_reprioritize" class="flex flex-wrap items-center gap-2">
  <%= button_to reprioritize_sessions_path,
        method: :post,
        form: { data: { turbo: true }, class: "shrink-0" },
        class: "inline-flex items-center rounded-md border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-700 hover:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-indigo-500",
        title: "Ask Zimmer's reprioritizing session to re-rank this board. It reads these rows over MCP and writes the order back; you can still drag anything afterwards." do %>
    <svg class="-ml-0.5 mr-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h4a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
    </svg>
    Reprioritize
  <% end %>

  <% if reprioritizer_session %>
    <span class="min-w-0 text-xs text-gray-500">
      Working in
      <%= link_to "session ##{reprioritizer_session.id}", session_path(reprioritizer_session),
            class: "font-medium text-indigo-600 hover:text-indigo-800",
            data: { turbo_prefetch: false } %>
      — reload when it reports back to see the new order.
    </span>
  <% end %>
</div>
