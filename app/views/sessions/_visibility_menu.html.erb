<%# "Snooze until…" / "Hide" — the board-visibility control.

    This is presentation and nothing else. It does not pause, start, stop, sleep
    or wake a session, and it never touches status, precedence or the spot queue;
    a snoozed session runs exactly when it would have run anyway, it just is not
    on screen. Nothing in the web UI sleeps a session — that is `wake_me_up_later`
    and `pause_into_spot_queue` over MCP — so the copy below says what snoozing
    does NOT do rather than pointing at a control a human could reach.

    Locals:
      agent_session — the session
      variant       — :button     (session detail header: a pill with a popover
                                   holding every choice, Hide included)
                      :menu_item  (card / ranked-row overflow menu: flat rows,
                                   with the snooze panel expanding inline so the
                                   menu never nests a popover inside a popover)
                      :sheet_item (the mobile bottom sheet on the detail page)

    Offered for EVERY session in every state: there is no session whose card an
    operator may not tidy off their board, archived and failed ones included. %>
<% variant ||= :button %>
<% inline_variant = variant != :button %>
<% tucked_away = !agent_session.board_visible? %>
<div class="<%= inline_variant ? "block" : "inline-flex" %>"
     data-controller="visibility"
     data-visibility-url-value="<%= update_visibility_session_path(agent_session) %>"
     data-visibility-inline-value="<%= inline_variant %>">

  <%# ---- Trigger ---- %>
  <% if variant == :sheet_item %>
    <button type="button"
            data-action="visibility#toggle"
            data-visibility-target="button"
            aria-expanded="false"
            class="flex items-center w-full px-4 py-3 text-left text-sm text-gray-800 hover:bg-gray-50 active:bg-gray-100">
      <span class="w-9 h-9 rounded-full bg-slate-100 text-slate-600 inline-flex items-center justify-center mr-3">
        <%= render "sessions/visibility_icon", classes: "h-5 w-5" %>
      </span>
      <span class="flex-1 font-medium">Snooze until…</span>
    </button>
  <% elsif variant == :menu_item %>
    <button type="button"
            data-action="visibility#toggle"
            data-visibility-target="button"
            aria-expanded="false"
            role="menuitem"
            class="w-full flex items-center gap-2 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 focus:outline-none focus:bg-gray-50 text-left">
      <%= render "sessions/visibility_icon", classes: "h-4 w-4 text-gray-400 shrink-0" %>
      Snooze until…
    </button>
  <% else %>
    <button type="button"
            data-action="visibility#toggle"
            data-visibility-target="button"
            aria-expanded="false"
            title="Snooze or hide this card. Visual only — it does not pause, start or stop the session."
            class="inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md shadow-sm text-slate-700 bg-slate-50 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500">
      <%= render "sessions/visibility_icon", classes: "h-4 w-4" %>
      <span class="ml-2"><%= tucked_away ? "Snoozed / hidden" : "Snooze" %></span>
    </button>
  <% end %>

  <%# ---- Panel ---- %>
  <div data-visibility-target="panel"
       class="hidden <%= inline_variant ? "border-t border-gray-100 #{variant == :sheet_item ? "px-4 py-3" : "px-3 py-3"}" : "absolute right-0 top-full mt-2 z-40 w-72 max-w-[calc(100vw-2rem)] max-h-[calc(100vh-8rem)] overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-lg p-3" %> text-left">
    <div class="flex items-center justify-between mb-1">
      <span class="text-sm font-semibold text-gray-900">Snooze until</span>
      <span data-visibility-target="zone" class="text-[10px] text-gray-400 font-mono truncate max-w-[9rem]"></span>
    </div>

    <%# Said before the click rather than after it, and said next to the choices
        rather than in a tooltip: "snooze until 9am" reads like it holds the work
        back, and it does not. %>
    <p class="mb-2 rounded-md bg-slate-50 px-2 py-1.5 text-[11px] leading-snug text-slate-600">
      Takes this card off your board until then. <span class="font-medium">It does not pause the session</span> —
      nothing about when Zimmer runs it changes.
    </p>

    <% if tucked_away %>
      <button type="button"
              data-action="visibility#restore"
              class="mb-2 w-full rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-100 focus:outline-none focus:ring-2 focus:ring-emerald-500">
        Put back on the board
      </button>
      <p class="mb-2 px-0.5 text-[11px] text-gray-500"><%= agent_session.visibility_summary %></p>
    <% end %>

    <div class="space-y-1">
      <% SessionVisibility::SNOOZE_PRESETS.each do |preset| %>
        <button type="button"
                data-action="visibility#choosePreset"
                data-preset="<%= preset[:key] %>"
                class="w-full flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:bg-slate-100">
          <span class="whitespace-nowrap"><%= preset[:label] %></span>
          <span data-visibility-target="presetTime" data-preset="<%= preset[:key] %>" class="text-[11px] text-gray-400 shrink-0 whitespace-nowrap"></span>
        </button>
      <% end %>
    </div>

    <div class="mt-3 pt-3 border-t border-gray-100">
      <label class="block text-xs font-medium text-gray-700 mb-1" for="snooze_until_at_<%= agent_session.id %>_<%= variant %>">Custom — pick a date and time</label>
      <div class="flex items-center gap-2">
        <input type="datetime-local"
               id="snooze_until_at_<%= agent_session.id %>_<%= variant %>"
               data-visibility-target="customInput"
               class="min-w-0 flex-1 rounded-md border-gray-300 text-sm focus:border-slate-500 focus:ring-slate-500" />
        <button type="button"
                data-action="visibility#chooseCustom"
                class="shrink-0 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-slate-700 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-slate-500">
          Snooze
        </button>
      </div>
    </div>

    <%# The popover variant has no menu around it to carry a separate Hide row,
        so it carries its own. %>
    <% if variant == :button %>
      <div class="mt-3 pt-3 border-t border-gray-100">
        <button type="button"
                data-action="visibility#hide"
                class="w-full flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:bg-slate-100">
          <span class="whitespace-nowrap font-medium">Hide</span>
          <span class="text-[11px] text-gray-400 shrink-0 whitespace-nowrap">no end time</span>
        </button>
      </div>
    <% end %>

  </div>

  <%# ---- Flat rows the menu variants carry alongside the panel ---- %>
  <% if variant == :menu_item %>
    <button type="button"
            data-action="visibility#hide"
            role="menuitem"
            class="w-full flex items-center gap-2 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 focus:outline-none focus:bg-gray-50 text-left">
      <svg class="h-4 w-4 text-gray-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243" />
      </svg>
      Hide
    </button>
    <% if tucked_away %>
      <button type="button"
              data-action="visibility#restore"
              role="menuitem"
              class="w-full flex items-center gap-2 px-3 py-2.5 text-sm text-emerald-700 hover:bg-emerald-50 focus:outline-none focus:bg-emerald-50 text-left">
        <svg class="h-4 w-4 text-emerald-500 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Put back on the board
      </button>
    <% end %>
  <% elsif variant == :sheet_item %>
    <button type="button"
            data-action="visibility#hide"
            class="flex items-center w-full px-4 py-3 text-left text-sm text-gray-800 hover:bg-gray-50 active:bg-gray-100">
      <span class="w-9 h-9 rounded-full bg-slate-100 text-slate-600 inline-flex items-center justify-center mr-3">
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243" />
        </svg>
      </span>
      <span class="flex-1 font-medium">Hide</span>
    </button>
    <% if tucked_away %>
      <button type="button"
              data-action="visibility#restore"
              class="flex items-center w-full px-4 py-3 text-left text-sm text-emerald-700 hover:bg-emerald-50 active:bg-emerald-100">
        <span class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 inline-flex items-center justify-center mr-3">
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </span>
        <span class="flex-1 font-medium">Put back on the board</span>
      </button>
    <% end %>
  <% end %>

  <%# Outside the panel on purpose. "Hide" and "Put back on the board" are flat
      rows that never open the panel, so a status line living inside it would
      report their failures into a hidden element — the operator would see a
      button that silently does nothing. %>
  <p data-visibility-target="status"
     class="<%= inline_variant ? "px-3 pb-2" : "absolute right-0 top-full mt-1 w-72 max-w-[calc(100vw-2rem)] rounded-md bg-white px-2 py-1 shadow" %> text-xs text-gray-500 empty:hidden"
     role="status" aria-live="polite"></p>
</div>
