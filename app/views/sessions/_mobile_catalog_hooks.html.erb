<%# Mobile-optimized catalog hooks display and editor %>
<% plugin_derived_hooks = agent_session.plugin_derived_hooks %>
<% hooks_for_select = defined?(@catalog_hooks_for_select) ? @catalog_hooks_for_select : nil %>
<% selected = agent_session.catalog_hooks || [] %>
<% if !hooks_for_select.nil? || selected.present? || plugin_derived_hooks.any? %>
  <div <%= tag.attributes(data: catalog_multiselect_attributes(
             items: catalog_multiselect_items(hooks_for_select, key: :name),
             selected: selected,
             accent: "amber",
             variant: :stacked,
             persist_url: update_catalog_hooks_session_path(agent_session),
             payload_key: "catalog_hooks")) %>>

    <%= render "sessions/catalog_multiselect_display",
               variant: :stacked, label: "Hooks", accent: "amber",
               selected: selected, derived: plugin_derived_hooks,
               editable: !hooks_for_select.nil?,
               edit_label: selected.present? ? "Edit hooks" : "Add hooks" %>

    <% unless hooks_for_select.nil? %>
      <%= render "sessions/catalog_multiselect_editor",
                 variant: :stacked, label: "Hooks", accent: "amber",
                 placeholder: "Search hooks...", aria_label: "Search hooks",
                 note: "Applies on the next turn or restart — the running process keeps its current hooks." %>
    <% end %>
  </div>
<% end %>
