<%#
  The read-only half of the catalog multi-select widget, for the three catalogs
  whose display is just a list of chips: skills, hooks and plugins. MCP servers
  render their own, because each chip carries a live connection indicator.

  Renders INSIDE an element carrying `data-controller="catalog-multiselect"`.

  The chips the CONTROLLER owns sit in `data-role="catalog-selected"`, which it
  rewrites after a save. Chips the SERVER owns — one a plugin brings in — are
  siblings of it, so a save no longer wipes them off the page until the next
  reload.

  Locals:
    variant            - "inline" (desktop meta row) or "stacked" (mobile card)
    label              - "Skills", "Hooks", …
    accent             - accent token
    selected           - the persisted keys
    editable           - whether to render the Edit/Add affordance
    edit_label         - accessible name for it
    derived            - { key => plugin_id } read-only chips, or {}
    inherited_defaults - agent-root defaults to show when nothing is selected, or []
%>
<% classes = catalog_multiselect_accent(accent) %>
<% inline = variant.to_s == "inline" %>
<% chip_class = classes.fetch(inline ? :display_chip_inline : :display_chip_stacked) %>
<% derived = local_assigns.fetch(:derived, {}) %>
<% inherited_defaults = local_assigns.fetch(:inherited_defaults, []) %>
<% any_chips = selected.present? || derived.any? %>

<div data-catalog-multiselect-target="display" class="<%= inline ? "flex items-center gap-1" : "" %>">
  <% unless inline %>
    <div class="flex items-center justify-between mb-2">
      <label class="text-xs font-medium text-gray-500"><%= label %></label>
      <% if editable %>
        <button type="button"
                data-action="click->catalog-multiselect#edit"
                class="<%= classes[:edit_link] %> text-xs font-medium px-2 py-1.5 -mr-2 -my-1"
                title="<%= edit_label %>"
                aria-label="<%= edit_label %>">
          <%= selected.present? ? "Edit" : "Add" %>
        </button>
      <% end %>
    </div>
  <% end %>

  <% if inline %><strong class="text-gray-700"><%= label %>:</strong><% end %>

  <span data-role="catalog-tags"
        class="<%= any_chips ? "flex" : "hidden" %> <%= inline ? "text-gray-600 items-center gap-1 flex-wrap" : "flex-wrap gap-1.5" %>">
    <%# `contents` so each chip is a flex item of the container above, not of this wrapper. %>
    <span data-role="catalog-selected" class="contents">
      <% Array(selected).each do |key| %>
        <span data-chip class="inline-flex items-center <%= chip_class %>"><%= key %></span>
      <% end %>
    </span>
    <% derived.each do |key, plugin_id| %>
      <span data-chip
            class="inline-flex items-center <%= inline ? "px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500 italic border border-purple-200" : "gap-1 px-2 py-1 rounded-md text-xs font-medium border bg-gray-50 text-gray-500 border-purple-200 italic" %>"
            title="<%= key %>: from plugin '<%= plugin_id %>' (read-only)"
            aria-label="<%= key %>: from plugin '<%= plugin_id %>' (read-only)"><%= key %></span>
    <% end %>
  </span>

  <%# The agent-root defaults are shown only when nothing else is: they are what
      the session WOULD inherit, so rendering them beside a populated selection
      would be a lie — even hidden, where a body-text search still finds them. %>
  <% show_inherited = !any_chips && inherited_defaults.any? %>
  <span data-role="catalog-empty" class="<%= "hidden " if any_chips %><%= show_inherited ? "text-xs" : "text-gray-400 italic text-xs" %>">
    <% if show_inherited %>
      <%= render "sessions/inherited_defaults", items: inherited_defaults, label: "agent root default" %>
    <% else %>
      None
    <% end %>
  </span>

  <% if inline && editable %>
    <button type="button"
            data-action="click->catalog-multiselect#edit"
            class="text-gray-400 hover:text-gray-600 focus:outline-none ml-1"
            title="<%= edit_label %>"
            aria-label="<%= edit_label %>">
      <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
      </svg>
    </button>
  <% end %>
</div>
