<%# One group on Your board v2: a category, or Uncategorized when `category` is nil.

    The row list is always in the DOM, even collapsed or empty: it is a Sortable
    drop target, and it is where an undone Trash puts a row back.

    Locals:
      category - the BoardCategory, or nil for Uncategorized
      sessions - its rows, most recently touched first %>
<% collapsed = category&.collapsed %>
<% body_id = "board_v2_group_body_#{category&.id || "uncategorized"}" %>
<div class="<%= category ? "" : "mb-4" %> rounded-md border border-gray-200 bg-white"
     <% if category %>data-board-v2-target="category" data-category-id="<%= category.id %>"<% end %>>
  <%# `relative` here, not on each control, so the Rename and Snooze popovers
      open against the header's right edge and stay on screen at 375px wherever
      the wrapped control happens to sit. %>
  <div class="relative flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-gray-100 bg-gray-50 px-2 py-2 rounded-t-md">
    <% if category %>
      <span class="shrink-0 cursor-grab px-1 py-1 text-gray-300 hover:text-gray-500"
            data-board-v2-category-handle aria-hidden="true" title="Drag to reorder categories">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M3 5h14v2H3zm0 4h14v2H3zm0 4h14v2H3z"/></svg>
      </span>
      <button type="button"
              class="shrink-0 rounded p-1 text-gray-500 hover:bg-gray-200 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
              data-action="board-v2#toggle"
              aria-expanded="<%= !collapsed %>"
              aria-controls="<%= body_id %>"
              title="Collapse or expand">
        <svg class="h-4 w-4 transition-transform <%= "-rotate-90" if collapsed %>" data-board-v2-chevron viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
      </button>
    <% end %>
    <h3 data-board-v2-group-name class="min-w-[8rem] flex-1 truncate text-sm font-semibold <%= category ? "text-gray-800" : "text-gray-500" %>">
      <%= category ? category.name : "Uncategorized" %>
    </h3>
    <span class="shrink-0 inline-flex items-center justify-center rounded-full bg-white px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-200"
          data-board-v2-count><%= sessions.size %></span>
    <% if category %>
      <details class="shrink-0">
        <summary class="cursor-pointer list-none rounded-md border border-gray-300 bg-white px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50">Rename</summary>
        <%= form_with url: board_category_path(category), method: :patch,
              class: "absolute right-0 z-30 mt-1 flex w-64 max-w-[calc(100vw-2rem)] items-center gap-2 rounded-md border border-gray-200 bg-white p-2 shadow-lg" do |form| %>
          <%= form.label :name, "Category name", class: "sr-only", for: "board_category_name_#{category.id}" %>
          <%= form.text_field :name, value: category.name, required: true, maxlength: BoardCategory::NAME_MAX_LENGTH,
                id: "board_category_name_#{category.id}",
                class: "min-w-0 flex-1 rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          <%= form.submit "Save", class: "shrink-0 rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-indigo-700" %>
        <% end %>
      </details>
      <span class="shrink-0">
        <%= render "sessions/board_category_visibility_menu", category: category %>
      </span>
      <%= button_to board_category_path(category),
            method: :delete,
            form: { class: "shrink-0", data: { turbo_confirm: "Delete \"#{category.name}\"? Its sessions move to Uncategorized; nothing else changes." } },
            class: "rounded-md border border-red-200 bg-white px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50",
            title: "Delete this category. Its sessions move to Uncategorized." do %>
        Delete
      <% end %>
    <% end %>
  </div>

  <div id="<%= body_id %>" class="relative <%= "hidden" if collapsed %>" data-board-v2-body>
    <ul id="<%= board_v2_list_dom_id(category&.id) %>"
        class="<%= board_v2_list_classes %>"
        data-board-v2-target="list"
        data-category-id="<%= category&.id %>"><% sessions.each do |session| %><%= render "sessions/board_v2_row", agent_session: session %><% end %></ul>
    <p class="pointer-events-none absolute inset-x-0 top-0 px-4 py-4 text-xs text-gray-400 <%= "hidden" if sessions.any? %>" data-board-v2-empty>
      <%= category ? "Drag sessions here." : "Nothing uncategorized." %>
    </p>
  </div>
</div>
