<%# A spot session waiting for quota headroom. Without this the session sits in
    `waiting` looking indistinguishable from one that is merely queued, and the
    only record of why would be a line in its log. %>
<% hold_detail = agent_session.metadata&.dig(SpotSessionHold::HELD_DETAIL) %>
<% if hold_detail.present? && agent_session.waiting? %>
  <% retry_at = agent_session.metadata&.dig(SpotSessionHold::HELD_RETRY_AT) %>
  <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 p-4" id="spot-hold-banner">
    <div class="flex items-start gap-3">
      <svg class="h-5 w-5 text-amber-500 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v4a1 1 0 00.293.707l2 2a1 1 0 001.414-1.414L11 10.586V7z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <h3 class="text-sm font-medium text-amber-900">Held for quota headroom</h3>
        <p class="mt-1 text-sm text-amber-800"><%= hold_detail %></p>
        <p class="mt-2 text-xs text-amber-700">
          This is a <span class="font-medium">spot</span> session
          (genesis <span class="font-mono"><%= agent_session.genesis_key %></span>). It has not been cancelled —
          it will start on its own when headroom returns<%= ", next check #{retry_at}" if retry_at.present? %>.
          To start it now, promote its genesis in
          <%= link_to "Settings", settings_path(anchor: "spot-gate"), class: "underline hover:text-amber-900" %>.
        </p>
      </div>
    </div>
  </div>
<% end %>
