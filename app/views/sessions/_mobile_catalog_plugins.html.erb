<%# Mobile-optimized catalog plugins display and editor %>
<% plugins_for_select = defined?(@plugins_for_select) ? @plugins_for_select : nil %>
<% selected = agent_session.catalog_plugins || [] %>
<% if !plugins_for_select.nil? || selected.present? %>
  <div <%= tag.attributes(data: catalog_multiselect_attributes(
             items: catalog_multiselect_items(plugins_for_select, key: :id),
             selected: selected,
             accent: "purple",
             variant: :stacked,
             show_description: true,
             persist_url: update_catalog_plugins_session_path(agent_session),
             payload_key: "catalog_plugins")) %>>

    <%= render "sessions/catalog_multiselect_display",
               variant: :stacked, label: "Plugins", accent: "purple",
               selected: selected,
               editable: !plugins_for_select.nil?,
               edit_label: selected.present? ? "Edit plugins" : "Add plugins" %>

    <% unless plugins_for_select.nil? %>
      <%= render "sessions/catalog_multiselect_editor",
                 variant: :stacked, label: "Plugins", accent: "purple",
                 placeholder: "Search plugins...", aria_label: "Search plugins",
                 note: "Applies on the next turn or restart — the running process keeps its current plugins." %>
    <% end %>
  </div>
<% end %>
