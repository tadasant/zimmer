<%# One session on Your board: the Last Touched card, in the row that carries its
    drag handle. The card is `sessions/session_card_frame` itself, not a copy, so
    the two views show a session the same way and stay that way.

    Locals:
      agent_session - the session %>
<%= render "sessions/board_v2_row_shell",
      row_id: board_v2_row_dom_id(agent_session),
      session_id: agent_session.id,
      last_touched: agent_session.last_user_activity_at.to_f do %><%= render "sessions/session_card_frame", agent_session: agent_session %><% end %>
