<%# The dashboard's board — the half of "/" that costs something. Served by
    SessionsController#board into the shell's <turbo-frame id="sessions_board">,
    without the layout.

    The off-board count rides in here as a stream rather than being computed by
    the shell, because it is counted through every filter the board applies,
    including a content search — the one filter that can take seconds. The
    stream updates the Filters legend the moment the frame lands. %>
<%= turbo_frame_tag "sessions_board", target: "_top" do %>
  <%= turbo_stream.update "off-board-count",
        [ (@off_board_count.to_i.positive? ? "#{pluralize(@off_board_count, "session")} tucked away" : nil),
          (@backlogged_count.to_i.positive? ? "#{@backlogged_count} backlogged" : nil) ].compact.join(" · ") %>
  <% if @view_mode == SessionsController::VIEW_MODE_USER %>
    <%# The User view: one list of everything the filters match, worked top to
        bottom. Search narrows it exactly as the status and visibility filters
        do — there is no separate "search results" presentation to bounce the
        operator into. %>
    <%= render "sessions/content_scan_notice", scan: @content_scan %>
    <%= render "sessions/user_view_sessions",
          sessions: @user_view_sessions,
          limit: @user_view_limit,
          truncated: @user_view_truncated,
          visibility_filter: @visibility_filter %>
  <% elsif @view_mode == SessionsController::VIEW_MODE_BOARD_V2 %>
    <%# Your board v2: the same filtered rows, grouped into the operator's own
        categories. See Sessions::BoardV2. %>
    <%= render "sessions/content_scan_notice", scan: @content_scan %>
    <%= render "sessions/board_v2", board: @board_v2, limit: @user_view_limit %>
  <% elsif @view_mode == SessionsController::VIEW_MODE_RANKED %>
    <%# The Ranked view: priority above, the spot queue below it in precedence
        order, both editable in place. Honors the same filters as every other
        view — with its own default, since a queue of work that has not started
        is mostly `waiting`. %>
    <%# The filters travel into the partial because the rows update live and a
        broadcast has to be judged against the filters THIS page is showing.
        `live_insert` is off whenever a search, an agent root or a genesis is
        narrowing the list — the three the client cannot evaluate for a
        session it has never rendered. %>
    <%= render "sessions/ranked_sessions",
          priority_sessions: @ranked_priority_sessions,
          spot_sessions: @ranked_spot_sessions,
          section_limit: @ranked_section_limit,
          status_filter: @status_filter,
          priority_class_filter: @priority_class_filter,
          visibility_filter: @visibility_filter,
          live_insert: !@search_active %>
  <% else %>
    <%# Flat sort views: a single list of cards sorted solely by the chosen
        factor (last touched, or created desc). Honors the same filters/search
        as every other view.

        The cards update live, and every open page has its own filters, so the
        filters travel into `session-grid`, which judges each card delivery
        (`_card_delivery`) against them: a session that stops matching leaves,
        one that starts matching arrives in sort order. `live_insert` is off
        under a text search — the one filter the client cannot evaluate for a
        session it has never rendered. %>
    <div data-controller="session-grid"
         data-session-grid-status-filter-value="<%= @status_filter.to_json %>"
         data-session-grid-priority-class-filter-value="<%= @priority_class_filter %>"
         data-session-grid-visibility-filter-value="<%= @visibility_filter %>"
         data-session-grid-carplay-fit-filter-value="<%= @carplay_fit_filter %>"
         data-session-grid-genesis-filter-value="<%= @genesis_filter %>"
         data-session-grid-agent-root-filter-value="<%= dashboard_agent_root_filter_name(@agent_root_filter) %>"
         data-session-grid-live-insert-value="<%= dashboard_card_live_insert?(@search_query, @agent_root_filter) %>"
         data-session-grid-sort-key-value="<%= @view_mode == SessionsController::VIEW_MODE_LAST_TOUCHED ? "lastTouchedAt" : "createdAt" %>"
         data-session-grid-page-value="<%= @flat_sessions.current_page %>"
         data-session-grid-per-page-value="<%= @flat_sessions.limit_value %>">
      <div id="<%= Session::CARD_DELIVERIES_TARGET %>" hidden></div>
      <% if @any_sessions %>
        <%= render "sessions/content_scan_notice", scan: @content_scan %>
      <% end %>
      <%= render "sessions/flat_sessions", sessions: @flat_sessions, title: @flat_view_title %>
      <%# The scan notice is already above the grid when there were cards, so the
          empty state only carries it when it is the one showing at load. %>
      <%= render "sessions/board_empty_state", search_active: @search_active,
            content_scan: (@any_sessions ? nil : @content_scan), visible: !@any_sessions %>
    </div>
  <% end %>

  <%# The Ranked view's page-level empty state. Not rendered in the User view,
      which carries its own placeholder INSIDE the list section — the list has to
      stay in the DOM there so it remains a drop target and somewhere an undone
      Trash can put a row back. The card views render theirs inside the grid
      controller above. %>
  <% if !@any_sessions && @view_mode == SessionsController::VIEW_MODE_RANKED %>
    <%= render "sessions/board_empty_state", search_active: @search_active, content_scan: @content_scan %>
  <% end %>
<% end %>
