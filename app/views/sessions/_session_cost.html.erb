<%# The detail page's spend line: dollars, tokens, and what the dollars mean.
    Its own partial with its own target, so a fresh ledger sweep can repaint just
    this line (Session#broadcast_cost) without re-rendering the whole meta row.
    Renders an empty wrapper when nothing is stored yet, so the target exists for
    the first broadcast to land on. Muted on purpose: a spend figure belongs on
    this page, but it is not what the page is about. %>
<% summary = SessionCostSummary.for(agent_session) %>
<div id="session_<%= agent_session.id %>_cost" class="<%= summary.any? ? 'flex' : 'hidden' %> items-center gap-1 text-gray-400"
     title="<%= session_cost_title(summary) %>">
  <% if summary.any? %>
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-1 1v.092a3 3 0 000 5.816V15a1 1 0 102 0v-.092a3 3 0 000-5.816V8a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <% if summary.unpriced? %>
      <span>unpriced</span>
    <% else %>
      <span class="tabular-nums"><%= number_to_currency(summary.cost, precision: summary.cost < 1 ? 3 : 2) %></span>
    <% end %>
    <span class="tabular-nums" data-session-cost-tokens>· <%= SessionCostSummary.compact_tokens(summary.total_tokens) %> tokens</span>
    <%= link_to "cost", token_spend_path, data: { turbo_frame: "_top" }, class: "text-gray-400 hover:text-gray-600 underline decoration-dotted" %>
  <% end %>
</div>
