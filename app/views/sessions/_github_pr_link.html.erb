<%# Display GitHub PR link button(s) if the session has PR URLs %>
<%# Status glyph + color: git-pull-request/gray (unknown), git-pull-request/green (open),
    git-merge/purple (merged), git-pull-request-closed/red (closed) %>
<%# CI status indicator: Shows colored circle for open PRs (green=pass, yellow=pending, red=fail) %>
<%# For multiple PRs: the session header shows the most recent as a primary button
    with a dropdown beside it; the dashboard card, which has no room for the pair,
    shows one trigger over the same dropdown %>
<%# size: :small (default) matches dashboard card / row buttons; :large matches session header buttons %>
<% pr_urls = agent_session.custom_metadata&.dig("github_pull_request_urls") || [] %>
<% pr_statuses = agent_session.custom_metadata&.dig("github_pull_request_statuses") || {} %>
<% ci_statuses = agent_session.custom_metadata&.dig("github_pull_request_ci_statuses") || {} %>
<% size = local_assigns[:size] || :small %>
<% if pr_urls.present? %>
  <%
    # Most recent PR is the last one in the array (primary)
    primary_url = pr_urls.last
    primary_status = pr_statuses[primary_url]
    primary_ci_status = ci_statuses[primary_url]
    primary_icon_color = pr_icon_color_class(primary_status)
    primary_status_text = primary_status.present? ? primary_status.titleize : "Unknown"

    if size == :large
      button_size_classes = "px-4 py-2 text-sm shadow-sm"
      toggle_size_classes = "px-2 py-2 text-sm shadow-sm"
      icon_classes = "mr-1.5"
      # The header is a sticky bar near the top of the screen, so its menu drops
      # down; there is nothing above it to open into.
      menu_placement_classes = "top-full mt-1"
    else
      button_size_classes = "px-3 py-1.5 text-xs"
      icon_classes = "-ml-0.5 mr-1.5"
      # The card's trigger sits in the footer, on the card's bottom edge, so its
      # menu opens upward for the same reason the ⋮ menu beside it does: downward
      # would put it below the card, and below the fold for a card low on the page.
      menu_placement_classes = "bottom-full mb-1"
    end
  %>

  <% if pr_urls.size == 1 %>
    <%# Single PR - simple button with CI status indicator for open PRs %>
    <%= link_to primary_url, target: "_blank", rel: "noopener noreferrer",
        class: "inline-flex items-center #{button_size_classes} border border-gray-300 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
        title: "View PR on GitHub (#{primary_status_text})",
        data: { controller: "session-activity", action: "click->session-activity#touch", session_activity_url_value: touch_activity_session_path(agent_session) } do %>
      <svg class="<%= icon_classes %> h-4 w-4 <%= primary_icon_color %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="<%= pr_icon_path(primary_status) %>"/>
      </svg>
      <%# The label names the PR, not its state: state is the icon's glyph and color, with
          the sr-only span and the title carrying it for anyone reading neither. %>
      PR<span class="sr-only"> (<%= primary_status_text %>)</span>
      <% if primary_status == "open" && primary_ci_status.present? %>
        <span class="ml-1.5 inline-flex items-center" title="CI: <%= primary_ci_status.titleize %>">
          <span class="h-2 w-2 rounded-full <%= ci_status_bg_class(primary_ci_status) %>"></span>
        </span>
      <% end %>
    <% end %>
  <% else %>
    <%# Multiple PRs - a dropdown over all of them. The trigger differs by size:
        the session header has room for a button group, the dashboard card's
        footer does not. %>
    <div class="relative inline-flex" data-controller="dropdown">
      <% if size == :large %>
        <%# Primary button - most recent PR with CI status indicator %>
        <%= link_to primary_url, target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex items-center #{button_size_classes} border border-gray-300 font-medium rounded-l-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
            title: "View most recent PR on GitHub (#{primary_status_text})",
            data: { controller: "session-activity", action: "click->session-activity#touch", session_activity_url_value: touch_activity_session_path(agent_session) } do %>
          <svg class="<%= icon_classes %> h-4 w-4 <%= primary_icon_color %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="<%= pr_icon_path(primary_status) %>"/>
          </svg>
          <%= extract_pr_number(primary_url) %><span class="sr-only"> (<%= primary_status_text %>)</span>
          <% if primary_status == "open" && primary_ci_status.present? %>
            <span class="ml-1.5 inline-flex items-center" title="CI: <%= primary_ci_status.titleize %>">
              <span class="h-2 w-2 rounded-full <%= ci_status_bg_class(primary_ci_status) %>"></span>
            </span>
          <% end %>
        <% end %>

        <%# Dropdown toggle button %>
        <button type="button"
                class="inline-flex items-center <%= toggle_size_classes %> border border-l-0 border-gray-300 font-medium rounded-r-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                data-dropdown-target="button"
                data-action="click->dropdown#toggle"
                aria-haspopup="true"
                aria-expanded="false"
                title="View all PRs (<%= pr_urls.size %>)">
          <svg class="h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      <% else %>
        <%# One control, not a group. A dashboard card is 320-400px wide, so its
            footer seats this next to the ⋮ / Trash / View group in as little as
            288px, and that group takes 180px of it. A link-plus-chevron pair costs
            126px and does not fit; this trigger costs 87.6px, about what the
            single-PR button costs -- so a session with several PRs asks the footer
            for no more room than a session with one (#607).
            The face carries the count rather than the newest PR's number: it triggers
            a menu over all of them, and the menu names each one. The glyph, its
            color and the CI dot still describe the newest, with the title and the
            sr-only span spelling that out for anyone reading neither.
            No session-activity#touch on it, unlike the buttons that open a PR:
            touching activity resets PollBackoff, and that write broadcasts a
            replacement for this card -- which would tear the menu down on the same
            click that opened it. The menu's own links still touch. %>
        <button type="button"
                class="inline-flex items-center <%= button_size_classes %> border border-gray-300 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                data-dropdown-target="button"
                data-action="click->dropdown#toggle"
                aria-haspopup="true"
                aria-expanded="false"
                title="View all PRs (<%= pr_urls.size %>) — most recent <%= extract_pr_number(primary_url) %> (<%= primary_status_text %>)">
          <svg class="<%= icon_classes %> h-4 w-4 <%= primary_icon_color %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="<%= pr_icon_path(primary_status) %>"/>
          </svg>
          <%= pr_urls.size %><span class="sr-only"> PRs, most recent <%= extract_pr_number(primary_url) %> (<%= primary_status_text %>)</span>
          <% if primary_status == "open" && primary_ci_status.present? %>
            <span class="ml-1.5 inline-flex items-center" title="CI: <%= primary_ci_status.titleize %>">
              <span class="h-2 w-2 rounded-full <%= ci_status_bg_class(primary_ci_status) %>"></span>
            </span>
          <% end %>
          <svg class="ml-1 -mr-1 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      <% end %>

      <%# Dropdown menu - the trigger's position decides which way it opens; see
          menu_placement_classes above %>
      <div class="hidden absolute left-0 <%= menu_placement_classes %> w-64 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50"
           data-dropdown-target="menu">
        <div class="py-1" role="menu">
          <div class="px-3 py-1.5 text-xs font-medium text-gray-500 border-b border-gray-100">
            All PRs (<%= pr_urls.size %>)
          </div>
          <% pr_urls.reverse.each_with_index do |url, index| %>
            <%
              status = pr_statuses[url]
              ci_status = ci_statuses[url]
              icon_color = pr_icon_color_class(status)
              status_text = status.present? ? status.titleize : "Unknown"
              pr_number = extract_pr_number(url)
              is_primary = index == 0
            %>
            <%= link_to url, target: "_blank", rel: "noopener noreferrer",
                class: "flex items-center px-3 py-2 text-xs text-gray-700 hover:bg-gray-100",
                role: "menuitem",
                data: { controller: "session-activity", action: "click->session-activity#touch", session_activity_url_value: touch_activity_session_path(agent_session) } do %>
              <svg class="mr-2 h-4 w-4 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="<%= pr_icon_path(status) %>"/>
              </svg>
              <span class="flex-1"><%= pr_number %></span>
              <span class="text-gray-500"><%= status_text %></span>
              <% if status == "open" && ci_status.present? %>
                <span class="ml-1.5 inline-flex items-center" title="CI: <%= ci_status.titleize %>">
                  <span class="h-2 w-2 rounded-full <%= ci_status_bg_class(ci_status) %>"></span>
                </span>
              <% end %>
              <% if is_primary %>
                <span class="ml-2 text-xs text-indigo-600">(latest)</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
