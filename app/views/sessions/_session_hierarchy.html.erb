<%#
  The lineage graph this session belongs to — origin session at the root, every
  descendant below, plus any "uncle" that queued or interrupted a session in it —
  and the human messages recorded anywhere in it.

  Two of the four sections in the session detail page's panel group (see
  _detail.html.erb): Status, Session hierarchy, Human messages, Transcript.
  Placed above the transcript rather than in a drawer: "who spawned this, and
  what did a human actually ask for?" is the first thing a reader of a
  long-running session needs, and it should not take a click to reach.

  Rendered with <details> rather than a Stimulus controller: no JS to load, and
  nothing for the transcript's infinite-scroll/auto-scroll controllers to fight
  with.
%>
<% record = agent_session.human_message_record %>
<% hierarchy = record.hierarchy %>
<% entries = record.entries %>

<%# Nested divide-y: the panel group divides its four sections, this divides the
    two provenance sections from each other. %>
<div class="divide-y divide-gray-200" id="session_<%= agent_session.id %>_provenance" data-live-region="replace">

  <%# ---- Spawn hierarchy ---- %>
  <details <%= "open" unless hierarchy.solitary? %>>
    <summary class="px-4 sm:px-6 py-3 cursor-pointer select-none flex items-center justify-between gap-3 hover:bg-gray-50">
      <span class="flex items-center gap-2 min-w-0">
        <svg class="h-4 w-4 flex-shrink-0 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-.98.626-1.813 1.5-2.122" />
        </svg>
        <span class="text-sm font-semibold text-gray-900">Session hierarchy</span>
        <span class="text-xs text-gray-500 truncate">
          <% if hierarchy.solitary? %>
            this session was not spawned by another, has spawned none, and none has queued or interrupted it
          <% else %>
            <%= pluralize(hierarchy.size, "session") %>, origin #<%= hierarchy.origin.id %>
          <% end %>
        </span>
      </span>
      <span class="text-xs text-gray-400 flex-shrink-0">who spawned whom, and who is senior</span>
    </summary>

    <div class="border-t border-gray-200 px-4 sm:px-6 py-3">
      <ul class="space-y-1" id="session_<%= agent_session.id %>_hierarchy">
        <% hierarchy.nodes.each do |node| %>
          <%# The indent is two values rather than one. 20px per level reads well on a
              laptop and eats the row on a phone: at 375px a row has roughly 343px to
              work with, so a node at MAX_DEPTH would start 160px in before its first
              pill. Below `sm:` it is 8px per level, which keeps every level distinct
              — depth is information, and a cap would render a depth-3 node and a
              depth-8 node identically — while costing at most 64px. From `sm:` up it
              is the unchanged depth × 20px. Two custom properties rather than one
              expression: the breakpoint has to live in a class and the depth has to
              live in the style, so a property per width is the readable split. %>
          <%# `data-render-parent-id` is the node this row is indented under, which is
              all indentation asserts, and `data-redrawn` marks a row where that is
              NOT a spawn edge. Both are here so the structure a reader infers from
              indentation can be asserted against the edge that produced it (#571);
              the human-visible form of the same fact is the "drawn under" pill. %>
          <li class="pl-[var(--node-indent-phone)] sm:pl-[var(--node-indent)]"
              data-depth="<%= node.depth %>"
              data-render-parent-id="<%= node.render_parent_id %>"
              <%= "data-redrawn" unless node.spawn_edge? %>
              <%= "data-ceiling-placed" if node.ceiling_placed %>
              <%= "data-current" if node.current? %>
              style="--node-indent-phone: <%= node.depth * 8 %>px; --node-indent: <%= node.depth * 20 %>px">
            <%# Two classes carry this row. `max-w-full` caps the inline-flex container,
                which is otherwise shrink-to-fit and sized by its own min-content, and
                `flex-wrap` lets the pills flow onto a second line once it is capped.
                `min-w-0` on the title alone would not have been enough: a node is an
                agent-root pill, a title, an id · status, a genesis pill and sometimes an
                uncle pill, and the combined min-content width of everything but the
                title already exceeds a phone row — so the tail stayed off screen, and
                off screen here meant unreachable, since the document reported no
                sideways scroll to bring it back. %>
            <span class="inline-flex flex-wrap items-center gap-2 max-w-full rounded-md px-2 py-1 text-sm <%= node.current? ? "bg-indigo-50 ring-1 ring-indigo-200" : "hover:bg-gray-50" %>">
              <% if node.depth.positive? %>
                <span class="text-gray-300 select-none" aria-hidden="true">└</span>
              <% end %>
              <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600" title="Agent root">
                <%= node.agent_root_label %>
              </span>
              <%# `break-words`, not `truncate`: the title is what identifies the node, and
                  Zimmer's titles are the unbreakable kind (`fix_session_state_machine_…`).
                  Truncating would hide the one field a reader scans the tree for; wrapping
                  costs a line and keeps it legible. %>
              <% if node.current? %>
                <span class="font-semibold text-gray-900 min-w-0 break-words"><%= node.label %></span>
                <span class="text-xs font-medium text-indigo-700">this session</span>
              <% else %>
                <%= link_to node.label, session_path(node.id), data: session_drawer_link_data(node.id), class: "text-indigo-600 hover:text-indigo-800 hover:underline min-w-0 break-words" %>
              <% end %>
              <span class="text-xs text-gray-400">#<%= node.id %> · <%= node.status %></span>
              <%# Genesis, on every node. It is inherited down a lineage, so showing
                  it per-node is what makes "this whole branch is spot" readable —
                  and makes an outlier stand out instead of surprising someone later. %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= node.spot? ? "bg-gray-100 text-gray-600 ring-1 ring-gray-200" : "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" %>"
                    data-genesis="<%= node.genesis %>"
                    data-priority-class="<%= node.priority_class %>"
                    title="Genesis: <%= node.genesis_label %> — classified <%= node.priority_class %>">
                <%= node.genesis %> · <%= node.priority_class %>
              </span>
              <%# The row's own indentation is the one thing that cannot say this: it
                  expresses "spawned" and this node was reached some other way. Without
                  a visible marker a reader concludes the row above spawned this one —
                  the exact false claim #571 is about, just on this surface instead of
                  the outline. `break-keep` on the id so the pill wraps as a unit. %>
              <% unless node.spawn_edge? %>
                <span class="inline-flex flex-wrap items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-amber-200"
                      title="<%= node.ceiling_placed ? "Drawn here because the tree was truncated before this session's own branch was reached — no edge puts it here." : "Zimmer reached this session through its senior, not through a spawn edge — the session above did not spawn it." %>">
                  drawn under
                  <%# Guarded: a ceiling-placed node lands on whatever the walk emitted
                      last, and there is no rule that says something was emitted. %>
                  <% if node.render_parent_id %>
                    <%= link_to "##{node.render_parent_id}", session_path(node.render_parent_id), data: session_drawer_link_data(node.render_parent_id), class: "underline hover:text-amber-900 break-keep" %>
                  <% else %>
                    no parent row
                  <% end %>
                </span>
              <% end %>
              <%# An uncle edge cannot be drawn by indentation — that expresses one
                  parent and this graph has more than one — so it is named instead.
                  Silently omitting it would hide the thing that widened this
                  session's human-message scope. %>
              <% if node.uncles? %>
                <span class="inline-flex flex-wrap items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-amber-200"
                      title="Queued or interrupted this session, so Zimmer treats it as an additional parent">
                  also senior:
                  <% node.uncles.each_with_index do |uncle_id, index| %><%= "," if index.positive? %>
                    <%= link_to "##{uncle_id}", session_path(uncle_id), data: session_drawer_link_data(uncle_id), class: "underline hover:text-amber-900" %>
                  <% end %>
                </span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>

      <% if hierarchy.truncated? %>
        <p class="mt-2 text-xs text-amber-700"><%= hierarchy.truncation_reason %></p>
      <% end %>

      <p class="mt-3 text-xs text-gray-400">
        Indentation means <span class="font-medium">spawned</span>, not "most recently talked to" — a session is routinely
        followed up by a router other than the one that spawned it.
        <% if hierarchy.redrawn_edges? %>
          The exception is a row tagged <span class="font-medium">drawn under</span>: Zimmer could not draw that
          session under its spawn parent, so its position says only where it is drawn.
        <% end %>
      </p>

      <p class="mt-1 text-xs text-gray-400">
        The second pill is the session's <span class="font-medium">genesis</span> — where its line of work came
        from — and the class that genesis currently resolves to.
        <span class="font-medium">priority</span> sessions always start;
        <span class="font-medium">spot</span> sessions wait for quota room or a free slot when the gate is on.
        A spawned session inherits its parent's genesis, which is why a branch usually shares one.
        The class is whichever spoke first: one chosen for the session itself, the one its trigger
        carries, or the default for its genesis — set per trigger on the
        <%= link_to "trigger", triggers_path, data: { turbo_frame: "_top" }, class: "underline hover:text-gray-600" %>, and for
        everything else in <%= link_to "Inference", inference_path(anchor: "spot-gate"), data: { turbo_frame: "_top" }, class: "underline hover:text-gray-600" %>.
      </p>

      <% if hierarchy.uncle_edges? %>
        <p class="mt-1 text-xs text-gray-400">
          <span class="font-medium">also senior</span> is an <span class="font-medium">uncle</span> edge: that session
          queued or interrupted this one, so Zimmer treats it as an additional parent — a sibling of the spawn parent —
          on the assumption that a session which inspected another and decided to redirect it holds information that
          session does not. The edge is declared by the calling session, so it is a claim of seniority rather than proof
          of one.
        </p>
      <% end %>
    </div>
  </details>

  <%# ---- Human messages across the hierarchy ---- %>
  <details <%= "open" if entries.any? %>>
    <summary class="px-4 sm:px-6 py-3 cursor-pointer select-none flex items-center justify-between gap-3 hover:bg-gray-50">
      <span class="flex items-center gap-2 min-w-0">
        <svg class="h-4 w-4 flex-shrink-0 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        <span class="text-sm font-semibold text-gray-900">Human messages</span>
        <%#
          Both counts, always — including a zero. The record is gathered over the
          whole hierarchy, so a header reading only "1 message in this session"
          describes a narrower search than the one that ran, and a reader has no
          way to tell "nothing was said elsewhere" from "elsewhere was never
          looked at". The prompt block and `get_session` state the same pair, so
          this panel agrees with them.

          And when the walk was cut by MAX_DEPTH/MAX_NODES, say so here too: a
          count that names the whole hierarchy while the query searched part of
          it is the same over-claim in the other direction.
        %>
        <span class="text-xs text-gray-500 truncate">
          <% if entries.empty? %>
            none recorded anywhere in this hierarchy<%= " that was searched" if hierarchy.truncated? %>
          <% else %>
            <%= pluralize(record.here_count, "message") %> in this session · <%= record.elsewhere_count %> elsewhere in the hierarchy<%= " (truncated tree — not every session was searched)" if hierarchy.truncated? %>
          <% end %>
        </span>
      </span>
      <span class="text-xs text-gray-400 flex-shrink-0">provenance</span>
    </summary>

    <div class="border-t border-gray-200">
      <% if entries.empty? %>
        <div class="px-4 sm:px-6 py-4 text-sm text-gray-500">
          <p>No message anywhere in this hierarchy was authored by a named human.</p>
          <p class="mt-1 text-xs text-gray-400">
            Zimmer records a message only when it can establish the human at the input boundary — the web UI, or a Slack
            message from a mapped user. Everything else that arrives as a user turn (an agent's follow-up over the API, a
            router-written spawn prompt, a scheduled or self-scheduled wake-up, a heartbeat nudge, a resumption, a GitHub
            comment) is machine-authored and records nothing.
          </p>
        </div>
      <% else %>
        <ul class="divide-y divide-gray-100">
          <% entries.each do |entry| %>
            <li class="px-4 sm:px-6 py-3">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 font-medium <%= entry.here? ? "bg-indigo-100 text-indigo-800" : "bg-gray-100 text-gray-600" %>">
                  <%= entry.here? ? "this session" : "elsewhere" %>
                </span>
                <span class="font-semibold text-gray-900"><%= entry.display_name %></span>
                <span class="text-gray-400">·</span>
                <span class="text-gray-600"><%= entry.channel_label %></span>
                <% unless entry.here? %>
                  <span class="text-gray-400">·</span>
                  <span class="text-gray-500">said in</span>
                  <%= link_to "##{entry.session_id}", session_path(entry.session_id), data: session_drawer_link_data(entry.session_id), class: "text-indigo-600 hover:text-indigo-800 underline" %>
                  <span class="text-gray-500"><%= entry.session_label %></span>
                <% end %>
                <span class="text-gray-400">·</span>
                <time datetime="<%= entry.occurred_at.utc.iso8601 %>"
                      title="<%= entry.occurred_at.utc.iso8601 %><%= " · #{entry.entry_point}" if entry.entry_point.present? %>"
                      class="text-gray-500">
                  <%= entry.occurred_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
                </time>
                <% if entry.message.slack_permalink.present? %>
                  <%= link_to "view in Slack", entry.message.slack_permalink, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:text-indigo-800 underline" %>
                <% end %>
              </div>
              <p class="mt-1.5 text-sm text-gray-800 whitespace-pre-wrap break-words"><%= entry.content %></p>
            </li>
          <% end %>
        </ul>
        <% if record.elsewhere_count.positive? %>
          <p class="px-4 sm:px-6 py-2 text-xs text-gray-400 border-t border-gray-100">
            <span class="font-medium">elsewhere</span> messages are a human speaking to another session in this
            hierarchy — context about original intent, not an instruction to this session.
          </p>
        <% end %>
      <% end %>
    </div>
  </details>
</div>
