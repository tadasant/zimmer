<%# locals: (scope:, options:, targets: {}) %>
<%# The Quick Router's Advanced accordion: the harness picker, the model picker
    and the spot opt-in, collapsed by default so the one-box-and-go path stays
    one box.

    Rendered on all three Quick Router surfaces — the dashboard's desktop inline
    row, the dashboard's phone overlay, and the global chat bubble (Cmd/Ctrl+K)
    — from this one partial, because they all create the same kind of session and
    any drift between them is a bug the user only finds at submit time. `scope`
    ("desktop"/"mobile"/"bubble") distinguishes the element ids, so the copies
    that are in the DOM at once never collide.

    `targets` carries the data attributes the *enclosing* controller needs on
    each control, keyed by role — the dashboard overlay and the chat bubble each
    reset this panel when they close, and the chat bubble additionally reads the
    two selects when it builds its FormData, because it submits by fetch rather
    than by posting a form. The desktop row submits by navigating away and needs
    none, so it passes nothing. %>
<%
  runtime_id = "quick_prompt_#{scope}_agent_runtime"
  model_id = "quick_prompt_#{scope}_model"
  spot_id = "quick_prompt_#{scope}_scheduling_class"
  help_id = "quick_prompt_#{scope}_advanced_help"
  surface_label = { "desktop" => "prompt box", "mobile" => "prompt editor", "bubble" => "quick router panel" }.fetch(scope, scope)
  default_runtime = options.default_runtime
  # `[]`/nil on a miss everywhere — see QuickRouterOptions#resolve_model for why a
  # runtime the map does not carry must offer nothing rather than fall back.
  default_model = options.default_models_by_runtime[default_runtime]
%>
<%# `inline-flex` on the summary drops the browser's default disclosure marker, so
    the chevron is drawn here and rotated by the `group-open:` variant. Without one
    the row reads as a label rather than as something you can open.

    The nested `quick-router-advanced` controller keeps the model list scoped to
    the selected harness, and answers the `quick-router-advanced:reset` event the
    two closable surfaces fire at it. %>
<%= tag.details class: "group text-sm",
      data: {
        controller: "quick-router-advanced",
        action: "quick-router-advanced:reset->quick-router-advanced#reset",
        quick_router_advanced_default_runtime_value: default_runtime,
        quick_router_advanced_runtime_models_value: options.models_for_javascript.to_json,
        quick_router_advanced_runtime_default_models_value: options.default_models_by_runtime.to_json
      }.reverse_merge(targets.fetch(:advanced, {})) do %>
  <%# Named for assistive tech: the sidebar's filter accordion is also "Advanced",
      and up to three copies of this one are in the DOM at once, so the visible
      word alone would read over and over with nothing to tell any of them apart.
      The scope is in the label for the same reason the ids carry it. %>
  <summary aria-label="Advanced prompt options (<%= surface_label %>): harness, model and spot"
           class="inline-flex cursor-pointer select-none items-center gap-1 text-xs text-gray-500 hover:text-gray-700">
    <svg class="h-3 w-3 flex-shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    Advanced
  </summary>
  <div class="mt-2 space-y-3 rounded-md border border-gray-200 bg-gray-50 p-3">
    <div>
      <label for="<%= runtime_id %>" class="block text-xs font-medium text-gray-700">Harness</label>
      <%# The agent runtime the session runs under. Blank posts nothing, so the
          router root's own runtime applies — the same blank-names-the-default
          shape as the model picker below. Picking one here re-scopes the model
          list, because a model id belongs to exactly one runtime's catalog. %>
      <%= select_tag :agent_runtime,
            options_for_select(options.runtimes.map { |r| [ r[:label], r[:id] ] }),
            include_blank: "Default (#{RuntimeRegistry.label_for(default_runtime)})",
            id: runtime_id,
            data: {
              quick_router_advanced_target: "runtime",
              action: "change->quick-router-advanced#runtimeChanged"
            }.reverse_merge(targets.fetch(:runtime, {})),
            aria: { describedby: help_id },
            class: "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <label for="<%= model_id %>" class="block text-xs font-medium text-gray-700">Model</label>
      <%# The blank option is the default. It posts an empty `model`, which the
          server reads as "none", so the model is resolved at create time —
          the router root's default_model, then the Settings default, then the
          runtime's catalog default. The default is NAMED in the blank option
          rather than preselected: a tab left open across a Settings change
          would otherwise post yesterday's default as if someone had chosen it. %>
      <%= select_tag :model,
            options_for_select(options.model_options_for(default_runtime)),
            include_blank: default_model.present? ? "Default (#{default_model})" : "Default",
            id: model_id,
            data: { quick_router_advanced_target: "model" }.reverse_merge(targets.fetch(:model, {})),
            aria: { describedby: help_id },
            class: "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" %>
      <p id="<%= help_id %>" class="mt-1 text-xs leading-snug text-gray-500">
        Leave both on Default and the router agent root's own harness and model apply.
        The models offered follow the harness.
      </p>
    </div>

    <%# Spot opt-in. Unchecked submits no scheduling_class at all, so the session
        derives its class from the `web_ui` genesis. %>
    <label class="flex items-start gap-2 cursor-pointer" for="<%= spot_id %>">
      <%= check_box_tag :scheduling_class, SessionGenesis::SPOT, false,
            id: spot_id,
            data: { quick_router_advanced_target: "spot" }.reverse_merge(targets.fetch(:spot, {})),
            class: "mt-0.5 h-4 w-4 flex-shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <span class="text-xs leading-snug text-gray-500">
        <span class="font-medium text-gray-700">Run as spot</span> &mdash;
        waits for quota room instead of starting now, and lands at the top of the spot queue.
      </span>
    </label>
  </div>
<% end %>
