<%# Mobile-optimized catalog skills display and editor %>
<% plugin_derived_skills = agent_session.plugin_derived_skills %>
<% skills_for_select = defined?(@catalog_skills_for_select) ? @catalog_skills_for_select : nil %>
<% selected = agent_session.catalog_skills || [] %>
<% if !skills_for_select.nil? || selected.present? || plugin_derived_skills.any? %>
  <div <%= tag.attributes(data: catalog_multiselect_attributes(
             items: catalog_multiselect_items(skills_for_select, key: :name),
             selected: selected,
             accent: "green",
             variant: :stacked,
             group_by_category: true,
             persist_url: update_catalog_skills_session_path(agent_session),
             payload_key: "catalog_skills")) %>>

    <%= render "sessions/catalog_multiselect_display",
               variant: :stacked, label: "Skills", accent: "green",
               selected: selected, derived: plugin_derived_skills,
               editable: !skills_for_select.nil?,
               edit_label: selected.present? ? "Edit skills" : "Add skills" %>

    <% unless skills_for_select.nil? %>
      <%= render "sessions/catalog_multiselect_editor",
                 variant: :stacked, label: "Skills", accent: "green",
                 placeholder: "Search skills...", aria_label: "Search skills",
                 note: "Applies on the next turn or restart — the running process keeps its current skills." %>
    <% end %>
  </div>
<% end %>
