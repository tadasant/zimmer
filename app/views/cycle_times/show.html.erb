<% a = @analysis %>
<% content_for :title, "Cycle Time — #{a.title}" %>
<% total = a.wall_seconds.to_f %>
<% sessions_by_id = a.lanes.index_by { |lane| lane["session_id"] } %>
<div class="min-h-screen bg-gray-50" data-controller="cycle-time-chart"
     data-action="mouseover->cycle-time-chart#show mousemove->cycle-time-chart#move mouseout->cycle-time-chart#hide">
  <div class="max-w-[100rem] mx-auto px-3 sm:px-6 py-6">
    <div class="flex items-center min-w-0 mb-2">
      <%= link_to cycle_times_path(@window_params), class: "text-gray-500 hover:text-gray-700 mr-3 shrink-0", aria: { label: "Back to Cycle Time" } do %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 truncate"><%= a.title %></h1>
    </div>
    <p class="text-sm text-gray-600 mb-4">
      <%= link_to "Session ##{a.root_session_id}", session_path(a.root_session_id), class: "text-indigo-700 hover:underline" %>
      and <%= pluralize(a.session_count - 1, "descendant") %> ·
      started by <%= a.initiator_detail.presence || a.initiator %> ·
      <%= cycle_clock(a.started_at) %> → <%= cycle_clock(a.finished_at) %> ·
      <span class="font-semibold text-gray-900"><%= cycle_duration(total) %></span>
    </p>

    <% unless a.eligible %>
      <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        Not counted as autonomous: <%= a.ineligible_reason_label %> (<%= a.ineligible_detail %>). No breakdown is computed for it.
      </div>
    <% end %>

    <% if a.eligible %>
      <section class="bg-white border border-gray-200 rounded-lg p-4 sm:p-5 mb-6" aria-labelledby="hierarchy-totals">
        <h2 id="hierarchy-totals" class="text-sm font-semibold text-gray-900 mb-3">Where the time went</h2>
        <%= render "stacked_bar", totals: a.category_seconds, total: total, height: "h-6" %>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <caption class="sr-only">Time by category</caption>
            <thead class="text-[11px] uppercase tracking-wide text-gray-500">
              <tr>
                <th class="text-left font-medium py-1">Category</th>
                <th class="text-right font-medium py-1" title="Each instant charged once, to what the task as a whole was doing. Sums to the wall-clock.">Hierarchy time</th>
                <th class="text-right font-medium py-1">Share</th>
                <th class="text-right font-medium py-1 hidden sm:table-cell" title="Every session's own time added up. Overlapping sessions count twice.">Session time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% keys = (a.category_seconds.keys | a.session_category_seconds.keys) %>
              <% CycleTimes::Categories::KEYS.select { |k| keys.include?(k) }.sort_by { |k| -a.category_seconds[k].to_f }.each do |key| %>
                <tr>
                  <td class="py-1.5">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block w-3 h-3 rounded-sm shrink-0" style="<%= cycle_category_style(key) %>"></span>
                      <span class="text-gray-800" title="<%= CycleTimes::Categories.fetch(key).description %>"><%= CycleTimes::Categories.label(key) %></span>
                    </span>
                  </td>
                  <td class="py-1.5 text-right font-mono text-gray-700"><%= cycle_duration(a.category_seconds[key].to_f) %></td>
                  <td class="py-1.5 text-right font-mono text-gray-500"><%= cycle_share(a.category_seconds[key].to_f, total) %></td>
                  <td class="py-1.5 text-right font-mono text-gray-500 hidden sm:table-cell"><%= cycle_duration(a.session_category_seconds[key].to_f) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="bg-white border border-gray-200 rounded-lg p-4 sm:p-5 mb-6" aria-labelledby="gantt-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <h2 id="gantt-heading" class="text-sm font-semibold text-gray-900">Timeline</h2>
          <p class="text-xs text-gray-500">Hover a segment for what was going on. The top lane is the rolled-up hierarchy.</p>
        </div>
        <div class="overflow-x-auto">
          <div class="min-w-[44rem]">
            <%# Axis %>
            <div class="flex text-[11px] text-gray-500">
              <div class="w-48 sm:w-64 shrink-0"></div>
              <div class="relative flex-1 h-5 border-b border-gray-200">
                <% cycle_axis_ticks(total).each do |tick| %>
                  <span class="absolute top-0 -translate-x-1/2 font-mono whitespace-nowrap" style="left: <%= (tick / total * 100).round(3) %>%"><%= tick.zero? ? "0" : "+#{cycle_duration(tick)}" %></span>
                <% end %>
              </div>
            </div>

            <% lanes = [ { "title" => "Whole task", "depth" => 0, "rollup" => true, "start" => 0, "end" => total, "segments" => a.hierarchy_segments } ] + a.lanes %>
            <% lanes.each do |lane| %>
              <div class="flex items-center py-1 <%= lane['rollup'] ? 'border-b border-gray-200 mb-1 pb-2' : '' %>">
                <div class="w-48 sm:w-64 shrink-0 pr-3 min-w-0" style="padding-left: <%= [ lane['depth'].to_i, 6 ].min * 12 %>px">
                  <% if lane["rollup"] %>
                    <span class="text-xs font-semibold text-gray-900">Whole task</span>
                  <% else %>
                    <%= link_to session_path(lane["session_id"]), class: "block text-xs text-gray-800 hover:text-indigo-700 truncate", title: lane["title"] do %>
                      <span class="font-mono text-gray-400">#<%= lane["session_id"] %></span> <%= lane["title"] %>
                    <% end %>
                  <% end %>
                </div>
                <div class="relative flex-1 h-5 bg-gray-50 rounded-sm">
                  <% cycle_axis_ticks(total).drop(1).each do |tick| %>
                    <span class="absolute inset-y-0 w-px bg-gray-200" style="left: <%= (tick / total * 100).round(3) %>%"></span>
                  <% end %>
                  <% lane["segments"].each do |from, to, category, detail, session_id| %>
                    <% left = total.positive? ? from / total * 100 : 0 %>
                    <% width = total.positive? ? (to - from) / total * 100 : 0 %>
                    <% session_label = lane["rollup"] && session_id ? "Session ##{session_id} — #{sessions_by_id[session_id]&.dig('title')}" : nil %>
                    <div class="absolute inset-y-0.5 rounded-[2px] ring-1 ring-white hover:ring-gray-900 hover:z-10"
                         style="left: <%= left.round(4) %>%; width: max(1px, <%= width.round(4) %>%); <%= cycle_category_style(category) %>"
                         <%= tag.attributes(data: cycle_segment_data(category: category, seconds: to - from, detail: detail, from: from, to: to, started_at: a.started_at, session: session_label)) %>></div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="mt-3"><%= render "legend", keys: CycleTimes::Categories::KEYS.select { |k| a.session_category_seconds.key?(k) || a.category_seconds.key?(k) } %></div>
      </section>

      <section class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6" aria-labelledby="top-segments">
        <h2 id="top-segments" class="text-sm font-semibold text-gray-900 px-4 sm:px-5 pt-4">Stretches that cost the most</h2>
        <p class="text-xs text-gray-500 px-4 sm:px-5 mb-2">Hierarchy time each single segment accounts for, after overlap.</p>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
              <tr>
                <th class="px-3 py-2 text-left font-medium">Category</th>
                <th class="px-3 py-2 text-left font-medium">What</th>
                <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Session</th>
                <th class="px-3 py-2 text-right font-medium">Time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% a.top_segments.each do |segment| %>
                <tr>
                  <td class="px-3 py-2 whitespace-nowrap">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block w-3 h-3 rounded-sm" style="<%= cycle_category_style(segment["category"]) %>"></span>
                      <%= CycleTimes::Categories.label(segment["category"]) %>
                    </span>
                  </td>
                  <td class="px-3 py-2 text-gray-700 break-words max-w-xl"><%= segment["detail"] %></td>
                  <td class="px-3 py-2 hidden md:table-cell"><%= link_to "##{segment['session_id']}", session_path(segment["session_id"]), class: "font-mono text-indigo-700 hover:underline" %></td>
                  <td class="px-3 py-2 text-right font-mono text-gray-900 whitespace-nowrap"><%= cycle_duration(segment["seconds"]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
  <%= render "tooltip" %>
</div>
