<%# The one hover tooltip every segment on the page shares; see cycle_time_chart_controller.js. %>
<div data-cycle-time-chart-target="tooltip" role="tooltip"
     class="hidden fixed z-50 max-w-sm pointer-events-none rounded-md bg-gray-900 text-white text-xs shadow-lg px-3 py-2 space-y-1">
  <div class="flex items-center gap-2">
    <span data-role="swatch" class="inline-block w-3 h-3 rounded-sm shrink-0"></span>
    <span data-role="label" class="font-semibold"></span>
    <span data-role="duration" class="ml-auto font-mono text-gray-300"></span>
  </div>
  <div data-role="window" class="font-mono text-[11px] text-gray-300"></div>
  <div data-role="session" class="text-[11px] text-gray-300"></div>
  <div data-role="detail" class="text-gray-100 break-words"></div>
</div>
