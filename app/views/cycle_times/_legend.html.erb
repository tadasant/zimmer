<%# locals: keys (Array of category keys to show) %>
<ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600">
  <% keys.each do |key| %>
    <li class="flex items-center gap-1.5">
      <span class="inline-block w-3 h-3 rounded-sm" style="<%= cycle_category_style(key) %>"></span>
      <%= CycleTimes::Categories.label(key) %>
    </li>
  <% end %>
</ul>
