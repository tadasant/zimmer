<% content_for :title, "Cycle Time" %>
<div class="min-h-screen bg-gray-50" data-controller="cycle-time-chart"
     data-action="mouseover->cycle-time-chart#show mousemove->cycle-time-chart#move mouseout->cycle-time-chart#hide">
  <div class="max-w-[100rem] mx-auto px-3 sm:px-6 py-6">
    <div class="flex items-center min-w-0 mb-4">
      <%= link_to root_path, class: "text-gray-500 hover:text-gray-700 mr-3 shrink-0" do %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900 truncate">Cycle Time</h1>
    </div>

    <p class="text-sm text-gray-600 mb-4 max-w-4xl">
      Tasks Zimmer finished on its own. Each row is a whole session hierarchy: the root and everything it spawned,
      where every session was archived by the task itself, no human spoke after the first prompt, and no session
      overslept a wake that never fired. The bars split each
      task's wall-clock into what it was doing. When sessions overlapped, a moment counts toward work if any session
      was working, and toward a wait only if all of them were waiting.
    </p>

    <div class="mb-6">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex gap-4 sm:gap-6 overflow-x-auto" aria-label="Window">
          <% CostWindow::PRESETS.except(365).each do |days, label| %>
            <% active = !@window.custom? && @window.preset_days == days %>
            <%= link_to label, cycle_times_path({ days: days, agent_root: @agent_root }.compact),
                class: "whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium #{active ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}",
                "aria-current": (active ? "page" : nil) %>
          <% end %>
        </nav>
      </div>
      <%= form_with url: cycle_times_path, method: :get, data: { turbo: false }, class: "mt-3 flex flex-wrap items-end gap-2 sm:gap-3" do |f| %>
        <div class="min-w-0">
          <label for="cycle-from" class="block text-xs font-medium text-gray-500 mb-1">From</label>
          <%= f.date_field :from, id: "cycle-from", value: @window.from_date, max: Date.current.iso8601,
                class: "block w-full sm:w-auto rounded-md border-gray-300 shadow-sm text-sm py-1.5 px-2" %>
        </div>
        <div class="min-w-0">
          <label for="cycle-to" class="block text-xs font-medium text-gray-500 mb-1">To</label>
          <%= f.date_field :to, id: "cycle-to", value: @window.to_date, max: Date.current.iso8601,
                class: "block w-full sm:w-auto rounded-md border-gray-300 shadow-sm text-sm py-1.5 px-2" %>
        </div>
        <div class="min-w-0">
          <label for="cycle-agent-root" class="block text-xs font-medium text-gray-500 mb-1">Agent root</label>
          <%= f.select :agent_root, options_for_select([ [ "All roots", "" ] ] + @agent_roots.map { |r| [ r, r ] }, @agent_root),
                {}, id: "cycle-agent-root", class: "block w-full sm:w-auto rounded-md border-gray-300 shadow-sm text-sm py-1.5 px-2" %>
        </div>
        <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
          Apply
        </button>
        <p class="text-xs text-gray-400 basis-full sm:basis-auto sm:ml-1 sm:self-center">
          Finished in <span class="font-medium text-gray-500"><%= @window.label %></span>
        </p>
      <% end %>
    </div>

    <% wall = @report.wall_seconds %>
    <% totals = @report.totals %>
    <section class="bg-white border border-gray-200 rounded-lg p-4 sm:p-5 mb-6" aria-labelledby="cycle-summary">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-3">
        <h2 id="cycle-summary" class="text-sm font-semibold text-gray-900">Where the time went</h2>
        <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <div><dt class="inline text-gray-500">Tasks</dt> <dd class="inline font-semibold text-gray-900"><%= @total %></dd></div>
          <div><dt class="inline text-gray-500">Total</dt> <dd class="inline font-semibold text-gray-900"><%= cycle_duration(wall) %></dd></div>
          <% if (p = @report.wall_percentiles).any? %>
            <div><dt class="inline text-gray-500">Median</dt> <dd class="inline font-semibold text-gray-900"><%= cycle_duration(p["p50"]) %></dd></div>
            <div><dt class="inline text-gray-500">p90</dt> <dd class="inline font-semibold text-gray-900"><%= cycle_duration(p["p90"]) %></dd></div>
          <% end %>
        </dl>
      </div>

      <% if @total.zero? %>
        <p class="text-sm text-gray-500">No autonomous task finished in this window.</p>
      <% else %>
        <%= render "stacked_bar", totals: totals, total: wall, height: "h-6" %>
        <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <table class="w-full text-sm min-w-0">
            <caption class="sr-only">Hierarchy time by category</caption>
            <thead class="text-[11px] uppercase tracking-wide text-gray-500">
              <tr><th class="text-left font-medium py-1">Category</th><th class="text-right font-medium py-1">Time</th><th class="text-right font-medium py-1">Share</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% CycleTimes::Categories.ordered(totals).sort_by { |_, s| -s }.each do |key, seconds| %>
                <tr>
                  <td class="py-1.5">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block w-3 h-3 rounded-sm shrink-0" style="<%= cycle_category_style(key) %>"></span>
                      <span class="text-gray-800"><%= CycleTimes::Categories.label(key) %></span>
                    </span>
                  </td>
                  <td class="py-1.5 text-right font-mono text-gray-700"><%= cycle_duration(seconds) %></td>
                  <td class="py-1.5 text-right font-mono text-gray-500"><%= cycle_share(seconds, wall) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div class="text-sm space-y-4 min-w-0">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Biggest waits</h3>
              <ol class="space-y-1">
                <% @report.top_waits.each do |key, seconds| %>
                  <li class="flex items-center gap-2">
                    <span class="inline-block w-3 h-3 rounded-sm shrink-0" style="<%= cycle_category_style(key) %>"></span>
                    <span class="text-gray-800"><%= CycleTimes::Categories.label(key) %></span>
                    <span class="ml-auto font-mono text-gray-600"><%= cycle_duration(seconds) %> · <%= cycle_share(seconds, wall) %></span>
                  </li>
                <% end %>
              </ol>
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Longest single stretches</h3>
              <ol class="space-y-1">
                <% @report.top_segments(5).each do |segment| %>
                  <li class="flex items-start gap-2">
                    <span class="mt-1 inline-block w-3 h-3 rounded-sm shrink-0" style="<%= cycle_category_style(segment["category"]) %>"></span>
                    <span class="min-w-0">
                      <%= link_to segment["task"].to_s.truncate(60), cycle_time_path(segment["root_session_id"]), class: "text-indigo-700 hover:underline" %>
                      <span class="block text-xs text-gray-500 truncate"><%= segment["detail"] %></span>
                    </span>
                    <span class="ml-auto font-mono text-gray-600 shrink-0"><%= cycle_duration(segment["seconds"]) %></span>
                  </li>
                <% end %>
              </ol>
            </div>
          </div>
        </div>
      <% end %>

      <% skipped = @report.ineligible_counts %>
      <% pending = @report.pending_count %>
      <% if skipped.any? || pending.positive? %>
        <p class="mt-4 text-xs text-gray-500">
          <% if skipped.any? %>
            Not shown: <%= skipped.values.sum %> <%= "hierarchy".pluralize(skipped.values.sum) %> that finished in this window without running autonomously
            (<%= skipped.sort_by { |_, n| -n }.map { |reason, n| "#{n} — #{CycleTimes::Eligibility::REASONS[reason]&.downcase || reason}" }.join("; ") %>).
          <% end %>
          <% if pending.positive? %>
            <%= pending %> archived <%= "root".pluralize(pending) %> in this window <%= pending == 1 ? "is" : "are" %> still in flight or not yet analyzed.
          <% end %>
        </p>
      <% end %>
    </section>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-2 sm:px-3 py-2 text-left font-medium">Finished</th>
              <th class="px-2 sm:px-3 py-2 text-left font-medium">Task</th>
              <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Started by</th>
              <th class="px-3 py-2 text-right font-medium hidden sm:table-cell">Sessions</th>
              <th class="px-2 sm:px-3 py-2 text-right font-medium">Cycle time</th>
              <th class="px-3 py-2 text-left font-medium w-1/3 hidden sm:table-cell">Breakdown</th>
              <th class="px-3 py-2 text-left font-medium hidden lg:table-cell">Biggest wait</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @rows.each do |row| %>
              <tr class="hover:bg-gray-50">
                <td class="px-2 sm:px-3 py-2 whitespace-nowrap text-gray-600"><%= row.finished_at.in_time_zone.strftime("%b %-d %H:%M") %></td>
                <td class="px-2 sm:px-3 py-2 min-w-0 max-w-[16rem] sm:max-w-md">
                  <%= link_to row.title.presence || "Session ##{row.root_session_id}", cycle_time_path(row.root_session_id, @window.to_params.merge(agent_root: @agent_root).compact),
                      class: "text-indigo-700 hover:underline line-clamp-2 break-words" %>
                  <span class="text-xs text-gray-400"><%= row.agent_root %></span>
                  <div class="sm:hidden mt-1"><%= render "stacked_bar", totals: row.category_seconds, total: row.wall_seconds %></div>
                </td>
                <td class="px-3 py-2 text-gray-600 hidden md:table-cell whitespace-nowrap"><%= row.initiator == "trigger" ? "Trigger" : row.initiator == "human" ? "Human prompt" : "API / agent" %></td>
                <td class="px-3 py-2 text-right font-mono text-gray-600 hidden sm:table-cell"><%= row.session_count %></td>
                <td class="px-2 sm:px-3 py-2 text-right font-mono text-gray-900 whitespace-nowrap"><%= cycle_duration(row.wall_seconds) %></td>
                <td class="px-3 py-2 hidden sm:table-cell"><%= render "stacked_bar", totals: row.category_seconds, total: row.wall_seconds %></td>
                <td class="px-3 py-2 text-gray-600 hidden lg:table-cell whitespace-nowrap">
                  <% if row.dominant_wait_category %>
                    <span class="inline-flex items-center gap-1.5">
                      <span class="inline-block w-2.5 h-2.5 rounded-sm" style="<%= cycle_category_style(row.dominant_wait_category) %>"></span>
                      <%= CycleTimes::Categories.label(row.dominant_wait_category) %>
                      <span class="font-mono text-gray-400"><%= cycle_duration(row.category_seconds[row.dominant_wait_category]) %></span>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @page > 1 || @has_next_page %>
        <div class="flex justify-between px-3 py-2 border-t border-gray-100 text-sm">
          <%= @page > 1 ? link_to("← Newer", cycle_times_path(request.query_parameters.merge(page: @page - 1)), class: "text-indigo-700") : tag.span %>
          <%= @has_next_page ? link_to("Older →", cycle_times_path(request.query_parameters.merge(page: @page + 1)), class: "text-indigo-700") : tag.span %>
        </div>
      <% end %>
    </div>

    <div class="mt-4"><%= render "legend", keys: CycleTimes::Categories::KEYS %></div>
  </div>
  <%= render "tooltip" %>
</div>
