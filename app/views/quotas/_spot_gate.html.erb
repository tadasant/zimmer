<%# The spot gate: the policy, the live reading it acts on, and one button per
    non-trigger genesis kind to move it between spot and priority. The kinds a
    trigger produces are not here — their selector lives on the trigger itself.

    It lives on this page because the thing it acts on is here: the Claude Code
    quota windows the rest of the page reports. %>
<div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6" id="spot-gate">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">Spot vs priority</h2>
    <p class="mt-1 text-sm text-gray-500">
      Every session runs as <strong>priority</strong> or <strong>spot</strong>. Priority sessions always
      start. A spot session starts while the Claude Code account pool is under both targets below on average
      and a session slot is free — a target is a level to reach, not a line to stay clear of. Once a
      window reaches its target, or every slot is taken, a spot session waits and starts later; it is
      never cancelled. A session's class is the one chosen for it, or the one its trigger carries, or
      failing both the default for its <strong>genesis</strong> — where the work came from.
    </p>
  </div>

  <div class="px-4 py-5 sm:px-6 space-y-6">
    <%# ---- The policy form ---- %>
    <%= form_with url: spot_policy_path, method: :patch, data: { turbo: false } do %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-gray-900">Fill up to these targets, then hold spot sessions</div>
          <p class="mt-1 text-sm text-gray-500">
            Off means spot sessions start like any other and the targets are ignored.
          </p>
        </div>
        <input type="hidden" name="app_setting[spot_gating_enabled]" value="0">
        <label class="relative inline-flex items-center cursor-pointer shrink-0">
          <span class="sr-only">Toggle spot gating</span>
          <input type="checkbox"
                 name="app_setting[spot_gating_enabled]"
                 id="app_setting_spot_gating_enabled"
                 value="1"
                 class="sr-only peer"
                 role="switch"
                 aria-label="Fill up to these targets, then hold spot sessions"
                 <%= "checked" if @app_setting.spot_gating_enabled %>>
          <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-focus:ring-2 peer-focus:ring-indigo-500 peer-checked:bg-indigo-600 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:border after:border-gray-300 after:shadow after:transition-all peer-checked:after:translate-x-5"></div>
        </label>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label for="app_setting_spot_max_concurrent_sessions" class="block text-sm font-medium text-gray-700 mb-2">
            Max sessions at once
          </label>
          <input type="number"
                 name="app_setting[spot_max_concurrent_sessions]"
                 id="app_setting_spot_max_concurrent_sessions"
                 value="<%= @app_setting.spot_max_concurrent_sessions %>"
                 min="1" max="100" step="1"
                 class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2 border">
          <p class="mt-1 text-xs text-gray-500">
            Every running session counts, priority included — priority work is meant to crowd spot work
            out of the slots. Only spot sessions wait for one.
          </p>
        </div>
        <div>
          <label for="app_setting_spot_gate_five_hour_threshold_pct" class="block text-sm font-medium text-gray-700 mb-2">
            5-hour window target (%)
          </label>
          <input type="number"
                 name="app_setting[spot_gate_five_hour_threshold_pct]"
                 id="app_setting_spot_gate_five_hour_threshold_pct"
                 value="<%= @app_setting.spot_gate_five_hour_threshold_pct %>"
                 min="0" max="100" step="1"
                 class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2 border">
        </div>
        <div>
          <label for="app_setting_spot_gate_weekly_threshold_pct" class="block text-sm font-medium text-gray-700 mb-2">
            Weekly window target (%)
          </label>
          <input type="number"
                 name="app_setting[spot_gate_weekly_threshold_pct]"
                 id="app_setting_spot_gate_weekly_threshold_pct"
                 value="<%= @app_setting.spot_gate_weekly_threshold_pct %>"
                 min="0" max="100" step="1"
                 class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2 border">
        </div>
      </div>

      <div class="mt-4">
        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          Save spot policy
        </button>
      </div>
    <% end %>

    <%# ---- The live decision ---- %>
    <div class="rounded-md border <%= @spot_decision.allowed? ? "border-green-200 bg-green-50" : "border-amber-200 bg-amber-50" %> p-4" id="spot-gate-status">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= @spot_decision.allowed? ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800" %>">
          <%= @spot_decision.allowed? ? "Spot sessions running" : "Spot sessions held" %>
        </span>
        <span class="text-xs text-gray-500 font-mono"><%= @spot_decision.reason %></span>
      </div>
      <p class="mt-2 text-sm text-gray-700"><%= @spot_decision.detail %></p>
      <%# One decision, rendered once, so the badge above and this line are the
          same answer rather than two readings that can disagree. %>
      <p class="mt-1 text-sm <%= @spot_decision.allowed? ? "text-gray-500" : "text-amber-800 font-medium" %>" id="spot-gate-start-decision">
        A spot session starting right now would be
        <strong><%= @spot_decision.allowed? ? "started" : "held" %></strong>.
      </p>

      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 text-sm">
        <div>
          <dt class="text-gray-500">Sessions running</dt>
          <dd class="font-medium text-gray-900" id="spot-active-sessions">
            <%= @spot_decision.active_sessions %>
            <% if @spot_decision.fleet_cap %>
              <span class="text-gray-400 font-normal">of <%= @spot_decision.fleet_cap %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-gray-500">5-hour window</dt>
          <dd class="font-medium text-gray-900" id="spot-window-5h">
            <% if @spot_decision.five_hour %>
              <%= number_with_precision(@spot_decision.five_hour.current_pct, precision: 1) %>%
              <span class="text-gray-400 font-normal">
                of <%= @spot_decision.five_hour.threshold_pct.round %>%
              </span>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-gray-500">Weekly window</dt>
          <dd class="font-medium text-gray-900" id="spot-window-7d">
            <% if @spot_decision.weekly %>
              <%= number_with_precision(@spot_decision.weekly.current_pct, precision: 1) %>%
              <span class="text-gray-400 font-normal">
                of <%= @spot_decision.weekly.threshold_pct.round %>%
              </span>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </dd>
        </div>
      </dl>
      <% if @spot_decision.pool_size %>
        <p class="mt-2 text-xs text-gray-500" id="spot-gate-pool-note">
          Windows averaged across
          <%= @spot_decision.accounts_read == @spot_decision.pool_size ? "all #{pluralize(@spot_decision.pool_size, 'account')}" : "#{@spot_decision.accounts_read} of #{pluralize(@spot_decision.pool_size, 'account')}" %>
          in the pool, every status included — the same figure the Account Pool section above shows.
          One account at its cap does not hold the fleet while the rest still has room; an account
          whose 7-day window is spent counts as 100% here, because its 5-hour headroom can't be served.
        </p>
      <% end %>
    </div>

    <%# ---- One click per non-trigger genesis ---- %>
    <div>
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium text-gray-900">Sessions no trigger started</h3>
        <%= button_to "Reset to defaults", reset_genesis_classes_path, method: :delete,
              form: { data: { turbo: false } },
              class: "text-xs text-gray-500 hover:text-gray-800 underline" %>
      </div>
      <p class="mt-1 text-sm text-gray-500">
        Changing one of these reclassifies every session from that genesis at once, including ones
        that already exist — except any that were given a class of their own, which keep it.
        Sessions a <%= link_to "trigger", triggers_path, class: "text-indigo-600 hover:text-indigo-500" %>
        starts are not here: each trigger carries its own scheduling class, so one noisy Slack trigger
        can be spot without demoting the rest.
      </p>

      <%# A four-column table does not fit a phone, and its Action cell holds the only
          control here — so below `sm` the same rows render as stacked cards, keeping
          the button on screen. Both renderings derive their state from
          `genesis_kind_state` so they cannot disagree. `data-genesis-class` lives on
          the table alone, so a selector for it matches exactly once. %>
      <div class="mt-3 divide-y divide-gray-100 border border-gray-200 rounded-md sm:hidden">
        <% SessionGenesis::SETTABLE_KINDS.each do |kind| %>
          <% current, target, overridden, badge = genesis_kind_state(kind, @genesis_classes) %>
          <div class="p-4" id="genesis-card-<%= kind.key %>">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="font-medium text-gray-900 break-words"><%= kind.label %></div>
                <div class="text-xs text-gray-400 font-mono break-all"><%= kind.key %></div>
              </div>
              <span class="inline-flex flex-shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= badge %>">
                <span class="sr-only">Class:</span><%= current %>
              </span>
            </div>
            <% if overridden %>
              <div class="mt-1 text-xs text-amber-600">changed from <%= kind.default_class %></div>
            <% end %>
            <p class="mt-2 text-xs text-gray-500"><%= kind.description %></p>
            <div class="mt-3 flex items-center justify-between gap-3">
              <span class="text-xs text-gray-500">
                <%= pluralize(@genesis_counts[kind.key].to_i, "live session") %>
              </span>
              <%= button_to "Make #{target}",
                    genesis_class_path(genesis: kind.key, priority_class: target),
                    method: :patch,
                    form: { data: { turbo: false }, class: "flex-shrink-0" },
                    class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-3 hidden overflow-x-auto border border-gray-200 rounded-md sm:block">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500">Genesis</th>
              <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500">Class</th>
              <th scope="col" class="px-4 py-2 text-right font-medium text-gray-500">Live sessions</th>
              <th scope="col" class="px-4 py-2 text-right font-medium text-gray-500">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% SessionGenesis::SETTABLE_KINDS.each do |kind| %>
              <% current, target, overridden, badge = genesis_kind_state(kind, @genesis_classes) %>
              <tr id="genesis-row-<%= kind.key %>">
                <td class="px-4 py-3 align-top">
                  <div class="font-medium text-gray-900"><%= kind.label %></div>
                  <div class="text-xs text-gray-400 font-mono"><%= kind.key %></div>
                  <p class="mt-1 text-xs text-gray-500 max-w-xl"><%= kind.description %></p>
                </td>
                <td class="px-4 py-3 align-top">
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= badge %>"
                        data-genesis-class="<%= kind.key %>">
                    <%= current %>
                  </span>
                  <% if overridden %>
                    <div class="mt-1 text-xs text-amber-600">changed from <%= kind.default_class %></div>
                  <% end %>
                </td>
                <td class="px-4 py-3 align-top text-right text-gray-700">
                  <%= @genesis_counts[kind.key].to_i %>
                </td>
                <td class="px-4 py-3 align-top text-right">
                  <%= button_to "Make #{target}",
                        genesis_class_path(genesis: kind.key, priority_class: target),
                        method: :patch,
                        form: { data: { turbo: false } },
                        class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
