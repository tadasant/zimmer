<%# The GitHub half: open issues across the watched repos that are NOT on the queue.
    Held, unrated, or simply not picked up yet — this is what makes the page "what
    is going on in GitHub" rather than only "what is queued".

    Paginated at Issues::Board::GITHUB_PER_PAGE. The repos carry roughly 500 open
    issues between them and a page that renders all of them is a page nobody
    scrolls. The repo and direction filters above narrow this list too. %>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-2 sm:px-3 py-2 text-left font-medium">Issue</th>
          <th class="px-2 sm:px-3 py-2 text-left font-medium">Direction</th>
          <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Labels</th>
          <th class="px-3 py-2 text-right font-medium hidden lg:table-cell">Opened</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% rows.each do |row| %>
          <tr class="hover:bg-gray-50 align-top">
            <td class="px-2 sm:px-3 py-2 min-w-0">
              <%= issue_safe_link(row.github.url, row.github.title,
                  class: "text-gray-900 font-medium hover:text-indigo-700 wrap-anywhere line-clamp-2") %>
              <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                <span class="text-xs text-gray-500"><%= row.github.key %></span>
                <% if row.held? %>
                  <%# The gate looked at this and said no. Distinct from unrated:
                      one is a decision, the other is a queue nobody has reached. %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-semibold">held by the gate</span>
                <% end %>
              </div>
            </td>
            <td class="px-2 sm:px-3 py-2"><%= render "direction_pill", resolution: row.direction %></td>
            <td class="px-3 py-2 hidden md:table-cell">
              <div class="flex flex-wrap gap-1">
                <% (row.github.labels - Issues::Direction::LABELS - [ Issues::Board::HOLD_LABEL ]).first(4).each do |label| %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-gray-100 text-gray-600 text-[10px] whitespace-nowrap"><%= label %></span>
                <% end %>
              </div>
            </td>
            <td class="px-3 py-2 text-gray-500 text-xs text-right whitespace-nowrap hidden lg:table-cell"><%= row.github.created_at&.to_date&.to_fs(:iso8601) %></td>
          </tr>
        <% end %>
        <% if rows.empty? %>
          <tr><td colspan="4" class="px-3 py-8 text-center text-sm text-gray-500">
            <%= snapshot.failed? ? "GitHub could not be read — see the note above." : "Every open issue that matches these filters is already on the queue." %>
          </td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if page_count > 1 %>
  <div class="flex items-center justify-between mt-3 text-sm">
    <div>
      <% if page > 1 %>
        <%= link_to "← Previous", issues_path(query_params.merge("gh_page" => page - 1)), class: "px-3 py-1.5 border border-gray-300 rounded-md bg-white hover:bg-gray-50" %>
      <% end %>
    </div>
    <span class="text-xs text-gray-500">
      <%= number_with_delimiter(total) %> open <%= "issue".pluralize(total) %> not on the queue · page <%= page %> of <%= page_count %>
    </span>
    <div>
      <% if page < page_count %>
        <%= link_to "Next →", issues_path(query_params.merge("gh_page" => page + 1)), class: "px-3 py-1.5 border border-gray-300 rounded-md bg-white hover:bg-gray-50" %>
      <% end %>
    </div>
  </div>
<% end %>
