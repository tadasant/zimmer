<%# One table, four sections: the started items an agent is still advancing, the
    ones parked on a person, the ones whose session ended recently, and the
    stranded ones. They differ only in which scope filled `rows`, what to say when
    there are none, and whether the sweep's verdict column is worth showing — so
    they share a partial and cannot drift apart in how they render a row.

    `liveness` is off by default: on the first three lists WorkBacklog::StaleStartSweep
    has nothing to say, because it only ever examines a row whose session has
    ended and has stayed ended.

    Deliberately NOT narrowed by the filter bar — "what is the fleet working on"
    is a fixed question, and a repo filter that emptied this list would read as
    "nothing is running". %>
<% liveness = local_assigns.fetch(:liveness, false) %>
<div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-6">
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-2 sm:px-3 py-2 text-left font-medium">Issue</th>
          <th class="px-2 sm:px-3 py-2 text-left font-medium">Direction</th>
          <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Started</th>
          <th class="px-2 sm:px-3 py-2 text-left font-medium">Session</th>
          <% if liveness %>
            <th class="px-2 sm:px-3 py-2 text-left font-medium">Last checked</th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% rows.each do |row| %>
          <tr class="hover:bg-gray-50 align-top">
            <td class="px-2 sm:px-3 py-2 min-w-0">
              <div class="text-gray-900 font-medium wrap-anywhere line-clamp-2"><%= row.item.title %></div>
              <% if row.issue_url.present? %>
                <%= issue_safe_link(row.issue_url, row.key, class: "text-xs text-indigo-600 hover:text-indigo-800") %>
              <% else %>
                <span class="text-xs text-gray-400"><%= row.key %></span>
              <% end %>
            </td>
            <td class="px-2 sm:px-3 py-2"><%= render "direction_pill", resolution: row.direction %></td>
            <td class="px-3 py-2 text-gray-500 text-xs whitespace-nowrap hidden md:table-cell"><%= row.item.started_at&.to_fs(:iso8601) || "—" %></td>
            <td class="px-2 sm:px-3 py-2">
              <% if row.item.started_session %>
                <%= link_to "##{row.item.started_session_id}", session_path(row.item.started_session),
                    class: "text-xs text-indigo-600 hover:text-indigo-800" %>
                <span class="text-[11px] text-gray-500"><%= row.item.started_session.status %></span>
              <% else %>
                <span class="text-xs text-gray-400">—</span>
              <% end %>
            </td>
            <%# The sweep's verdict, and when it last looked. A row with no
                verdict is one the sweep has not reached yet rather than one it
                had nothing to say about, so the two are spelled differently. %>
            <% if liveness %>
              <td class="px-2 sm:px-3 py-2">
                <% if row.item.liveness_state %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[11px] font-semibold wrap-anywhere">
                    <%= row.item.liveness_state.tr("_", " ") %>
                  </span>
                  <div class="text-[11px] text-gray-500 whitespace-nowrap">
                    <%= time_ago_in_words(row.item.liveness_checked_at) %> ago<%= " · re-queued #{row.item.requeue_count}×" if row.item.requeue_count.positive? %>
                  </div>
                <% else %>
                  <span class="text-xs text-gray-400">not checked yet</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
        <% if rows.empty? %>
          <tr><td colspan="<%= liveness ? 5 : 4 %>" class="px-3 py-6 text-center text-sm text-gray-500"><%= empty_message %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
