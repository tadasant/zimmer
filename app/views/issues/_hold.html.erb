<%# Hold this stranded row for a human decision, with the decision owed.

    Posts to WorkBacklogHoldsController, through WorkBacklog::Hold — the same
    write the `hold_work_backlog_item_for_decision` MCP tool makes. It moves the
    row to "Awaiting your decision" and out of the stranded page until the hold
    lapses; it changes nothing else about the row. %>
<%= form_with url: hold_work_backlog_item_path(row.item, query_params), method: :post,
    class: "mt-1 flex items-center gap-1" do %>
  <%= text_field_tag "reason", nil,
      id: "hold_reason_#{row.item.id}", maxlength: WorkBacklogItem::HOLD_REASON_MAX, required: true,
      placeholder: "decision owed", title: "The decision #{row.key} is waiting on, and who owes it",
      "aria-label": "Decision #{row.key} is waiting on",
      class: "w-24 sm:w-32 text-xs border border-gray-300 rounded px-1.5 py-1" %>
  <%= submit_tag "Hold", name: nil,
      class: "text-xs px-2 py-1 border border-gray-300 text-gray-700 rounded hover:bg-gray-50 whitespace-nowrap cursor-pointer" %>
<% end %>
