<%= turbo_frame_tag "trigger_#{trigger.id}" do %>
  <li class="hover:bg-gray-50">
    <div class="px-6 py-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4 min-w-0">
          <!-- Trigger Type Icon(s) -->
          <div class="flex-shrink-0 flex -space-x-1">
            <%# Icon keys come from the helper so that a condition type without a
                glyph of its own still renders the fallback, instead of an empty slot. %>
            <%= render partial: "triggers/condition_icon",
                       collection: trigger_condition_icon_keys(trigger.trigger_conditions.map(&:condition_type)),
                       as: :key %>
          </div>

          <!-- Trigger Info -->
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to trigger.name, trigger_path(trigger), class: "text-sm font-medium text-gray-900 hover:text-indigo-600 break-words min-w-0", data: { turbo: false } %>
              <!-- Status Badge -->
              <% if trigger.enabled? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                  Enabled
                </span>
              <% elsif trigger.failed? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                  Failed
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                  Disabled
                </span>
              <% end %>
              <% if trigger.reuse_session %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">
                  Re-uses session
                </span>
              <% end %>
              <% if trigger.enqueue_messages %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800">
                  Enqueues messages
                </span>
              <% end %>
              <% if trigger.resuscitate_archived %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-teal-100 text-teal-800">
                  Resuscitates archived
                </span>
              <% end %>
              <%# Only shown when the operator chose one. Every trigger has an
                  effective class, but badging all of them would say nothing about
                  most of them. %>
              <% if trigger.scheduling_class.present? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= scheduling_class_badge_css(trigger.scheduling_class) %>">
                  <%= trigger.scheduling_class.capitalize %>
                </span>
              <% end %>
              <% if trigger.precedence.present? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 tabular-nums"
                      title="Precedence stamped on spawned sessions">
                  P<%= trigger.precedence %>
                </span>
              <% end %>
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
              <span class="flex items-center">
                <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <%= trigger.trigger_conditions.size %> condition<%= trigger.trigger_conditions.size == 1 ? "" : "s" %>
              </span>
              <span class="flex items-center">
                <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <%= trigger.sessions_created_count %> sessions
              </span>
              <% if trigger.last_triggered_at %>
                <span class="flex items-center">
                  <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Last triggered <%= time_ago_in_words(trigger.last_triggered_at) %> ago
                </span>
              <% end %>
            </div>
            <% if trigger.failed? %>
              <p class="mt-1 text-sm text-red-700 break-words">
                Fire failed<%= " #{time_ago_in_words(trigger.failed_at)} ago" if trigger.failed_at %> &mdash;
                <% if trigger.spent_one_shot_wake? %>
                  its wake was already consumed, so re-arming will not re-fire it. Kept so the error is not lost.
                <% else %>
                  it did not run and will not retry on its own. Re-arm to try again.
                <% end %>
                <% if trigger.last_error.present? %>
                  <span class="block mt-0.5 font-mono text-xs text-red-600 break-all"><%= truncate(trigger.last_error, length: 200) %></span>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-2 sm:flex-shrink-0">
          <%= button_to toggle_trigger_path(trigger), method: :post, class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md #{trigger.enabled? ? 'text-gray-700 bg-white hover:bg-gray-50' : 'text-green-700 bg-green-50 hover:bg-green-100'}", data: { turbo_frame: "trigger_#{trigger.id}" } do %>
            <% if trigger.enabled? %>
              <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Disable
            <% else %>
              <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <%= trigger.failed? && !trigger.spent_one_shot_wake? ? "Re-arm" : "Enable" %>
            <% end %>
          <% end %>
          <%= link_to edit_trigger_path(trigger), class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50", data: { turbo: false } do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </li>
<% end %>
