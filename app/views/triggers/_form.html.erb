<%= form_with model: trigger, class: "space-y-6 p-6", data: {
  controller: "trigger-form goal",
  trigger_form_slack_configured_value: @slack_configured,
  trigger_form_channels_url_value: channels_triggers_path,
  trigger_form_conditions_value: trigger.trigger_conditions.map { |c| { id: c.id, condition_type: c.condition_type, configuration: c.configuration } }.to_json,
  goal_goals_value: @goals.to_json,
  goal_agent_root_defaults_value: @agent_root_goals.to_json,
  turbo_frame: "_top"
} do |f| %>
  <% if trigger.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(trigger.errors.count, "error") %> prohibited this trigger from being saved:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc list-inside">
              <% trigger.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Trigger Name -->
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
      Trigger Name
      <span class="text-red-500">*</span>
    <% end %>
    <%= f.text_field :name,
        placeholder: "e.g., CI Failure Handler",
        class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2" %>
    <p class="mt-2 text-sm text-gray-500">A descriptive name for this trigger</p>
  </div>

  <!-- Trigger Conditions Section -->
  <div>
    <div class="flex justify-between items-center mb-3">
      <label class="block text-sm font-medium text-gray-700">Trigger Conditions <span class="text-red-500">*</span></label>
      <button type="button"
              data-action="click->trigger-form#addCondition"
              class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
        <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Add Condition
      </button>
    </div>
    <p class="text-sm text-gray-500 mb-4">The trigger fires when <strong>any</strong> condition matches (OR logic). Add multiple conditions to respond to different events.</p>

    <div data-trigger-form-target="conditionsContainer" class="space-y-4">
      <% trigger.trigger_conditions.each_with_index do |condition, index| %>
        <%= f.fields_for :trigger_conditions, condition, child_index: index do |cf| %>
          <%= render partial: "triggers/condition_fields", locals: { cf: cf, condition: condition, index: index } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Session Template Section -->
  <div class="border-t border-gray-200 pt-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Session Template</h3>
    <p class="text-sm text-gray-500 mb-4">Configure how sessions will be created when this trigger fires</p>

    <!-- Agent Root Selection -->
    <div class="mb-4">
      <%= f.label :agent_root_name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        Agent Root
        <span class="text-red-500">*</span>
      <% end %>
      <%
        # A trigger is allowed to name a root the catalog does not carry — written
        # ahead of the catalog entry that defines it (zimmer#448). The options come
        # from the catalog, so without an entry for the stored name this select has
        # nothing to select: it would fall back to the blank prompt and post back
        # "", failing presence and locking the operator out of editing anything
        # else about the trigger. Carry the name instead, marked, the same way the
        # server/skill/hook/plugin controls carry an unresolvable one.
        #
        # Carrying it is unconditional; LABELLING it is not. @agent_roots is
        # AgentRootsConfig.all, which rescues a failed resolve to [] — against
        # which every stored name would land in this branch and every trigger's
        # perfectly good root would read "(not in catalog)". The model's predicate
        # is the one that knows the difference.
        agent_root_options = @agent_roots.map { |ar| [ ar.display_name, ar.name ] }
        stored_agent_root = trigger.agent_root_name.presence
        if stored_agent_root && agent_root_options.none? { |_label, name| name == stored_agent_root }
          label = trigger.agent_root_missing_from_catalog? ? "#{stored_agent_root} (not in catalog)" : stored_agent_root
          agent_root_options << [ label, stored_agent_root ]
        end
      %>
      <%= f.select :agent_root_name,
          agent_root_options,
          { prompt: "Select an agent root..." },
          class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2 pr-8",
          data: { action: "change->goal#handleAgentRootChange change->trigger-form#announceAgentRoot" } %>
      <p class="mt-2 text-sm text-gray-500">The codebase the agent will work with</p>
    </div>

    <%# The four catalog multi-selects. One partial, one Stimulus controller,
        four sets of locals (zimmer#456).

        `preserve_unknown` on all four because every `selected:` here is this
        trigger's OWN stored column rather than an agent root's defaults: a name
        the catalog no longer carries has to be shown and posted back rather than
        quietly dropped — dropping it is what deletes it from the row on the next
        save (zimmer#853). %>
    <%= render "shared/catalog_multiselect_field",
               label: "MCP Servers", accent: "indigo", payload_key: "mcp_servers",
               input_name: "trigger[mcp_servers][]",
               placeholder: "Search and select MCP servers...",
               items: catalog_multiselect_items(@servers_for_select, key: :name),
               selected: trigger.mcp_servers || [],
               agent_root_defaults: @agent_root_mcp_servers,
               preserve_unknown: true,
               emit_empty_input: true,
               wrapper_class: "mb-4",
               help: "Select MCP servers that will be available to the agent" %>

    <%= render "shared/catalog_multiselect_field",
               label: "Skills", accent: "green", payload_key: "catalog_skills",
               input_name: "trigger[catalog_skills][]",
               placeholder: "Search and select skills...",
               items: catalog_multiselect_items(@catalog_skills_for_select, key: :name),
               selected: trigger.catalog_skills || [],
               agent_root_defaults: @agent_root_catalog_skills,
               preserve_unknown: true,
               group_by_category: true,
               wrapper_class: "mb-4",
               help: "Select skills from the catalog to inject into the agent's working directory. Local skills with the same name take priority." %>

    <%= render "shared/catalog_multiselect_field",
               label: "Hooks", accent: "amber", payload_key: "catalog_hooks",
               input_name: "trigger[catalog_hooks][]",
               placeholder: "Search and select hooks...",
               items: catalog_multiselect_items(@catalog_hooks_for_select, key: :name),
               selected: trigger.catalog_hooks || [],
               agent_root_defaults: @agent_root_catalog_hooks,
               preserve_unknown: true,
               wrapper_class: "mb-4",
               help: "Select hooks from the catalog to configure Claude Code lifecycle hooks for this session." %>

    <%= render "shared/catalog_multiselect_field",
               label: "Plugins", accent: "purple", payload_key: "catalog_plugins",
               input_name: "trigger[catalog_plugins][]",
               placeholder: "Search and select plugins...",
               items: catalog_multiselect_items(@plugins_for_select, key: :id),
               selected: trigger.catalog_plugins || [],
               agent_root_defaults: @agent_root_catalog_plugins,
               preserve_unknown: true,
               show_description: true,
               wrapper_class: "mb-4",
               help: "Select plugins to bundle skills, hooks, and MCP servers together." %>

    <!-- Goal (using goal controller from sessions) -->
    <div class="mb-4">
      <div class="flex justify-between items-center mb-2">
        <%= f.label :goal, class: "block text-sm font-medium text-gray-700" do %>
          Goal
          <span data-goal-target="displayName" class="ml-2 text-xs font-normal text-indigo-600"></span>
        <% end %>
      </div>

      <div class="relative">
        <input type="text"
               data-goal-target="input"
               data-action="focus->goal#handleFocus input->goal#handleInput keydown->goal#handleKeydown"
               value="<%= trigger.goal %>"
               placeholder="Select a predefined goal or type your own..."
               autocomplete="off"
               class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md pr-10 px-3 py-2">
        <button type="button"
                data-goal-target="clearButton"
                data-action="click->goal#clear"
                class="hidden absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none focus:text-gray-600 rounded-r-md"
                aria-label="Clear goal">
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Hidden field that actually submits the value -->
      <%= f.hidden_field :goal, data: { goal_target: "hiddenField" } %>

      <!-- Dropdown for suggestions -->
      <div data-goal-target="dropdown"
           class="hidden fixed bg-white border border-gray-300 rounded-md shadow-lg max-h-96 overflow-y-auto z-50"></div>
    </div>

    <!-- Re-use Existing Session -->
    <div class="mb-4">
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :reuse_session,
              class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded",
              data: { action: "change->trigger-form#toggleReuseSubOptions" } %>
        </div>
        <div class="ml-3">
          <%= f.label :reuse_session, class: "text-sm font-medium text-gray-700" do %>
            Re-use existing session
          <% end %>
          <p class="text-sm text-gray-500">When enabled, subsequent trigger invocations will send a follow-up prompt to the previously created session instead of spawning a new one. If the previous session is no longer active, a new session will be created.</p>

          <!-- Sub-options (only relevant when reuse_session is enabled) -->
          <div class="mt-3 ml-1 space-y-3 <%= 'hidden' unless trigger.reuse_session %>" data-trigger-form-target="reuseSubOptions">
            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= f.check_box :enqueue_messages,
                    class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
              </div>
              <div class="ml-3">
                <%= f.label :enqueue_messages, class: "text-sm font-medium text-gray-700" do %>
                  Enqueue messages
                <% end %>
                <p class="text-xs text-gray-500">When the session is still running, queue the new prompt as an enqueued message instead of skipping it.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= f.check_box :resuscitate_archived,
                    class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
              </div>
              <div class="ml-3">
                <%= f.label :resuscitate_archived, class: "text-sm font-medium text-gray-700" do %>
                  Resuscitate archived sessions
                <% end %>
                <p class="text-xs text-gray-500">When the previous session has been archived, automatically unarchive it and send the follow-up prompt instead of creating a new session.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scheduling class -->
    <div class="mb-4">
      <%= f.label :scheduling_class, class: "block text-sm font-medium text-gray-700" do %>
        Scheduling class
      <% end %>
      <%= f.select :scheduling_class,
          trigger_scheduling_class_options(trigger),
          {},
          class: "mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:w-96 sm:text-sm border-gray-300 rounded-md" %>
      <p class="mt-1 text-sm text-gray-500">
        Whether sessions this trigger spawns start straight away, or wait for headroom in the
        Claude Code quota windows. Priority always starts; spot waits when a window has reached its target, or
        every session slot is taken, under the limits set on the <%= link_to "Inference page", inference_path(anchor: "spot-gate"), class: "text-indigo-600 hover:text-indigo-500" %>,
        and starts on its own later — it is never cancelled. Leave this on the default and the class
        follows the trigger's condition type: Slack triggers are priority, because someone is waiting
        on the answer; GitHub, scheduled and session-state triggers are spot. Changing this applies to
        sessions the trigger spawns from now on, and to its own already-spawned sessions still waiting
        to start — so flipping a held backlog to priority releases it. Sessions that have already
        started keep the class they ran with, and so does one you moved by hand on its own page.
        Saving tells you how many moved.
      </p>
    </div>

    <!-- Precedence -->
    <div class="mb-4">
      <%= f.label :precedence, class: "block text-sm font-medium text-gray-700" do %>
        Precedence
      <% end %>
      <%= f.number_field :precedence,
          step: 1,
          placeholder: "None",
          class: "mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-32 sm:text-sm border-gray-300 rounded-md" %>
      <p class="mt-1 text-sm text-gray-500">
        Where the sessions this trigger spawns sit in the spot queue. Higher is worked first, on an
        absolute scale — 100000 comes before 50 — and nothing renumbers, so leave gaps to slot work
        in later. Leave blank to predefine nothing. It only orders spot sessions, but it is carried on
        every session the trigger spawns, so one later demoted to spot keeps the rank set here. See the
        <%= link_to "Ranked view", root_path(view: SessionsController::VIEW_MODE_RANKED), class: "text-indigo-600 hover:text-indigo-500" %>
        for the queue this feeds.
      </p>
    </div>

    <!-- Burst control -->
    <div class="mb-4">
      <%= f.label :max_sessions_per_minute, class: "block text-sm font-medium text-gray-700" do %>
        Max sessions per minute
      <% end %>
      <%= f.number_field :max_sessions_per_minute,
          min: 1,
          step: 1,
          placeholder: "No limit",
          class: "mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-32 sm:text-sm border-gray-300 rounded-md" %>
      <p class="mt-1 text-sm text-gray-500">
        Caps how many sessions this trigger may spawn in one minute. Leave blank for no limit.
        If more events than that arrive in a minute, the trigger spawns a single burst-notice session
        — linking the sessions it already spawned — and then spawns nothing until the burst ends
        (five quiet minutes). Events that arrive during the burst are dropped, and you get exactly
        one notice per burst.
      </p>
    </div>

    <!-- Burst coalescing -->
    <div class="mb-4">
      <%= f.label :coalesce_window_seconds, class: "block text-sm font-medium text-gray-700" do %>
        Coalesce Slack messages within (seconds)
      <% end %>
      <%= f.number_field :coalesce_window_seconds,
          min: 0,
          max: 1.hour.to_i,
          step: 1,
          placeholder: Trigger::DEFAULT_COALESCE_WINDOW_SECONDS.to_s,
          class: "mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-32 sm:text-sm border-gray-300 rounded-md" %>
      <p class="mt-1 text-sm text-gray-500">
        Slack messages that land in the same channel, thread or DM within this many seconds of each
        other are treated as one event and spawn one session. Nothing is lost: the messages folded
        away are listed, with their links, in that session's prompt. Leave blank for the default
        (<%= Trigger::DEFAULT_COALESCE_WINDOW_SECONDS %>s); set 0 to give every message its own session.
        Only Slack conditions coalesce.
      </p>
      <% if trigger.persisted? && trigger.coalesce_window_inert? %>
        <p class="mt-1 text-sm text-amber-700">
          This trigger has no Slack condition, so the window is not read on any of its fires.
        </p>
      <% end %>
    </div>

    <!-- Pending-session dedup -->
    <div class="mb-4">
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :skip_if_pending_session,
              class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
        </div>
        <div class="ml-3">
          <%= f.label :skip_if_pending_session, class: "text-sm font-medium text-gray-700" do %>
            Skip while a session is still pending
          <% end %>
          <p class="text-sm text-gray-500">
            When enabled, this trigger creates nothing while a session it already spawned is still
            queued (waiting) or running — the fire is treated as already covered by that session.
            Sessions that are archived, failed, or waiting on you (needs input) do not block a fire.
            Use this for a trigger whose sessions all carry the same intent, so a slow one does not
            collect duplicate siblings. This bounds the backlog; "Max sessions per minute" above
            bounds the rate.
          </p>
        </div>
      </div>
    </div>

    <!-- Prompt Template -->
    <div>
      <%= f.label :prompt_template, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        Prompt Template
        <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_area :prompt_template,
          rows: 10,
          placeholder: "Enter the prompt template for triggered sessions.\n\nAvailable variables:\n{{link}} - Link to the Slack message\n{{text}} - Content of the message\n{{author}} - Name of the message author\n{{channel}} - Channel name\n{{time}} - Current time (HH:MM)\n{{date}} - Current date (YYYY-MM-DD)\n{{event}} - Event name (for Zimmer events)",
          class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md font-mono" %>
      <div class="mt-2 text-sm text-gray-500" data-trigger-form-target="promptHelp">
        <p>The prompt sent to the agent when the trigger fires. Available variables:</p>
        <ul class="mt-1 list-disc list-inside text-xs">
          <li><code class="bg-gray-100 px-1 rounded">{{link}}</code> - Link to the Slack message (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{text}}</code> - Content of the message (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{author}}</code> - Name of the message author (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{channel}}</code> - Channel name (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{time}}</code> - Current time (HH:MM)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{date}}</code> - Current date (YYYY-MM-DD)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{event}}</code> - Event description (Zimmer Event and GitHub conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{repo}}</code> - Repository, <code class="bg-gray-100 px-1 rounded">owner/name</code> (GitHub conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{number}}</code> - PR or issue number (GitHub conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{title}}</code> - PR or issue title (GitHub conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{labels}}</code> - Current labels, comma-separated (GitHub conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{channel_id}}</code> - Slack ID of the conversation the message is in (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{message_ts}}</code> - The message's Slack <code class="bg-gray-100 px-1 rounded">ts</code> (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{thread_ts}}</code> - The thread to reply into: the parent's <code class="bg-gray-100 px-1 rounded">ts</code>, or the message's own when it is top-level (Slack conditions)</li>
          <li><code class="bg-gray-100 px-1 rounded">{{author_id}}</code> - Slack user ID of the author; empty for a bot posting without one (Slack conditions)</li>
        </ul>
        <p class="mt-2 text-xs text-gray-500">For GitHub conditions, <code class="bg-gray-100 px-1 rounded">{{link}}</code> is the PR/issue URL, <code class="bg-gray-100 px-1 rounded">{{text}}</code> its body, and <code class="bg-gray-100 px-1 rounded">{{author}}</code> its author. A template that uses none of <code class="bg-gray-100 px-1 rounded">{{link}}</code>, <code class="bg-gray-100 px-1 rounded">{{repo}}</code> or <code class="bg-gray-100 px-1 rounded">{{number}}</code> gets the PR/issue appended as a context block, so the session always knows which item it was fired for.</p>
        <p class="mt-2 text-xs text-gray-500">When a Slack condition fires, the four Slack IDs come from Slack's own fields, never from what someone typed. A manual fire takes them from whoever runs it. Either way they render empty unless they are in Slack's ID format, so they can hold an ID but never prose. Point the agent at them rather than at anything it reads in the message. Write any variable as <code class="bg-gray-100 px-1 rounded">{{text|untrusted}}</code> to render it fenced off as outside input, with a note telling the agent it is data, not instructions.</p>
      </div>
    </div>
  </div>

  <!-- Submit Buttons -->
  <div class="flex items-center justify-between pt-6 border-t border-gray-200">
    <% if trigger.persisted? %>
      <%= link_to "Cancel", trigger_path(trigger), class: "inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <% else %>
      <%= link_to "Cancel", triggers_path, class: "inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <% end %>
    <%= f.submit trigger.persisted? ? "Update Trigger" : "Create Trigger",
        class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
  </div>
<% end %>
