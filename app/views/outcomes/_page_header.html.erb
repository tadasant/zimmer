<%# Shared chrome for the two Outcomes surfaces: the back arrow, the title, and
    the ledger/stats switch. Kept in one partial so the two pages cannot drift. %>
<div class="flex items-center justify-between gap-3 mb-4">
  <div class="flex items-center min-w-0">
    <%= link_to root_path, class: "text-gray-500 hover:text-gray-700 mr-3 shrink-0" do %>
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900 truncate"><%= title %></h1>
  </div>
  <nav class="flex shrink-0 rounded-md border border-gray-300 overflow-hidden text-sm">
    <%= link_to "Ledger", outcomes_path(filters.to_query_params),
        class: "px-3 py-1.5 #{current == :ledger ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-50'}" %>
    <%= link_to "Stats", outcomes_stats_path(filters.to_query_params),
        class: "px-3 py-1.5 border-l border-gray-300 #{current == :stats ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-50'}" %>
  </nav>
</div>
