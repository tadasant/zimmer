<% content_for :title, "Goal checks" %>
<div class="min-h-screen bg-gray-50">
  <div class="max-w-[100rem] mx-auto px-3 sm:px-6 py-6">
    <%= render "page_header", title: "Goal checks", filters: @filters, current: :goal_checks %>

    <p class="text-sm text-gray-600 mb-4">
      How the <%= link_to "goal check", "https://docs.zimmer.tadasant.com/sessions/goals/#how-a-goal-is-checked", class: "text-indigo-600 hover:text-indigo-800" %>
      read on sessions that came to rest (needs input or archived), windowed on created-at<%= " since #{@tally.from_time.to_date.iso8601}" if @tally.from_time %><%= " until #{@tally.to_time.to_date.iso8601}" if @tally.to_time %>.
      The check is advisory, and nothing acts on it. This page is how to tell whether it reads right.
    </p>

    <%= render "filters", url: outcomes_goal_checks_path, filters: @filters,
        agent_root_options: @agent_root_options, runtime_options: @runtime_options,
        model_options: @model_options, show_analyzed_filter: false, show_outcome_filter: false, summary: nil %>

    <% if !@tally.any? %>
      <div class="bg-white border border-gray-200 rounded-lg p-10 text-center text-sm text-gray-500">
        No session at rest in this window has a catalog goal with checks.
        <%= pluralize(@tally.resting_sessions, "session") %> came to rest with a free-text goal or none.
      </div>
    <% else %>
      <% verdicts = @tally.verdicts %>
      <div class="grid grid-cols-2 lg:grid-cols-6 gap-2 mb-4" data-goal-check-tally>
        <% [
             [ "At rest", number_with_delimiter(@tally.resting_sessions), "text-gray-900", nil ],
             [ "Checked", number_with_delimiter(@tally.checked_sessions), "text-gray-900", nil ],
             [ "Met", number_with_delimiter(verdicts["met"]), "text-emerald-700", "met" ],
             [ "Unmet", number_with_delimiter(verdicts["unmet"]), verdicts["unmet"].positive? ? "text-red-700" : "text-gray-400", "unmet" ],
             [ "Pending", number_with_delimiter(verdicts["pending"]), verdicts["pending"].positive? ? "text-yellow-700" : "text-gray-400", "pending" ],
             [ "Via spawned session", number_with_delimiter(@tally.delegated_sessions), "text-gray-900", nil ]
           ].each do |label, value, color, verdict| %>
          <div class="bg-white border border-gray-200 rounded-lg px-3 py-2" <%= "data-verdict=#{verdict}" if verdict %>>
            <div class="text-xl font-bold tabular-nums <%= color %>"><%= value %></div>
            <div class="text-[11px] text-gray-500 uppercase tracking-wide"><%= label %></div>
          </div>
        <% end %>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        <% [
             [ "Why unmet", "Grouped by the criteria that read unmet.", @tally.unmet_reasons ],
             [ "Why pending", "Grouped by the criteria not yet met.", @tally.pending_reasons ]
           ].each do |heading, subtitle, reasons| %>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="px-3 py-2 border-b border-gray-200">
              <h2 class="text-sm font-semibold text-gray-900"><%= heading %></h2>
              <p class="text-xs text-gray-500"><%= subtitle %></p>
            </div>
            <% if reasons.empty? %>
              <p class="px-3 py-4 text-sm text-gray-400">None.</p>
            <% else %>
              <ul class="divide-y divide-gray-100">
                <% reasons.each do |reason| %>
                  <li class="px-3 py-2 text-sm">
                    <div class="flex items-start justify-between gap-3">
                      <span class="min-w-0 break-words text-gray-800"><%= reason.criteria.map { |key| GoalCheck::CRITERIA.fetch(key, key) }.join(" · ") %></span>
                      <span class="shrink-0 font-semibold tabular-nums text-gray-900"><%= reason.sessions %></span>
                    </div>
                    <div class="mt-1 flex flex-wrap gap-x-2 gap-y-1 text-xs">
                      <% reason.sample_session_ids.each do |id| %>
                        <%= link_to "##{id}", session_path(id), class: "text-indigo-600 hover:text-indigo-800" %>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <div class="px-3 py-2 border-b border-gray-200">
            <h2 class="text-sm font-semibold text-gray-900">Unmet on its own pull request</h2>
            <p class="text-xs text-gray-500">
              At rest, holding a PR it recorded itself, and unmet only on what that PR shows on GitHub.
              This is who a re-prompt would reach. Nothing reaches them.
            </p>
          </div>
          <% if @tally.unmet_on_own_pull_request.empty? %>
            <p class="px-3 py-4 text-sm text-gray-400">None.</p>
          <% else %>
            <ul class="divide-y divide-gray-100">
              <% @tally.unmet_on_own_pull_request.each do |row| %>
                <li class="px-3 py-2 text-sm" data-own-pull-request-session="<%= row.session_id %>">
                  <div class="flex items-start gap-2">
                    <%= link_to "##{row.session_id}", session_path(row.session_id), class: "shrink-0 text-indigo-600 hover:text-indigo-800" %>
                    <span class="min-w-0 break-words text-gray-800"><%= row.title %></span>
                  </div>
                  <div class="mt-0.5 text-xs text-gray-500 break-words">
                    <%= row.status.humanize %> · <%= row.unmet_criteria.map { |key| GoalCheck::CRITERIA.fetch(key, key) }.join(" · ") %>
                  </div>
                </li>
              <% end %>
            </ul>
            <% if @tally.unmet_on_own_pull_request_count > @tally.unmet_on_own_pull_request.size %>
              <p class="px-3 py-2 text-xs text-gray-500">First <%= @tally.unmet_on_own_pull_request.size %> of <%= @tally.unmet_on_own_pull_request_count %>.</p>
            <% end %>
          <% end %>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <div class="px-3 py-2 border-b border-gray-200">
            <h2 class="text-sm font-semibold text-gray-900">By criterion</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
                <tr>
                  <th class="px-2 sm:px-3 py-2 text-left font-medium">Criterion</th>
                  <%# Phone headers are one glyph each: four status words beside a wrapping
                      label do not fit in 360px. The title carries the word. %>
                  <% { "met" => "✓", "unmet" => "✗", "pending" => "…", "unknown" => "?" }.each do |status, glyph| %>
                    <th class="px-1.5 sm:px-3 py-2 text-right font-medium" title="<%= status %>">
                      <span class="sm:hidden" aria-hidden="true"><%= glyph %></span><span class="sr-only sm:not-sr-only"><%= status %></span>
                    </th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @tally.criteria.each do |key, counts| %>
                  <tr>
                    <td class="px-2 sm:px-3 py-2 text-gray-800 break-words"><%= GoalCheck::CRITERIA.fetch(key, key) %></td>
                    <% GoalCheck::STATUSES.each do |status| %>
                      <td class="px-1.5 sm:px-3 py-2 text-right tabular-nums <%= counts[status].positive? ? 'text-gray-900' : 'text-gray-300' %>"><%= counts[status] %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <% [ [ "By agent root", @tally.by_agent_root ], [ "By goal", @tally.by_goal ] ].each do |heading, rows| %>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="px-3 py-2 border-b border-gray-200">
              <h2 class="text-sm font-semibold text-gray-900"><%= heading %></h2>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
                  <tr>
                    <th class="px-2 sm:px-3 py-2 text-left font-medium"><%= heading.delete_prefix("By ").capitalize %></th>
                    <th class="px-2 sm:px-3 py-2 text-right font-medium">Sessions</th>
                    <th class="px-2 sm:px-3 py-2 text-right font-medium">Met</th>
                    <th class="px-2 sm:px-3 py-2 text-right font-medium">Unmet</th>
                    <th class="px-2 sm:px-3 py-2 text-right font-medium">Pending</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% rows.each do |row| %>
                    <tr>
                      <td class="px-2 sm:px-3 py-2 text-gray-800 break-all"><%= row.key %></td>
                      <td class="px-2 sm:px-3 py-2 text-right tabular-nums"><%= row.sessions %></td>
                      <td class="px-2 sm:px-3 py-2 text-right tabular-nums text-emerald-700"><%= row.met %></td>
                      <td class="px-2 sm:px-3 py-2 text-right tabular-nums <%= row.unmet.positive? ? 'text-red-700' : 'text-gray-300' %>"><%= row.unmet %></td>
                      <td class="px-2 sm:px-3 py-2 text-right tabular-nums <%= row.pending.positive? ? 'text-yellow-700' : 'text-gray-300' %>"><%= row.pending %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>

      <p class="mt-4 text-xs text-gray-400"><%= GoalCheck::NOT_CHECKED_NOTE %></p>
    <% end %>
  </div>
</div>
