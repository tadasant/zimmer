<% content_for :title, "Outcomes" %>
<div class="min-h-screen bg-gray-50">
  <div class="max-w-[100rem] mx-auto px-3 sm:px-6 py-6">
    <%= render "page_header", title: "Outcomes", filters: @filters, current: :ledger %>

    <p class="text-sm text-gray-600 mb-4">
      Archived transcripts and what an outcome analysis said about them. Nothing is analyzed automatically —
      an analysis runs only when you click Analyze, or when an explicit API/MCP call saves one.
    </p>

    <% if @setup_warnings.any? %>
      <div class="mb-4 bg-amber-50 border border-amber-200 rounded-lg p-3">
        <h2 class="text-sm font-medium text-amber-800">Analysis sessions are not fully wired up yet</h2>
        <ul class="mt-1 text-sm text-amber-700 list-disc list-inside space-y-0.5">
          <% @setup_warnings.each do |warning| %><li><%= warning %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= render "filters", url: outcomes_path, filters: @filters,
        agent_root_options: @agent_root_options, runtime_options: @runtime_options,
        model_options: @model_options, show_analyzed_filter: true %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
      <%# Analyze All: the concurrency input, and the count it would act on. The
          count is the UNANALYZED subset of the current filters, which is what the
          batch actually enqueues — showing the filtered total here would promise
          more work than the button does. %>
      <div class="lg:col-span-2 bg-white border border-gray-200 rounded-lg p-3">
        <%= form_with url: analyze_all_outcomes_path, method: :post, data: { turbo: false }, class: "flex flex-wrap items-end gap-3" do %>
          <% @filters.to_query_params.each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>
          <div>
            <label for="concurrency" class="block text-[11px] font-medium text-gray-500 uppercase tracking-wide">Concurrent analyses</label>
            <%= number_field_tag :concurrency, params[:concurrency].presence || 3, min: OutcomeAnalysisBatch::MIN_CONCURRENCY, step: 1,
                class: "mt-1 w-28 text-sm border border-gray-300 rounded-md tabular-nums px-2 py-1" %>
          </div>
          <%= submit_tag "Analyze All (#{@counts[:unanalyzed]})",
              disabled: @counts[:unanalyzed].zero?,
              data: { turbo_confirm: "Spawn analysis sessions for #{@counts[:unanalyzed]} transcript(s)? Each one is a full agent session." },
              class: "px-3 py-1.5 text-sm font-medium rounded-md cursor-pointer #{@counts[:unanalyzed].zero? ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-indigo-600 text-white hover:bg-indigo-700'}" %>
          <p class="text-xs text-gray-500 flex-1 min-w-[16rem]">
            1 is fully sequential. Higher numbers are honored as typed — the queue below shows exactly what is in flight, and Stop halts it.
          </p>
        <% end %>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg p-3 grid grid-cols-3 gap-2 text-center">
        <div>
          <div class="text-xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@counts[:total]) %></div>
          <div class="text-[11px] text-gray-500 uppercase tracking-wide">Matching</div>
        </div>
        <div>
          <div class="text-xl font-bold text-emerald-700 tabular-nums"><%= number_with_delimiter(@counts[:analyzed]) %></div>
          <div class="text-[11px] text-gray-500 uppercase tracking-wide">Analyzed</div>
        </div>
        <div>
          <div class="text-xl font-bold text-gray-400 tabular-nums"><%= number_with_delimiter(@counts[:unanalyzed]) %></div>
          <div class="text-[11px] text-gray-500 uppercase tracking-wide">Pending</div>
        </div>
      </div>
    </div>

    <% if @batches.any? %>
      <div class="mb-4 space-y-2">
        <% @batches.each do |batch| %>
          <%= render "batch_card", batch: batch, return_params: @return_params %>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-2 sm:px-3 py-2 text-left font-medium">Session</th>
              <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Root</th>
              <th class="px-3 py-2 text-left font-medium hidden md:table-cell">Harness</th>
              <th class="px-3 py-2 text-left font-medium hidden lg:table-cell">Model</th>
              <th class="px-3 py-2 text-left font-medium hidden sm:table-cell">Created</th>
              <th class="px-2 sm:px-3 py-2 text-left font-medium">Outcome</th>
              <th class="px-2 sm:px-3 py-2 text-right font-medium hidden sm:table-cell" title="Failed segments / total segments">Failed&nbsp;/&nbsp;Segs</th>
              <th class="px-2 sm:px-3 py-2 text-right font-medium"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @rows.each do |row| %>
              <% analyzed = row.analysis_id.present? %>
              <tr class="hover:bg-gray-50">
                <td class="px-2 sm:px-3 py-2 sm:py-1.5">
                  <%= link_to session_path(row), class: "text-indigo-600 hover:text-indigo-800 font-medium" do %>#<%= row.id %><% end %>
                  <span class="text-gray-700 ml-1 truncate inline-block max-w-[8rem] sm:max-w-[16rem] xl:max-w-[22rem] align-bottom" title="<%= row.title %>"><%= row.title.presence || "(untitled)" %></span>
                </td>
                <td class="px-3 py-1.5 text-gray-600 whitespace-nowrap hidden md:table-cell"><%= row.metadata&.dig("agent_root_key") || row.agent_root_key || "—" %></td>
                <td class="px-3 py-1.5 text-gray-600 whitespace-nowrap hidden md:table-cell"><%= RuntimeRegistry.label_for(row.agent_runtime) %></td>
                <td class="px-3 py-1.5 text-gray-600 whitespace-nowrap font-mono text-xs hidden lg:table-cell"><%= row.config&.dig("model") || "—" %></td>
                <td class="px-3 py-1.5 text-gray-500 whitespace-nowrap tabular-nums text-xs hidden sm:table-cell"><%= row.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-2 sm:px-3 py-2 sm:py-1.5 whitespace-nowrap">
                  <% if analyzed %>
                    <%= render "outcome_pill", outcome: row.analysis_root_outcome %>
                  <% else %>
                    <span class="text-[11px] text-gray-400">not analyzed</span>
                  <% end %>
                </td>
                <td class="px-2 sm:px-3 py-2 sm:py-1.5 text-right tabular-nums whitespace-nowrap hidden sm:table-cell">
                  <% if analyzed %>
                    <span class="<%= row.analysis_failure_segment_count.to_i.positive? ? 'text-red-700 font-semibold' : 'text-gray-400' %>"><%= row.analysis_failure_segment_count %></span>
                    <span class="text-gray-300">/</span>
                    <span class="text-gray-600"><%= row.analysis_segment_count %></span>
                  <% else %>
                    <span class="text-gray-300">—</span>
                  <% end %>
                </td>
                <td class="px-2 sm:px-3 py-2 sm:py-1.5 text-right whitespace-nowrap">
                  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-1">
                    <% if analyzed %>
                      <%= link_to "View", outcome_path(row.id), class: "text-xs px-2 py-1 border border-gray-300 rounded hover:bg-gray-50 text-gray-700" %>
                    <% end %>
                    <%= button_to analyzed ? "Re-analyze" : "Analyze", analyze_outcome_path(row.id, @return_params),
                        method: :post,
                        form: { data: { turbo_confirm: analyzed ? "Re-analyze session ##{row.id}? The current analysis is kept but superseded." : nil } },
                        class: "text-xs px-2 py-1 rounded cursor-pointer #{analyzed ? 'border border-gray-300 text-gray-700 hover:bg-gray-50' : 'bg-indigo-600 text-white hover:bg-indigo-700'}" %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @rows.empty? %>
              <tr><td colspan="8" class="px-3 py-10 text-center text-sm text-gray-500">
                No archived sessions match these filters.
              </td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @page > 1 || @has_next_page %>
      <div class="flex items-center justify-between mt-3 text-sm">
        <div>
          <% if @page > 1 %>
            <%= link_to "← Previous", outcomes_path(@filters.to_query_params.merge(page: @page - 1)), class: "px-3 py-1.5 border border-gray-300 rounded-md bg-white hover:bg-gray-50" %>
          <% end %>
        </div>
        <span class="text-xs text-gray-500">Page <%= @page %></span>
        <div>
          <% if @has_next_page %>
            <%= link_to "Next →", outcomes_path(@filters.to_query_params.merge(page: @page + 1)), class: "px-3 py-1.5 border border-gray-300 rounded-md bg-white hover:bg-gray-50" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
