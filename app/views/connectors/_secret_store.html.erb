<%# Which secret store Zimmer is resolving ${VAR}s from.
    Locals: store (SecretProviders::ParameterStoreProvider or nil), capabilities, reason %>
<%= turbo_frame_tag "secret_store_status" do %>
  <div class="mb-6 rounded-lg border border-gray-200 bg-white px-4 py-3" data-secret-store="<%= store ? "parameter_store" : "rails_credentials" %>">
    <div class="flex items-start gap-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 <%= store ? "text-green-500" : "text-gray-400" %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
      </svg>
      <div class="min-w-0">
        <% if store %>
          <p class="text-sm font-medium text-gray-900">
            Secrets resolve from <%= SecretsLocation.parameter_store_name %>
          </p>
          <p class="mt-1 text-xs text-gray-600">
            Project <code class="font-mono"><%= store.project_id %></code> (<%= store.location %>), namespace
            <code class="font-mono"><%= store.namespace %></code>.
            Names not found there fall back to <code class="font-mono">mcp_secrets</code> in
            <code class="font-mono"><%= SecretsLocation.credentials_path %></code>.
          </p>

          <%# The credential's own permissions, probed rather than configured. %>
          <% if capabilities.nil? %>
          <% elsif !capabilities.probed? %>
            <p class="mt-2 text-xs text-orange-700" data-store-capabilities="unprobed">
              Could not confirm what this credential may do: <%= capabilities.reason %>
              Zimmer assumes nothing until the probe answers.
            </p>
          <% elsif capabilities.least_privilege? %>
            <p class="mt-2 text-xs text-green-700" data-store-capabilities="least_privilege">
              Credential holds read access to secret values and no write permission — the intended shape.
            </p>
          <% elsif capabilities.writes? %>
            <p class="mt-2 text-xs text-red-700" data-store-capabilities="over_privileged">
              This credential also holds write permissions
              (<code class="font-mono"><%= capabilities.write_permissions.join(", ") %></code>).
              Zimmer never writes to the store; narrow it to
              <code class="font-mono">roles/parametermanager.parameterViewer</code> +
              <code class="font-mono">roles/parametermanager.parameterAccessor</code> +
              <code class="font-mono">roles/secretmanager.secretAccessor</code>
              — the three <code class="font-mono">docs/operate/secrets-parameter-store</code>
              grants. Dropping <code class="font-mono">parameterAccessor</code> takes
              <code class="font-mono">parameterVersions.render</code> with it, and nothing
              resolves from the store.
            </p>
          <% else %>
            <p class="mt-2 text-xs text-red-700" data-store-capabilities="cannot_read">
              This credential cannot read secret values, so every store-backed
              <code class="font-mono">${VAR}</code> will resolve to nothing.
            </p>
          <% end %>
        <% else %>
          <p class="text-sm font-medium text-gray-900">
            Secrets resolve from <%= SecretsLocation.credentials_store_name %>
          </p>
          <p class="mt-1 text-xs text-gray-600">
            The Google Parameter Store resolver is not configured (<%= reason %>), so
            <code class="font-mono">${VAR}</code>s come from <code class="font-mono">mcp_secrets</code> in
            <code class="font-mono"><%= SecretsLocation.credentials_path %></code>, then the process environment.
            This is a supported configuration, not a fault — see
            <code class="font-mono">docs/operate/secrets-parameter-store</code> to wire the store up.
          </p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
