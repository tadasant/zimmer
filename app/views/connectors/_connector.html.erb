<%# One connector's resolved status. Rendered into the row's lazy Turbo Frame.
    Local: status (ConnectorStatusProbe::Status) %>
<%= turbo_frame_tag connector_frame_id(status.server_name) do %>
  <div class="px-4 py-4"
       data-connector="<%= status.server_name %>"
       data-connector-state="<%= status.state %>"
       data-connector-rank="<%= connector_severity_rank(status.state) %>">
    <div class="flex items-start justify-between gap-4">
      <%= render "connectors/server_identity", server: status.server %>
      <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= connector_badge_classes(status.state) %>">
        <%= status.label %>
      </span>
    </div>

    <p class="mt-2 text-sm text-gray-600"><%= status.summary %></p>

    <%# Which provider actually resolved each required ${VAR}. Not what config
        declares — what the spawn will use. %>
    <% if status.variable_sources.any? %>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1" data-secret-sources>
        <% status.variable_sources.each do |source| %>
          <span class="inline-flex items-center gap-1.5 text-xs"
                data-secret-source="<%= source.variable %>"
                data-secret-source-badge="<%= source.badge %>">
            <code class="font-mono text-gray-600"><%= source.variable %></code>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium <%= connector_source_badge_classes(source.badge) %>"
                  title="<%= source.title %>"><%= source.badge %></span>
          </span>
        <% end %>
      </div>
    <% end %>

    <% if status.missing_configuration? %>
      <div class="mt-3 rounded-md border border-red-200 bg-red-50 px-3 py-3">
        <h4 class="text-xs font-semibold uppercase tracking-wide text-red-800">Where to set <%= status.missing_variables.one? ? "this" : "these" %></h4>
        <% gateway = connector_gateway_console(status.server) %>
        <% status.instructions.each do |instruction| %>
          <div class="mt-2 text-sm text-red-900">
            <p><%= instruction[:headline] %></p>

            <%# The Secrets Console, and — the part that matters — whether it is
                THIS variable's console. When it is not, saying so is the whole
                value of the block: a value typed into a console for another GCP
                project is accepted and silently never read. %>
            <div class="mt-2 rounded-md border px-3 py-2 <%= instruction[:console_administers] ? "border-green-300 bg-green-50" : "border-amber-300 bg-amber-50" %>"
                 data-secret-console="<%= instruction[:console_administers] ? "administers" : "elsewhere" %>">
              <p class="text-xs font-medium <%= instruction[:console_administers] ? "text-green-900" : "text-amber-900" %>">
                <%= instruction[:console_caption] %>
              </p>
              <p class="mt-1">
                <%= link_to instruction[:console_url], instruction[:console_url],
                      target: "_blank", rel: "noopener",
                      data: { secret_console_link: true },
                      class: "text-xs font-mono underline #{instruction[:console_administers] ? 'text-green-800 hover:text-green-900' : 'text-amber-800 hover:text-amber-900'}" %>
              </p>
              <ol class="mt-2 list-decimal list-outside pl-4 space-y-1 text-xs <%= instruction[:console_administers] ? "text-green-900" : "text-amber-900" %>">
                <% instruction[:steps].each do |step| %>
                  <li><%= step %></li>
                <% end %>
              </ol>
            </div>

            <%# A gateway-hosted server has a SECOND credential, in the console's
                own project under its slug. That one the console really does own,
                and confusing it with the ${VAR} above is the mistake this says
                out loud. %>
            <% if gateway %>
              <p class="mt-2 text-xs text-red-800" data-gateway-console="<%= gateway[:slug] %>">
                This server is reached through <%= gateway[:host] %>, so it has a second credential:
                the one the gateway presents upstream, at
                <code class="font-mono">/strad/prod/mcp/<%= gateway[:slug] || "&lt;slug&gt;".html_safe %>/static/</code>
                in the Secrets Console. That one the console does administer — but it is not
                <code class="font-mono"><%= instruction[:variable] %></code>, which is Zimmer's own
                token for reaching the gateway. Fixing the wrong one leaves this row exactly as it is.
                And that store is a registry rather than a delivery path today: the gateway still
                resolves its credentials at deploy time, so a value saved there is recorded, not
                shipped, until the gateway is switched to runtime resolution.
              </p>
            <% end %>

            <% if instruction[:command].present? %>
              <p class="mt-2 text-xs text-red-800"><%= instruction[:command_caption] %></p>
              <div class="relative mt-1" data-controller="clipboard">
                <div class="bg-gray-900 rounded-md p-3 font-mono text-xs text-gray-100 overflow-x-auto">
                  <code><%= instruction[:command] %></code>
                </div>
                <button type="button"
                        data-action="click->clipboard#copy"
                        data-clipboard-value="<%= instruction[:command] %>"
                        class="absolute top-1.5 right-1.5 p-1 rounded text-gray-400 hover:text-white hover:bg-gray-700 transition-colors"
                        title="Copy command">
                  <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
                <span data-clipboard-target="feedback" class="hidden absolute top-1.5 right-9 text-xs text-green-400">Copied!</span>
              </div>
            <% end %>

            <% if instruction[:snippet].present? %>
              <p class="mt-2 text-xs text-red-800"><%= instruction[:snippet_caption] %></p>
              <div class="relative mt-1" data-controller="clipboard">
                <pre class="bg-gray-900 rounded-md p-3 font-mono text-xs text-gray-100 overflow-x-auto"><%= instruction[:snippet] %></pre>
                <button type="button"
                        data-action="click->clipboard#copy"
                        data-clipboard-value="<%= instruction[:snippet] %>"
                        class="absolute top-1.5 right-1.5 p-1 rounded text-gray-400 hover:text-white hover:bg-gray-700 transition-colors"
                        title="Copy snippet">
                  <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
                <span data-clipboard-target="feedback" class="hidden absolute top-1.5 right-9 text-xs text-green-400">Copied!</span>
              </div>
            <% end %>

            <p class="mt-2 text-xs text-red-700"><%= instruction[:followup] %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Start the OAuth flow right here. The flow carries no session — it returns
        to /connectors and resumes nothing — so authorizing a connector costs the
        user no session at all. Turbo is off because initiate redirects off-site
        to the provider's consent screen. %>
    <% if status.authorizable? %>
      <%= form_with url: mcp_oauth_initiate_path, method: :post, data: { turbo: false }, class: "mt-3" do |f| %>
        <%= f.hidden_field :server_name, value: status.server_name %>
        <%= f.submit status.state == :needs_reauth ? "Re-authorize" : "Authorize",
              data: { connector_authorize: status.server_name },
              class: "inline-flex items-center px-2.5 py-1 border border-amber-600 text-xs font-medium rounded-md text-amber-700 bg-white hover:bg-amber-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 cursor-pointer" %>
      <% end %>
    <% end %>

    <% if status.credential.present? %>
      <div class="mt-3 flex items-center justify-between gap-3">
        <p class="text-xs text-gray-500">
          Authorized <%= time_ago_in_words(status.credential.created_at) %> ago<%= " · refresh token stored" if status.credential.refresh_token.present? %>
        </p>
        <%= button_to mcp_oauth_credential_path(status.credential),
              method: :delete,
              form: { data: { turbo_frame: "_top", turbo_confirm: "Delete the OAuth credential for #{status.server_name}? The next session using it will have to authorize again." } },
              class: "shrink-0 inline-flex items-center px-2.5 py-1 border border-red-300 text-xs font-medium rounded-md text-red-700 bg-white hover:bg-red-50" do %>
          Disconnect
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
