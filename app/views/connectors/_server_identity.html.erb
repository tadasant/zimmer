<%# Name, transport and endpoint for one catalog MCP server. Shared by the
    loading placeholder and the resolved row so a frame swap doesn't shift the
    layout. Local: server (ServersConfig::Server) %>
<div class="min-w-0">
  <div class="flex items-center gap-2">
    <h3 class="text-sm font-semibold text-gray-900 truncate"><%= server.title %></h3>
    <span class="text-xs font-mono text-gray-400 truncate"><%= server.name %></span>
  </div>
  <p class="mt-0.5 text-xs text-gray-500 truncate" title="<%= server.description %>"><%= server.description %></p>
  <p class="mt-1 text-xs text-gray-400 font-mono truncate" title="<%= server.remote? ? server.url : [server.command, *server.args].join(" ") %>">
    <%= server.type %> · <%= server.remote? ? server.url : [ server.command, *server.args ].join(" ") %>
  </p>
</div>
