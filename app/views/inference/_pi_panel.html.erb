<%# The Pi tab. Pi pools no accounts (see PiAuthProvider) — it resolves a
    provider credential per request — so this tab manages that credential
    instead of a pool.

    Locals: status (ManagedSecret::Status). The status object carries no secret
    value; there is deliberately nothing on this page that renders one. %>
<div class="space-y-6" id="pi_panel">
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 sm:p-6">
    <div class="sm:flex sm:items-start sm:justify-between gap-4">
      <div class="min-w-0">
        <h2 class="text-lg font-medium text-gray-900">OpenRouter API key</h2>
        <p class="mt-1 text-sm text-gray-600">
          Pi authenticates per request from a provider key in the session environment. OpenRouter is
          the provider Zimmer feeds it: one key reaches every <code class="font-mono">openrouter/*</code>
          model in <%= link_to "the model catalog", inference_path(runtime: PiAuthProvider::RUNTIME), class: "text-indigo-600 hover:text-indigo-500" %>
          without a per-vendor key each.
        </p>
      </div>
      <div class="mt-3 sm:mt-0 shrink-0">
        <% if status.present? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800" data-openrouter-key-state="set">Set</span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700" data-openrouter-key-state="unset">Not set</span>
        <% end %>
      </div>
    </div>

    <%# What is known about the value, which is everything except the value. %>
    <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Variable</dt>
        <dd class="mt-0.5 font-mono text-gray-900 break-all"><%= status.variable %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Resolves from</dt>
        <dd class="mt-0.5 text-gray-900">
          <% if status.present? %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700" title="<%= status.provider_label %>"><%= status.provider_badge %></span>
          <% else %>
            <span class="text-gray-400">—</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">
          Fingerprint
          <span class="normal-case font-normal text-gray-400" title="Truncated SHA-256 of the value. Not the value and not part of it — hash your own copy to compare.">(SHA-256)</span>
        </dt>
        <dd class="mt-0.5 font-mono text-gray-900" data-openrouter-fingerprint><%= status.fingerprint || content_tag(:span, "—", class: "text-gray-400") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Last set from this page</dt>
        <dd class="mt-0.5 text-gray-900">
          <% if status.last_write %>
            <span title="<%= status.last_write.created_at.iso8601 %>"><%= time_ago_in_words(status.last_write.created_at) %> ago (<%= status.last_write.action %>)</span>
          <% else %>
            <span class="text-gray-400">never</span>
          <% end %>
        </dd>
      </div>
      <% if status.path %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Address</dt>
          <dd class="mt-0.5 font-mono text-xs text-gray-600 break-all">
            <%= status.path %> in <%= status.project_id %> (<%= status.location %>)
          </dd>
        </div>
      <% end %>
    </dl>

    <p class="mt-4 text-xs text-gray-500">
      This page can set and delete the key. It cannot show it: nothing here, and no endpoint behind it,
      returns the stored value — see <code class="font-mono">ManagedSecret</code>. To replace a key you
      have lost, paste a new one.
    </p>
  </div>

  <%# The write path, or an honest account of why there isn't one. %>
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 sm:p-6">
    <% if status.writable? %>
      <h3 class="text-base font-medium text-gray-900"><%= status.present? ? "Replace the key" : "Set the key" %></h3>
      <%= form_with url: openrouter_key_inference_path, method: :put, class: "mt-3 space-y-3" do |form| %>
        <div>
          <%= form.label :openrouter_api_key, "OpenRouter API key", class: "block text-sm font-medium text-gray-700" %>
          <%# autocomplete off and a password field: the browser must not offer to
              remember, autofill or reveal a value this page never reads back. %>
          <%= form.password_field :openrouter_api_key, autocomplete: "off", spellcheck: "false",
              placeholder: "sk-or-v1-...",
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm font-mono text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          <p class="mt-1 text-xs text-gray-500">
            Written to <%= SecretsLocation.parameter_store_name %>, then read back through Zimmer's ordinary
            resolution chain before this reports success — a write that cannot be read back is reported as a
            failure, not as a save.
          </p>
        </div>
        <%= form.submit status.present? ? "Replace key" : "Save key",
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
      <% end %>

      <% if status.present? && status.deletable? %>
        <div class="mt-6 pt-4 border-t border-gray-200">
          <%= button_to "Delete key", destroy_openrouter_key_inference_path, method: :delete,
              form: { data: { turbo_confirm: "Delete #{status.variable} from the store? Sessions on OpenRouter models stop working until a new key is set." } },
              class: "inline-flex items-center px-3 py-2 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
        </div>
      <% elsif status.present? %>
        <p class="mt-6 pt-4 border-t border-gray-200 text-xs text-orange-700">
          Delete is unavailable: this credential can write the key but not remove it.
        </p>
      <% end %>
    <% else %>
      <h3 class="text-base font-medium text-gray-900">Zimmer cannot write to the store yet</h3>
      <p class="mt-2 text-sm text-gray-600" data-openrouter-write-blocked>
        <%= status.write_reason %>.
      </p>
      <p class="mt-2 text-sm text-gray-600">
        Zimmer's Parameter Store identity is created read-only on purpose — it reads secret values and
        writes nothing — so this form stays closed until a credential that may write exists. The
        recommended shape is a <span class="font-medium">separate writer service account</span> on
        <code class="font-mono break-all"><%= status.project_id || "the store's project" %></code>, handed to Zimmer as
        <code class="font-mono break-all">ZIMMER_PARAMS_WRITER_SERVICE_ACCOUNT_KEY_JSON</code>, rather than widening the
        resolver whose key is baked into the image and reaches every session's resolution path.
      </p>
      <% if status.missing_permissions.any? %>
        <p class="mt-2 text-sm text-gray-600">The exact permissions it is missing:</p>
        <ul class="mt-1 list-disc list-inside text-xs font-mono text-gray-700 space-y-0.5 break-all">
          <% status.missing_permissions.each do |permission| %>
            <li><%= permission %></li>
          <% end %>
        </ul>
      <% end %>
      <p class="mt-3 text-xs text-gray-500">
        Until then the key can be placed by a human with the admin identity, exactly as every other Zimmer
        secret is — <code class="font-mono break-all">docs/operate/secrets-parameter-store</code>, "Adding a secret".
        A key set that way shows up here as Set, with its fingerprint, on the next page load.
      </p>
    <% end %>
  </div>

  <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 sm:p-6">
    <h3 class="text-base font-medium text-gray-900">Models this key drives</h3>
    <p class="mt-1 text-sm text-gray-600">
      Every Pi model Zimmer offers is an <code class="font-mono">openrouter/*</code> id, resolved by the
      pinned Pi's own catalog. Raw <code class="font-mono">ANTHROPIC_API_KEY</code> /
      <code class="font-mono">OPENAI_API_KEY</code> still work if either is set — they are simply not
      what this deployment is set up for.
    </p>
    <ul class="mt-3 space-y-1 text-sm">
      <% ModelCatalog.models_for(PiAuthProvider::RUNTIME).each do |model| %>
        <li class="font-mono text-xs text-gray-700 break-all"><%= model[:id] %></li>
      <% end %>
    </ul>
  </div>
</div>
