<%# Proactive rebalancing: whether the idle pool is about to move to a better
    account, and if not, what is holding it. Read from AccountRebalanceService.plan
    — the same decision AccountRebalanceJob acts on every five minutes — so the
    sentence and the sweep cannot disagree. %>
<div id="account-rebalance" class="bg-white shadow-sm rounded-lg border border-gray-200 px-4 py-3 sm:px-6">
  <div class="flex flex-wrap items-center gap-2">
    <h3 class="text-sm font-medium text-gray-900">Rebalancing</h3>
    <% if plan.due? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">due</span>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= plan.state.to_s.humanize.downcase %></span>
    <% end %>
  </div>
  <p class="mt-1 text-sm text-gray-700 break-words" id="account-rebalance-sentence"><%= rebalance_sentence(plan) %></p>
  <% if plan.ranking.any? %>
    <p class="mt-1 text-xs text-gray-500 break-words" id="account-rebalance-ranking">
      Scores (higher is better):
      <%= safe_join(plan.ranking.map { |score|
            tag.span("#{score.account.email} #{rebalance_score(score.value)}",
              class: (score.account == plan.current ? "font-medium text-gray-700" : nil),
              title: score.ineligible_reason)
          }, " · ") %>
    </p>
  <% end %>
  <p class="mt-1 text-xs text-gray-400">
    Score = 0.8 × weekly headroom + 0.2 × 5-hour headroom, where usage due back within 24h (weekly) or 5h
    counts partly as headroom. Priorities are re-ranked by this score on every quota wall.
  </p>
</div>
