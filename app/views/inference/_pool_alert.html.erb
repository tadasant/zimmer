<%# The dry-pool banner: when nothing in this runtime's pool can serve a session,
    say so at the top of the page rather than leaving the operator to work it out
    from a grid that reads "1 Active". See InferenceHelper#dry_pool and issue #239.

    Always rendered (empty when the pool can serve) so a Turbo Stream refresh has
    a stable target to replace. %>
<div id="pool_alert">
  <% alert = dry_pool(runtime, accounts, snapshots) %>
  <% if alert %>
    <div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4" role="alert">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 flex-shrink-0 text-red-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <div class="min-w-0">
          <h2 class="text-sm font-semibold text-red-800">
            No <%= RuntimeRegistry.label_for(runtime) %> account can serve a session
          </h2>
          <p class="mt-1 text-sm text-red-700">
            All <%= pluralize(accounts.size, "account") %> in this pool are unusable: <%= alert.breakdown %>.
          </p>
          <p class="mt-1 text-sm text-red-700"><%= alert.recovery %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
