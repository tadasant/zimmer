<%# The conversation's scratchpad, read-only: the notes its assistant is shown
    on every turn (LiveConversations::Scratchpad). Broadcast-replaced on every
    write, from whichever surface made it, so it holds no forms — a form
    rendered outside a request carries an authenticity token no browser session
    will accept. Editing is on its own page.

    Locals: conversation %>
<% entries = conversation.scratchpad_entries.to_a %>
<details id="<%= conversation.scratchpad_dom_id %>" data-live-scratchpad class="mt-3 bg-white shadow-sm rounded-lg border border-gray-200">
  <summary class="cursor-pointer select-none px-4 py-2.5 flex items-center justify-between gap-2 text-sm">
    <span class="font-medium text-gray-900">Scratchpad</span>
    <span class="text-xs text-gray-500" data-live-scratchpad-count><%= entries.size %> of <%= LiveConversations::Scratchpad::MAX_ENTRIES %> notes</span>
  </summary>
  <div class="px-4 pb-3 border-t border-gray-100">
    <p class="mt-2 text-xs text-gray-500">Notes Live Mode keeps for this conversation and reads before every answer — what not to bring up again, what is settled.</p>
    <% if entries.empty? %>
      <p class="mt-2 text-sm text-gray-400">No notes yet.</p>
    <% else %>
      <ul class="mt-2 space-y-1.5">
        <% entries.each do |entry| %>
          <li class="text-sm text-gray-800 break-words" data-live-scratchpad-entry="<%= entry.id %>">
            <%= entry.body %>
            <span class="text-xs text-gray-400 whitespace-nowrap">— <%= entry.writer_label %>, <%= entry.updated_at.in_time_zone.strftime("%b %-d %H:%M") %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= link_to "Edit notes", live_conversation_scratchpad_entries_path(conversation), class: "mt-2 inline-block text-sm text-indigo-700 hover:text-indigo-900 underline", data: { turbo_frame: "_top" } %>
  </div>
</details>
