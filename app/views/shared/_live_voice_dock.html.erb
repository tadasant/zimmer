<%# The Live Mode voice call dock. In the layout and data-turbo-permanent so the call
    (live_voice_controller.js) survives navigation; hidden until a conversation
    page's Talk button starts a call. Bottom-left, clear of the Quick Router
    bubble in the bottom-right. %>
<div data-controller="live-voice" data-turbo-permanent id="live-voice-dock">
  <div data-live-voice-target="panel"
       class="hidden fixed bottom-4 left-4 z-[64] w-72 max-w-[calc(100vw-6rem)] rounded-xl shadow-2xl border border-gray-200 bg-white px-4 py-3">
    <div class="flex items-center justify-between gap-2">
      <a data-live-voice-target="link" href="#" class="flex items-center gap-2 min-w-0">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
        </span>
        <span class="text-sm font-semibold text-gray-900 truncate">Voice</span>
        <span data-live-voice-target="status" class="text-xs text-gray-500 truncate">Connecting…</span>
      </a>
      <button type="button" data-action="live-voice#dismiss" class="p-1 text-gray-400 hover:text-gray-600" aria-label="Dismiss">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <p data-live-voice-target="error" class="hidden mt-2 text-xs text-red-700 break-words"></p>
    <div class="mt-3 flex items-center gap-2">
      <button type="button" data-live-voice-target="mute" data-action="live-voice#toggleMute" aria-pressed="false"
              class="flex-1 inline-flex justify-center items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Mute</button>
      <button type="button" data-action="live-voice#hangUp"
              class="flex-1 inline-flex justify-center items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700">Hang up</button>
    </div>
  </div>
</div>
