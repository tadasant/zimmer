<%# A row linking to /live/settings, with what is in force now. Locals: none %>
<% setting = LiveSetting.current %>
<%= link_to live_settings_path, class: "block bg-white shadow-sm rounded-lg border border-gray-200 p-4 hover:bg-gray-50", data: { live_settings_link: true } do %>
  <div class="flex items-center gap-3">
    <span class="text-indigo-600 shrink-0"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg></span>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-gray-900">Live settings</p>
      <p class="text-xs text-gray-500 break-words">
        <code class="font-mono"><%= setting.effective(:text_model) %></code> ·
        <code class="font-mono"><%= setting.effective(:voice_model) %></code> ·
        <%= setting.effective(:voice_name) %> at <%= setting.effective(:voice_speed) %>× ·
        guidance <%= setting.guidance_text.empty? ? "empty" : "#{setting.guidance_text.length} characters" %>
      </p>
    </div>
    <span class="text-gray-400" aria-hidden="true">›</span>
  </div>
<% end %>
