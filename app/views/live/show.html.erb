<% availability = @availability %>
<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%= render "live/back_header", title: LiveConversations::LABEL, back_path: root_path, subtitle: LiveConversations::TAGLINE %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 sm:p-6 mb-6" data-live-start>
      <% if availability.available? %>
        <div class="flex items-center gap-3">
          <%= render "live/mode_icon", mode: LiveConversations.mode("text"), css: "h-8 w-8 text-indigo-600 shrink-0" %>
          <p class="text-sm text-gray-700">
            A new conversation reads <code class="font-mono"><%= LiveConversations::AGENT_ROOT %></code>'s AGENTS.md as its
            instructions. Type to <code class="font-mono break-all"><%= LiveConversations.mode("text").model %></code>, or turn
            voice on and talk to <code class="font-mono break-all"><%= LiveConversations.mode("voice").model %></code>.
          </p>
        </div>
        <%= button_to live_conversations_path, method: :post,
            form: { class: "mt-4" },
            class: "w-full sm:w-auto inline-flex justify-center items-center px-5 py-2.5 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" do %>
          Start a new conversation
        <% end %>
      <% else %>
        <h2 class="text-base font-medium text-gray-900"><%= LiveConversations::LABEL %> is off</h2>
        <ul class="mt-2 list-disc list-inside space-y-1 text-sm text-gray-700" data-live-unavailable>
          <% availability.reasons.each do |reason| %>
            <li><%= reason %></li>
          <% end %>
        </ul>
        <% unless availability.key_configured? %>
          <%= link_to "Set the OpenAI key", live_path(anchor: "live-openai-key"), class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
        <% end %>
      <% end %>
    </div>

    <div class="mb-6"><%= render "live/settings_link" %></div>

    <%= render "live/recent", conversations: @recent %>
  </div>
</div>
