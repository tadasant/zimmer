<%# Locals: title, back_path, subtitle (optional) %>
<div class="mb-6">
  <div class="flex items-center">
    <%= link_to back_path, class: "text-gray-500 hover:text-gray-700 mr-4", "aria-label" => "Back" do %>
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 min-w-0 break-words"><%= title %></h1>
  </div>
  <% if local_assigns[:subtitle].present? %>
    <p class="mt-2 text-sm text-gray-600"><%= subtitle %></p>
  <% end %>
</div>
