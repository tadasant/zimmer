<%# The approval round-trip that ended without a human answer.

    Renders as an empty slot when there is nothing to say, so the same partial
    both raises and dismisses the banner over Turbo Streams. %>
<div id="session_<%= session.id %>_lost_elicitation">
  <% lost = session.lost_elicitation %>
  <% if lost.present? %>
    <div class="bg-orange-50 border border-orange-300 rounded-lg shadow-sm px-4 py-3">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0 mt-0.5">
          <svg class="h-5 w-5 text-orange-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.5 2.5a1 1 0 001.414-1.414L11 9.586V6z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-semibold text-orange-900 mb-1">
            <%= lost["reason"] == "expired" ? "Approval request expired" : "Approval request lost" %>
          </h3>
          <p class="text-sm text-orange-800 break-words">
            <% if lost["reason"] == "expired" %>
              Nobody answered before the request timed out. The MCP server was told
              <span class="font-mono text-xs">expired</span>, so the agent continued without approval.
            <% else %>
              The round-trip never completed — the MCP server stopped waiting, or its response was lost.
              This session is not blocked on it any more; reply below to tell the agent how to proceed.
            <% end %>
          </p>
          <% if lost["summary"].present? %>
            <p class="text-xs text-orange-700 mt-1 italic break-words">
              Requested: <%= truncate(lost["summary"], length: 200) %>
            </p>
          <% end %>
          <% if session.lost_elicitation_at %>
            <p class="text-xs text-orange-600 mt-1">
              <%= session.lost_elicitation_at.strftime("%b %-d, %-I:%M %p") %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
