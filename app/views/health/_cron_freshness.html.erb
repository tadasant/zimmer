<%# Whether every scheduled cron key is still producing jobs on its own cadence. %>
<%#
  A singleton sweep whose `perform` hangs stops every later tick for its class and
  leaves the backlog flat, so nothing else on this page moves when one stops
  (tadasant/zimmer#619). Same object as the REST health report and
  `get_system_health`; CronFreshness has the rule. Served by the web process, so it
  still answers when the worker's cron manager is what stopped.
%>
<% cron = health_report[:cron_health] %>
<% behind = cron[:keys].reject { |r| r[:state] == :fresh } %>
<div class="mt-6 bg-white rounded-lg shadow">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h3 class="text-lg font-medium text-gray-900">Cron Freshness</h3>
        <p class="mt-1 text-sm text-gray-500">
          Whether each job in <code class="font-mono text-xs">config/cron_schedule.rb</code> is still being
          enqueued, judged against its own cadence.
        </p>
      </div>
      <div class="sm:flex-shrink-0">
        <%= status_badge(cron[:status]) %>
      </div>
    </div>
  </div>

  <div class="px-4 py-5 sm:p-6">
    <dl class="grid grid-cols-2 gap-4 mb-4 sm:grid-cols-4">
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">On schedule</dt>
        <dd class="mt-1 text-2xl font-semibold text-green-600"><%= cron[:counts][:fresh] %></dd>
      </div>
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">Stale</dt>
        <dd class="mt-1 text-2xl font-semibold <%= cron[:counts][:stale] > 0 ? 'text-red-600' : 'text-gray-900' %>">
          <%= cron[:counts][:stale] %>
        </dd>
      </div>
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">Behind</dt>
        <dd class="mt-1 text-2xl font-semibold <%= cron[:counts][:overdue] > 0 ? 'text-yellow-600' : 'text-gray-900' %>">
          <%= cron[:counts][:overdue] %>
        </dd>
      </div>
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">Not judged</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= cron[:counts][:disabled] + cron[:counts][:exempt] %></dd>
      </div>
    </dl>

    <p class="text-sm text-gray-700 break-words"><%= cron[:status].message %></p>
    <% if cron[:cron_running_since] %>
      <p class="mt-1 text-xs text-gray-500">
        Newest cron-running worker started <%= time_ago_in_words(cron[:cron_running_since]) %> ago.
        A tick counts against a key only if other keys' rows show the cron manager fired it.
      </p>
    <% end %>

    <% if behind.any? %>
      <ul class="mt-4 divide-y divide-gray-100 border-t border-gray-100">
        <% behind.each do |reading| %>
          <li class="py-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-sm font-medium text-gray-900 break-all"><%= reading[:key] %></span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= cron_freshness_state_class(reading[:state]) %>">
                <%= reading[:state] %>
              </span>
            </div>
            <div class="mt-1 text-xs text-gray-500 break-words">
              <%= reading[:job_class] %> · <code class="font-mono"><%= reading[:cron] %></code>
            </div>
            <% if reading[:reason] %>
              <p class="mt-1 text-sm text-gray-700 break-words"><%= reading[:reason] %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if cron[:keys].any? %>
      <details class="mt-4">
        <summary class="cursor-pointer text-sm font-medium text-indigo-600 hover:text-indigo-800">
          Every key (<%= cron[:keys].size %>)
        </summary>
        <div class="mt-3 overflow-x-auto -mx-4 sm:mx-0">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead>
              <tr class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <th class="px-4 py-2">Key</th>
                <th class="px-4 py-2">Schedule</th>
                <th class="px-4 py-2">Last enqueued</th>
                <th class="px-4 py-2">State</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% cron[:keys].each do |reading| %>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-gray-900"><%= reading[:key] %></td>
                  <td class="px-4 py-2 font-mono text-xs text-gray-600 whitespace-nowrap"><%= reading[:cron] %></td>
                  <td class="px-4 py-2 text-gray-600 whitespace-nowrap">
                    <%= reading[:last_enqueued_at] ? "#{time_ago_in_words(reading[:last_enqueued_at])} ago" : "never" %>
                  </td>
                  <td class="px-4 py-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= cron_freshness_state_class(reading[:state]) %>">
                      <%= reading[:state] %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </details>
    <% end %>
  </div>
</div>
