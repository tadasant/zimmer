<%# Webhook ingest: whether each source is delivering, and which path fired its triggers. %>
<%#
  The summary of webhook_deliveries and trigger_event_claims, which /supervisor lists row by row.
  Same object as the REST health report and `get_system_health`. The number that matters is
  "claimed via poll" while a webhook is on: each one is an event the webhook did not deliver first.
  Stacked per source rather than a table, so it fits a phone.
%>
<% inbound = health_report[:inbound_event_health] %>
<div class="mt-6 bg-white rounded-lg shadow">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h3 class="text-lg font-medium text-gray-900">Webhook Ingest</h3>
        <p class="mt-1 text-sm text-gray-500">
          Deliveries per source, and trigger events by the path that claimed them, over the last
          <%= inbound[:window_seconds] / 3600 %> hours.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:flex-shrink-0">
        <%= status_badge(inbound[:status]) %>
        <%# No hover-prefetch: /supervisor 401s with a Basic challenge. See _post_deploy_tasks. %>
        <%= link_to "Deliveries", supervisor_webhook_deliveries_path,
              data: { turbo_prefetch: false },
              class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= link_to "Claims", supervisor_trigger_event_claims_path,
              data: { turbo_prefetch: false },
              class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      </div>
    </div>
  </div>

  <div class="px-4 py-5 sm:p-6 space-y-6">
    <% inbound[:sources].each do |source| %>
      <div>
        <h4 class="text-sm font-semibold text-gray-900">
          <%= source[:name].capitalize %>
          <span class="ml-2 font-mono text-xs font-normal text-gray-500 break-all"><%= source[:mode] %></span>
        </h4>
        <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div class="text-center">
            <dt class="text-sm font-medium text-gray-500">Last delivery</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= source[:last_delivery_at] ? "#{HealthMonitorService.format_wait(Time.current - source[:last_delivery_at])} ago" : "—" %>
            </dd>
          </div>
          <div class="text-center">
            <dt class="text-sm font-medium text-gray-500">Deliveries</dt>
            <dd class="mt-1 text-2xl font-semibold <%= source[:accepting] && source[:deliveries_in_window].zero? ? 'text-yellow-600' : 'text-gray-900' %>">
              <%= source[:deliveries_in_window] %>
            </dd>
          </div>
          <div class="text-center">
            <dt class="text-sm font-medium text-gray-500">Claimed via webhook</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= source[:webhook_claims_in_window] %></dd>
          </div>
          <div class="text-center">
            <dt class="text-sm font-medium text-gray-500">Claimed via poll</dt>
            <dd class="mt-1 text-2xl font-semibold <%= source[:webhook_enabled] && source[:poll_claims_in_window] > 0 ? 'text-yellow-600' : 'text-gray-900' %>">
              <%= source[:poll_claims_in_window] %>
            </dd>
          </div>
        </dl>
      </div>
    <% end %>

    <p class="text-sm text-gray-500"><%= inbound[:status].message %></p>
  </div>
</div>
