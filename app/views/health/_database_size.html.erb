<%# How big the database is, what makes it that big, and how far transcript retention has got. %>
<%#
  Production's managed Postgres ran low on disk while nothing here measured the
  table that was growing (session_transcript_chunks). Same object as the REST
  health report and `get_system_health`, so the number is reachable from a phone.
%>
<% database = health_report[:database_size_health] %>
<% if database %>
<% offload = database[:transcript_retention] %>
<div class="mt-6 bg-white rounded-lg shadow">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h3 class="text-lg font-medium text-gray-900">Database Size</h3>
        <p class="mt-1 text-sm text-gray-500">
          Total size and the largest tables. Warns past
          <%= number_to_human_size(database[:warning_bytes]) %>
          (<code class="font-mono text-xs">DATABASE_SIZE_WARNING_GIB</code>).
        </p>
      </div>
      <div class="sm:flex-shrink-0">
        <%= status_badge(database[:status]) %>
      </div>
    </div>
  </div>

  <div class="px-4 py-5 sm:p-6">
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">Total size</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= number_to_human_size(database[:total_bytes]) %></dd>
      </div>
      <% if offload %>
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-500">Transcripts kept</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= offload[:retention_days] %> days</dd>
        </div>
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-500">Offloaded</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= number_with_delimiter(offload[:offloaded_sessions]) %></dd>
        </div>
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-500">Awaiting offload</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= number_with_delimiter(offload[:awaiting_offload]) %></dd>
        </div>
      <% end %>
    </dl>

    <% if database[:largest_tables].present? %>
      <ul class="mt-4 divide-y divide-gray-100 text-sm">
        <% database[:largest_tables].each do |table| %>
          <li class="flex items-baseline justify-between gap-3 py-1.5">
            <code class="min-w-0 truncate font-mono text-xs text-gray-700"><%= table[:name] %></code>
            <span class="flex-shrink-0 text-gray-900"><%= number_to_human_size(table[:total_bytes]) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="mt-4 text-sm text-gray-500"><%= database[:status].message %></p>
  </div>
</div>
<% end %>
