<%# How big the database is, how much of it is in use, and what makes it that big. %>
<%#
  Same object as the REST health report and `get_system_health`, so the number is
  reachable from a phone. Production has no shell on the database host.
%>
<% database = health_report[:database_size_health] %>
<% if database %>
<div class="mt-6 bg-white rounded-lg shadow">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h3 class="text-lg font-medium text-gray-900">Database Size</h3>
        <p class="mt-1 text-sm text-gray-500">
          Deleting rows frees space for reuse without shrinking the files, so the space in use is an
          estimate beside the size on disk.
          <% if database[:capacity_bytes] %>
            Warns at <%= (HealthMonitorService::DATABASE_IN_USE_WARNING_SHARE * 100).floor %>% in use or
            <%= (HealthMonitorService::DATABASE_ON_DISK_WARNING_SHARE * 100).floor %>% on disk, of <%= number_to_human_size(database[:capacity_bytes]) %>.
          <% else %>
            Set <code class="font-mono text-xs">DATABASE_CAPACITY_GIB</code> to warn on it.
          <% end %>
        </p>
      </div>
      <div class="sm:flex-shrink-0">
        <%= status_badge(database[:status]) %>
      </div>
    </div>
  </div>

  <div class="px-4 py-5 sm:p-6">
    <dl class="grid grid-cols-2 gap-4">
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">On disk</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= database[:total_bytes] ? number_to_human_size(database[:total_bytes]) : "—" %></dd>
      </div>
      <div class="text-center">
        <dt class="text-sm font-medium text-gray-500">In use (est.)</dt>
        <dd class="mt-1 text-2xl font-semibold text-gray-900 break-words"><%= database[:in_use_bytes] ? number_to_human_size(database[:in_use_bytes]) : "—" %></dd>
      </div>
    </dl>

    <% if database[:largest_tables].present? %>
      <ul class="mt-4 divide-y divide-gray-100 text-sm">
        <% database[:largest_tables].each do |table| %>
          <li class="flex flex-wrap items-baseline justify-between gap-x-3 py-1.5">
            <code class="min-w-0 break-all font-mono text-xs text-gray-700"><%= table[:name] %></code>
            <span class="flex-shrink-0 text-gray-900">
              <%= number_to_human_size(table[:total_bytes]) %>
              <% if table[:reusable_bytes].to_i.positive? %>
                <span class="text-gray-500">(<%= number_to_human_size(table[:reusable_bytes]) %> reusable)</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="mt-4 text-sm text-gray-500"><%= database[:status].message %></p>
  </div>
</div>
<% end %>
