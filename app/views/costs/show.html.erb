<div id="costs-page" class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center mb-4">
        <%= link_to root_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Costs</h1>
      </div>
      <p class="text-sm text-gray-600">
        Token spend from Zimmer's own ledger, priced at current list rates.
        <span class="text-gray-500">Volumes are stored; prices are applied on read, so this re-prices itself when rates change.
        Claude Code spend is subscription-billed and priced at Anthropic list; Pi spend is metered by OpenRouter and priced at
        the rates it publishes; Codex spend is subscription-billed too, and its tokens land here with <em>no</em> dollars, because
        no OpenAI rate is carried yet. See <span class="font-medium">By runtime</span> below for the split, and
        <span class="font-medium">Unpriced models</span> for the volume that carries no cost.</span>
      </p>
    </div>

    <%= render "window_picker", window: @window, scope: @scope %>

    <%# The drilldown's own statement of what it is. Without it a narrowed page
        is indistinguishable from a fleet page on a quiet day — same headings,
        same tables, an order of magnitude less money and nothing saying why. %>
    <% unless @scope.fleet? %>
      <div class="mb-6 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-indigo-900 break-all">
              <% if @scope.agent_root? %>
                Agent root <span class="font-mono"><%= @scope.agent_root %></span>
              <% elsif @scoped_session %>
                <%= link_to "Session ##{@scope.session_id} — #{@scoped_session.title}",
                      session_path(@scoped_session), class: "underline decoration-indigo-300 hover:decoration-indigo-500" %>
              <% else %>
                <%# Spend outlives its session: SessionTokenUsage nullifies rather
                    than cascading, so a deleted session still has rows here. Linking
                    to it would be a link to a 404. %>
                Session #<%= @scope.session_id %> <span class="font-normal text-indigo-700">(deleted)</span>
              <% end %>
            </p>
            <p class="text-xs text-indigo-800 mt-0.5">
              Every figure below covers this <%= @scope.agent_root? ? "agent root" : "session" %> only, over
              <%= @window.label %>.
              <% if @scope.agent_root? %>
                Ad hoc calls are Zimmer's own inference, made outside any session, so they carry no agent root and are excluded.
              <% else %>
                Ad hoc calls made <em>about</em> this session — its generated title, its push summaries — are included.
              <% end %>
            </p>
          </div>
          <%= link_to costs_path(@window.to_params), class: "shrink-0 inline-flex items-center px-3 py-1.5 border border-indigo-300 text-xs font-medium rounded-md text-indigo-700 bg-white hover:bg-indigo-50" do %>
            All agent roots
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Ledger coverage: how much history is actually in here -->
    <%# Branch on the LATEST run's status, not on `complete`. The two differ while
        a re-scan of an already-swept corpus is in flight, and pairing the finished
        run's timestamp with the running one's counters is how a page ends up
        saying "swept 3 hours ago" over a progress figure that is still moving. %>
    <% swept = @coverage[:status] == "complete" %>
    <% tone = swept ? "bg-white border-gray-200" : "bg-amber-50 border-amber-200" %>
    <div class="mb-6 rounded-lg border <%= tone %> px-4 py-3">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-sm font-semibold <%= swept ? "text-gray-900" : "text-amber-900" %>">
            <% if swept %>
              History backfilled
            <% elsif @coverage[:status] == "running" %>
              <%= @coverage[:complete] ? "Re-scanning history" : "Backfilling history" %><%= " — #{@coverage[:progress_pct]}%" if @coverage[:progress_pct] %>
            <% elsif @coverage[:status] == "queued" %>
              History sweep queued
            <% else %>
              History not backfilled yet
            <% end %>
          </p>
          <p class="text-xs <%= swept ? "text-gray-500" : "text-amber-800" %> mt-0.5">
            <% if @coverage[:covers_since] %>
              Ledger covers <%= @coverage[:covers_since].strftime("%b %-d, %Y") %> onward.
            <% else %>
              Nothing recorded yet.
            <% end %>
            <% if swept %>
              Swept <%= time_ago_in_words(@coverage[:finished_at]) %> ago<%= " (#{number_with_delimiter(@coverage[:files_scanned])} files)" if @coverage[:files_scanned].to_i.positive? %>.
            <% elsif @coverage[:status] == "running" && @coverage[:directories_total].to_i.positive? %>
              <%= number_with_delimiter(@coverage[:directories_done]) %> of <%= number_with_delimiter(@coverage[:directories_total]) %>
              transcript directories swept; figures below grow as it runs. It runs itself — no action needed.
            <% elsif @coverage[:status] == "running" %>
              Reading the transcript corpus now. It runs itself — no action needed.
            <% else %>
              Older spend is missing until the sweep runs. It starts on its own within five minutes.
            <% end %>
          </p>
          <% if @coverage[:last_error].present? %>
            <%# A stored error is usually a class name and a file path — one unbroken
                token that would set this container's width on a phone. %>
            <p class="text-xs text-red-700 mt-1 break-all">Last error: <%= @coverage[:last_error] %></p>
          <% end %>
        </div>
        <%= button_to costs_backfill_path(@window.to_params.merge(@scope.to_params)), method: :post,
            class: "shrink-0 inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
          <%= swept ? "Re-scan history" : "Sweep now" %>
        <% end %>
      </div>
    </div>

    <% if @totals[:api_calls].zero? %>
      <div class="bg-white shadow rounded-lg px-4 py-8 text-center">
        <p class="text-sm text-gray-700 font-medium">
          No usage recorded <%= @scope.fleet? ? "in this window" : "for #{@scope.label} in this window" %>.
        </p>
        <p class="mt-2 text-sm text-gray-500">
          Usage is swept out of transcripts by <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">TokenUsageIngestionJob</code>
          every ten minutes, and history is swept once by <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">TokenUsageBackfillJob</code>.
          Both run on their own; nothing here needs a shell on the box.
        </p>
      </div>
    <% else %>
      <!-- Headline -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
        <% [
             [ "Total cost", number_to_currency(@totals[:cost_usd], precision: 2), "at list price" ],
             [ "Tokens", number_to_human(@totals[:total_tokens], units: { thousand: "K", million: "M", billion: "B" }, precision: 3), "all buckets" ],
             [ "API calls", number_with_delimiter(@totals[:api_calls]), "deduped by request" ],
             [ "Ad hoc share", number_to_percentage(@totals[:cost_usd].positive? ? @totals[:adhoc_cost_usd] / @totals[:cost_usd] * 100 : 0, precision: 1), "Zimmer's own calls" ]
           ].each do |label, value, hint| %>
          <div class="bg-white shadow rounded-lg px-3 sm:px-4 py-3">
            <div class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= label %></div>
            <div class="mt-1 text-xl sm:text-2xl font-semibold text-gray-900 tabular-nums break-words"><%= value %></div>
            <div class="text-xs text-gray-400 mt-0.5"><%= hint %></div>
          </div>
        <% end %>
      </div>

      <% if @unpriced_models.any? %>
        <div class="mb-6 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3">
          <p class="text-sm text-amber-900">
            <span class="font-semibold">Unpriced models in this window.</span>
            <%= @unpriced_models.join(", ") %> —
            these contribute <span class="font-medium">zero</span> to every figure above.
            Add a rate in <code class="text-xs bg-amber-100 px-1 rounded">TokenPricing::RATES</code>.
          </p>
        </div>
      <% end %>

      <!-- Cost decomposition -->
      <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
        <div class="px-4 py-3 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-900">Where the money goes</h2>
          <p class="text-xs text-gray-500 mt-0.5">
            By kind of token. Cache writes bill at 1.25&times; base input on the 5-minute TTL and 2&times; on the 1-hour one; cache reads at a tenth.
          </p>
        </div>
        <ul class="divide-y divide-gray-100">
          <% @cost_breakdown.each do |row| %>
            <li class="px-4 py-3">
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-sm text-gray-900"><%= row[:component] %></span>
                <span class="text-sm font-medium text-gray-900 tabular-nums whitespace-nowrap">
                  <%= number_to_currency(row[:cost_usd], precision: 2) %>
                  <span class="text-gray-400 font-normal"><%= number_to_percentage(row[:share] * 100, precision: 1) %></span>
                </span>
              </div>
              <div class="mt-1.5 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-indigo-500 rounded-full" style="width: <%= (row[:share] * 100).round(1) %>%"></div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <%= render "daily_chart", by_day: @by_day %>

      <% max_cost = ->(rows) { rows.map { |r| r[:cost_usd] }.max || 0 } %>

      <%# The by-root drilldown. Two rows get no link: the folded "other (N)"
          bucket, which is several roots at once and so not one thing to narrow
          to, and every row on a page already scoped to a root, where the only
          row left is the one you are looking at. %>
      <% root_link = lambda do |row|
           next nil unless @scope.fleet?
           next nil if row[:agent_root].to_s.start_with?("other (")
           costs_path(@window.to_params.merge(agent_root: row[:agent_root]))
         end %>
      <%= render "bar_table", rows: @by_agent_root, label_key: :agent_root,
            title: "By agent root",
            subtitle: @scope.fleet? ? "Open a row for its estimated context-feature split, or narrow the whole page to it." : "Open a row for its estimated context-feature split.",
            empty: "No session spend in this window.",
            max: max_cost.call(@by_agent_root), total: @totals[:cost_usd],
            detail_key: :features, detail_label: :feature, link_for: root_link %>

      <%= render "feature_table", feature: @by_feature %>

      <%# Not on a narrowed page, for the same reason the burn rates are not (see
          the bottom of this file). The cohorts themselves narrow, but the corpus
          they are counted against does not: ExperimentAnalytics reads the
          deployment's whole tagging history to say how many sessions carry each
          label, so under a heading that says one agent root the panel would pair
          that root's two cohorts with the fleet's count of tagged sessions. A
          cohort comparison drawn from one session is not a comparison anyway. %>
      <% if @scope.fleet? %>
        <%= render "experiment_table", reports: @by_experiment, window: @window %>
      <% end %>

      <%= render "bar_table", rows: @by_model, label_key: :model,
            title: "By model", empty: "No spend in this window.",
            max: max_cost.call(@by_model), total: @totals[:cost_usd] %>

      <%= render "bar_table", rows: @by_thread_kind, label_key: :kind,
            title: "Main thread vs subagents", empty: "No session spend in this window.",
            max: max_cost.call(@by_thread_kind), total: @totals[:cost_usd] %>

      <%# Spend by runtime is spend by BILLING RELATIONSHIP: `claude_code` is
          subscription spend priced at list, `pi` is a metered OpenRouter invoice,
          `codex` is subscription spend whose models have no rate yet. Every other
          total on this page adds them together, so without this split a reader
          cannot tell what share of a number is money actually owed — nor that
          Codex contributes tokens and no dollars. %>
      <%= render "bar_table", rows: @by_runtime, label_key: :runtime,
            title: "By runtime",
            subtitle: "By billing relationship, really: Claude Code is subscription-billed and priced at Anthropic list; " \
                      "Pi is metered by OpenRouter, so its share is money actually owed; Codex is subscription-billed and " \
                      "reads $0 here because its models are unpriced — its tokens are in the ledger, its dollars are not.",
            empty: "No session spend in this window.",
            max: max_cost.call(@by_runtime), total: @totals[:cost_usd] %>

      <%# "Recorded" would be a lie on a root-scoped page: ad hoc spend is not
          missing there, it is excluded, because Zimmer's own calls belong to no
          agent root. %>
      <%= render "bar_table", rows: @by_adhoc_source, label_key: :source,
            title: "Ad hoc calls from Zimmer's own code",
            empty: @scope.agent_root? ? "Ad hoc calls belong to no agent root, so none are counted here." : "No ad hoc inference recorded in this window.",
            max: max_cost.call(@by_adhoc_source), total: @totals[:cost_usd] %>

      <!-- Top sessions -->
      <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
        <div class="px-4 py-3 border-b border-gray-200">
          <h2 class="text-sm font-semibold text-gray-900">Most expensive sessions</h2>
        </div>
        <% if @top_sessions.blank? %>
          <p class="px-4 py-6 text-sm text-gray-500">No attributed session spend in this window.</p>
        <% else %>
          <ul class="divide-y divide-gray-100">
            <% @top_sessions.each do |row| %>
              <li class="px-4 py-3">
                <div class="flex items-baseline justify-between gap-3">
                  <%= link_to session_path(row[:session_id]), class: "text-sm text-indigo-600 hover:text-indigo-500 truncate min-w-0" do %>
                    <%= row[:title].presence || "Session ##{row[:session_id]}" %>
                  <% end %>
                  <span class="text-sm font-medium text-gray-900 tabular-nums whitespace-nowrap">
                    <%= number_to_currency(row[:cost_usd], precision: 2) %>
                  </span>
                </div>
                <div class="text-xs text-gray-500 mt-0.5">
                  #<%= row[:session_id] %> &middot; <%= number_with_delimiter(row[:api_calls]) %> calls &middot;
                  <%= number_to_human(row[:tokens], units: { thousand: "K", million: "M", billion: "B" }, precision: 3) %> tokens
                  <% if @scope.fleet? %>
                    &middot;
                    <%= link_to "Only this", costs_path(@window.to_params.merge(session_id: row[:session_id])),
                          class: "font-medium text-indigo-600 hover:text-indigo-500" %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <p class="text-xs text-gray-400">
        Most recent call recorded: <%= @last_ingested_at ? "#{time_ago_in_words(@last_ingested_at)} ago" : "never" %>.
        List price is not a bill — these accounts are subscription-billed, so treat this as a comparable
        unit across models rather than money owed.
      </p>
    <% end %>

    <%# Outside the window branch on purpose: these are CURRENT rates over a fixed
        per-combination sample, not a rollup of the window selected above. A quiet
        24-hour window has no spend to report and the rates are still real.

        Not rendered on a narrowed page, though. These are fleet rates over a
        fixed sample of recent sessions, and under a heading that says "agent root
        X" every other figure on the page is that root's — a reader has no reason
        to suspect this one is not. %>
    <% if @scope.fleet? %>
      <%= render "burn_rates", rates: @burn_rates %>
    <% end %>
  </div>
</div>
