<%# The API keys page (tadasant/zimmer#46). Behind the operator credential — see
    ApiKeysController for why there is no REST or MCP sibling.

    Exempt from Turbo's snapshot cache: after a create this page holds a key that
    must not be restorable by navigating away and back. %>
<% turbo_exempts_page_from_cache %>
<div class="min-h-screen bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <div class="flex items-center mb-4">
        <%= link_to settings_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">API keys</h1>
      </div>
      <p class="text-sm text-gray-600">
        The keys that open the REST API and the MCP endpoint at <code class="bg-gray-100 px-1 rounded">/mcp</code>.
        Every key can do everything — there are no scopes. The request log names the key behind each call,
        and revoking one refuses it from the next request on, without a restart.
      </p>
    </div>

    <div class="space-y-6">
      <% if @minted_token %>
        <div id="minted-key" class="bg-green-50 border border-green-300 rounded-lg px-4 py-4 sm:px-6">
          <h2 class="text-base font-medium text-green-900">Created <%= @api_key.name %></h2>
          <p class="mt-1 text-sm text-green-800">
            Copy it now. Zimmer keeps only a digest of it, so this is the one time it can be shown.
          </p>
          <input type="text" readonly value="<%= @minted_token %>" aria-label="New API key"
                 class="mt-3 block w-full font-mono text-xs sm:text-sm border-green-300 rounded-md bg-white px-3 py-2">
        </div>
      <% end %>

      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Create a key</h2>
          <p class="mt-1 text-sm text-gray-500">
            Name it after whatever will hold it — the name is what the log prints.
          </p>
        </div>
        <div class="px-4 py-5 sm:px-6">
          <% if @create_errors.present? %>
            <div class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
              <%= @create_errors.join(", ") %>
            </div>
          <% end %>
          <%# Turbo off: the response that answers this form renders the new key, and
              Turbo Drive only follows a form with a redirect. %>
          <%= form_with url: api_keys_path, method: :post, data: { turbo: false } do %>
            <div class="flex flex-col sm:flex-row gap-3">
              <label for="api_key_name" class="sr-only">Name</label>
              <input type="text" name="api_key[name]" id="api_key_name" required maxlength="100"
                     value="<%= @attempted_name %>" placeholder="e.g. laptop scripts"
                     class="flex-1 min-w-0 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md px-3 py-2">
              <button type="submit"
                      class="inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Create key
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Keys</h2>
          <p class="mt-1 text-sm text-gray-500">
            Keys from the <code class="bg-gray-100 px-1 rounded"><%= ApiKey::ENV_VAR %></code> variable are listed
            under their fingerprint — the first <%= ApiKey::FINGERPRINT_LENGTH %> characters of
            <code class="bg-gray-100 px-1 rounded">printf %s "$KEY" | sha256sum</code>. Last used is recorded to the minute.
          </p>
          <p class="mt-2 text-sm text-gray-500">
            Agent sessions carry the whole <code class="bg-gray-100 px-1 rounded"><%= ApiKey::ENV_VAR %></code> variable in
            their environment, so every entry there is within an agent's reach. Only a minted key is not.
          </p>
        </div>

        <% if @api_keys.empty? %>
          <p class="px-4 py-5 sm:px-6 text-sm text-gray-500">
            No keys. Nothing can call the API until one exists — set <code class="bg-gray-100 px-1 rounded"><%= ApiKey::ENV_VAR %></code> or create one above.
          </p>
        <% else %>
          <ul class="divide-y divide-gray-200">
            <% @api_keys.each do |api_key| %>
              <% retired = api_key.retired? %>
              <% self_session = api_key.self_session_key?(@self_session_digest) %>
              <li id="<%= dom_id(api_key) %>" class="px-4 py-4 sm:px-6">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-medium text-gray-900 break-all"><%= api_key.name %></span>
                      <% if api_key.revoked? %>
                        <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Revoked</span>
                      <% elsif retired %>
                        <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700"
                              title="No longer in <%= ApiKey::ENV_VAR %>, so it authenticates nothing">Retired</span>
                      <% else %>
                        <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Active</span>
                      <% end %>
                      <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
                        <%= api_key.env? ? ApiKey::ENV_VAR : "Minted" %>
                      </span>
                      <% if self_session %>
                        <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800"
                              title="This deployment writes this key into every agent session's Zimmer MCP servers">Agent sessions use this key</span>
                      <% end %>
                    </div>
                    <dl class="mt-1 text-xs text-gray-500 space-y-0.5">
                      <div>
                        <dt class="inline">Fingerprint</dt>
                        <dd class="inline font-mono"><%= api_key.fingerprint %></dd>
                      </div>
                      <div>
                        <dt class="inline">Last used</dt>
                        <dd class="inline">
                          <% if api_key.last_used_at %>
                            <%= time_ago_in_words(api_key.last_used_at) %> ago
                            <span class="text-gray-400">(<%= api_key.last_used_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>)</span>
                          <% else %>
                            never
                          <% end %>
                        </dd>
                      </div>
                      <div>
                        <dt class="inline">Created</dt>
                        <dd class="inline"><%= api_key.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></dd>
                      </div>
                      <% if api_key.revoked? %>
                        <div>
                          <dt class="inline">Revoked</dt>
                          <dd class="inline"><%= api_key.revoked_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></dd>
                        </div>
                      <% end %>
                    </dl>
                  </div>

                  <div class="shrink-0">
                    <% if api_key.revoked? %>
                      <%= button_to "Restore", restore_api_key_path(api_key),
                            class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                    <% else %>
                      <% confirm = if self_session
                           "Revoke #{api_key.name}? Every agent session uses this key for its Zimmer MCP servers — they will all lose them until the key is restored or the deployment's self-session key is replaced."
                         elsif api_key.env?
                           "Revoke #{api_key.name}? Agent sessions carry every #{ApiKey::ENV_VAR} entry in their environment, so a script of theirs may be using it. Requests carrying it are refused from the next one on. You can restore it here."
                         else
                           "Revoke #{api_key.name}? Requests carrying it are refused from the next one on. You can restore it here."
                         end %>
                      <%= button_to "Revoke", revoke_api_key_path(api_key),
                            form: { data: { turbo_confirm: confirm } },
                            class: "inline-flex items-center px-3 py-1.5 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>
