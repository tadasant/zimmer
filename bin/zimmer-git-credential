#!/usr/bin/env bash
# git credential helper for github.com: hands git the token for the repository's
# OWNER, from the token map GhTokenProvisioner publishes into the environment.
#
# Wired in Dockerfile.base as
#
#   credential.https://github.com.helper   !/rails/bin/zimmer-git-credential
#   credential.https://github.com.useHttpPath true
#
# useHttpPath is what makes git send `path=<owner>/<repo>.git`; without it git asks
# about the host alone and there is no owner to route on.
#
# The routing rule is GithubTokens' (app/services/github_tokens.rb), restated here
# because git spawns this helper itself, with no Ruby in reach:
#
#   1. GH_TOKEN__<OWNER> when set (owner upper-cased, `-` folded to `_`).
#   2. Else GH_TOKEN, when the owner is ZIMMER_GITHUB_DEFAULT_OWNER or no default
#      owner is configured.
#   3. Else nothing: git proceeds without a credential, and a private repository
#      fails closed.
#
# Tokens arrive only through the environment — inherited from the Rails worker, or
# from a session's narrowed copy of it (GithubTokens.session_env). Never argv, which
# any process can read in `ps`, and never a file. The token goes to git on stdout,
# which is the helper protocol.
#
# Until ZIMMER_GITHUB_CREDENTIAL_ROUTING is set — no token has been seeded yet — this
# delegates to `gh auth git-credential`, so the stored `gh auth login` credential
# authenticates git.
#
# A request with no `path=` (useHttpPath overridden somewhere) names no owner, and is
# treated as an unknown owner: GH_TOKEN only when no default owner is configured.
# GithubTokens' nil owner means something else — a `gh` call about no repository at
# all, which the default token answers — and git never asks that question.
#
# `store` and `erase` are no-ops in routing mode: the map is owned by the secret
# store, and nothing git learns about a credential is written back.
set -u

if [ -z "${ZIMMER_GITHUB_CREDENTIAL_ROUTING:-}" ]; then
  exec gh auth git-credential "$@"
fi

[ "${1:-}" = "get" ] || exit 0

protocol=""
host=""
path=""
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done

[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0

owner="${path%%/*}"
token=""

# The owner becomes part of a variable name read by indirect expansion, so it must
# be exactly a GitHub owner name — anything else is not one, and is not expanded.
if [[ "$owner" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]]; then
  variable="GH_TOKEN__$(printf '%s' "$owner" | tr '[:lower:]-' '[:upper:]_')"
  token="${!variable:-}"
else
  owner=""
fi

if [ -z "$token" ]; then
  default_owner="${ZIMMER_GITHUB_DEFAULT_OWNER:-}"
  if [ -z "$default_owner" ] || { [ -n "$owner" ] && [ "${owner,,}" = "${default_owner,,}" ]; }; then
    token="${GH_TOKEN:-}"
  fi
fi

[ -n "$token" ] || exit 0

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$token"
