#!/bin/bash -e

# ---------------------------------------------------------------------------
# Nested Docker (sysbox), and the privilege drop that goes with it
#
# The image normally runs as uid 1000. `dockerd` will not: it needs root inside
# the container. Under the sysbox runtime that is cheap and safe -- the container
# has its own user namespace, so its root maps to an unprivileged host uid (0 ->
# 100000) and cannot touch the host. Under runc it would be real host root, which
# is why the whole block is opt-in and refuses to run without sysbox underneath.
#
# So the worker starts as root, brings up its own daemon, and then drops back to
# 1000 for everything else. The app must NOT keep running as root: the clones
# volume is shared with `web`, which runs as 1000, and root-owned files written
# here would be unwritable there.
#
# Nothing changes for anyone else. A container started as 1000 -- `web`, dev,
# test, CI -- skips this entirely and the entrypoint behaves exactly as before.
# ---------------------------------------------------------------------------
if [ "$(id -u)" = "0" ]; then
  # setpriv changes credentials. It does NOT touch the environment, so whatever
  # HOME the container started with survives the drop. Under `user: "0:0"` the
  # runtime would derive that from uid 0 and hand the app /root -- mode 0700 and
  # owned by root, which uid 1000 cannot even traverse.
  #
  # The image pins `ENV HOME=/home/rails` so it never comes to that (a runtime only
  # synthesizes HOME when it is absent). This block re-derives it from /etc/passwd
  # anyway, and treats that as the authority: the two cannot silently disagree, and
  # a container run against an image without the ENV is still correct here.
  #
  # That is not cosmetic. libpq probes $HOME/.postgresql/postgresql.crt on every
  # TLS connection and tolerates only ENOENT/ENOTDIR; EACCES is fatal. So with
  # HOME=/root the worker opens no database connection at all -- it boots, logs,
  # and never claims a job. That is exactly how 2026-08-13's ten-hour production
  # freeze presented: `could not open certificate file
  # "/root/.postgresql/postgresql.crt": Permission denied`, 44,302 times, while
  # every container-shaped health check stayed green.
  #
  # ~/.claude, ~/.config/gh and ~/.local are Kamal volumes mounted under
  # /home/rails too, so a stale HOME strands the agent sessions as well.
  #
  # This runs before the dockerd block below because it is cheap and unconditional:
  # a container that cannot hand over should say so in a second, rather than after
  # a 30s daemon wait it will then abandon.
  #
  # Read from /etc/passwd rather than hardcoded, so this cannot drift from the uid
  # the exec below drops to. `head -1` because Dockerfile.base's useradd allows
  # --non-unique, and two entries would splice a newline into HOME.
  app_passwd="$(getent passwd 1000 2>/dev/null || awk -F: '$3 == 1000 { print; exit }' /etc/passwd)"
  app_passwd="$(printf '%s\n' "$app_passwd" | head -1)"

  # No plausible default here. `setpriv --init-groups` cannot resolve uid 1000
  # either, so a guessed HOME could only ever substitute a confident-looking wrong
  # diagnosis for the real one.
  if [ -z "$app_passwd" ]; then
    echo "Refusing to start: no uid 1000 in /etc/passwd, so there is no app user to" >&2
    echo "drop to. The image is supposed to create one (Dockerfile.base: useradd" >&2
    echo "rails --uid 1000). Running on as root would write root-owned files into" >&2
    echo "the volumes 'web' shares at uid 1000." >&2
    exit 1
  fi

  export HOME="$(printf '%s' "$app_passwd" | cut -d: -f6)"
  export USER="$(printf '%s' "$app_passwd" | cut -d: -f1)"
  export LOGNAME="$USER"

  # Then prove it, as the user that is about to have to live with it: -x to
  # traverse (libpq's failure was an open through an untraversable directory) and
  # -w to write. The whole lesson of that outage is that this must be loud -- a
  # container that refuses to start is a failed deploy, while one that starts and
  # quietly claims nothing is ten hours of silence.
  #
  # Any nonzero status refuses, not just an unwritable HOME: setpriv also fails
  # here if it cannot assume the uid at all, and that is equally disqualifying.
  # Its own error goes to stderr immediately above this message.
  if ! setpriv --reuid=1000 --regid=1000 --init-groups test -x "$HOME" -a -w "$HOME"; then
    echo "Refusing to start: uid 1000 cannot use HOME=$HOME (see any setpriv error" >&2
    echo "above). Everything the app derives from HOME -- libpq's TLS client certs," >&2
    echo "~/.claude, ~/.config/gh, ~/.local -- would fail, and the worker would run" >&2
    echo "without ever claiming a job." >&2
    exit 1
  fi

  if [ "${ZIMMER_NESTED_DOCKER:-0}" = "1" ]; then
    # A user namespace is the thing that makes running as root here defensible, and
    # it is exactly what is missing under plain runc. Refuse rather than silently
    # handing an agent session real host root.
    if [ "$(sed -n '1s/^ *0 *\([0-9]*\).*/\1/p' /proc/self/uid_map)" = "0" ]; then
      echo "ZIMMER_NESTED_DOCKER=1 but this container is not user-namespaced." >&2
      echo "Its root IS host root, so starting dockerd here would hand every agent" >&2
      echo "session root on the host. Run this role under runtime: sysbox-runc, or" >&2
      echo "unset ZIMMER_NESTED_DOCKER. See docs/operate/nested-docker.md." >&2
      exit 1
    fi

    # --group 1000 hands the socket to the group the app runs as; without it the
    # socket is root-only and every `docker` call after the privilege drop fails.
    dockerd --group 1000 >/tmp/dockerd.log 2>&1 &

    # Wait, but never forever: a session that finds no daemon gets a clear error
    # from `docker` itself, which beats the container never becoming healthy.
    for _ in $(seq 1 30); do
      [ -S /var/run/docker.sock ] && break
      sleep 1
    done
    if [ ! -S /var/run/docker.sock ]; then
      echo "Warning: nested dockerd did not come up in 30s; see /tmp/dockerd.log" >&2
      tail -5 /tmp/dockerd.log >&2 2>/dev/null || true
    fi
  fi

  # ---------------------------------------------------------------------------
  # Delegate a cgroup subtree to uid 1000, so each agent session can be given its
  # own memory.max.
  #
  # The problem this solves is in app/services/session_memory_cgroup.rb: every
  # session on the box shares this container's single 10 GiB cap with the Rails
  # worker and the inner dockerd, so one session's runaway command can spend the
  # whole budget and the kernel then picks a victim by oom_score rather than by
  # blame (tadasant/zimmer#815).
  #
  # Only root can create a cgroup and enable a controller on it, and only this
  # script is root here -- which is why the setup lives in the entrypoint and the
  # per-session part lives in the app.
  #
  # The shape is cgroup v2's documented delegation model, and the `app` child is
  # load-bearing rather than tidiness. Migrating a process needs write access to
  # the cgroup.procs of the COMMON ANCESTOR of source and destination. With the
  # app left where it starts, that ancestor is the container's cgroup root, which
  # is root-owned -- so uid 1000 could create session cgroups and then not move
  # anything into them. Putting the app in a sibling under the delegated parent
  # makes the common ancestor the delegated parent itself, which uid 1000 owns.
  # The alternative was chowning the container's root cgroup.procs, which widens
  # uid 1000's reach over every cgroup in the container to buy the same thing.
  #
  # Every step tolerates failure. This needs a writable cgroup2 filesystem, which
  # the worker has only because sysbox gives it its own cgroup namespace; under
  # plain runc /sys/fs/cgroup is read-only. A container without it runs sessions
  # exactly as it did before -- unbounded -- and SessionMemoryCgroup.available?
  # reports false rather than erroring on the spawn path.
  #
  # Runs AFTER the dockerd block on purpose: dockerd stays in the cgroup it was
  # started in, so the inner daemon and the containers it manages are not caught
  # up in a subtree meant for session processes.
  # ---------------------------------------------------------------------------
  # One variable, read here and by SessionMemoryCgroup, so the entrypoint cannot delegate
  # a directory the app then does not look in. The cgroup filesystem root is its parent by
  # construction -- that is the cgroup whose subtree_control has to offer the memory
  # controller for a child to be able to carry a memory.max.
  zimmer_cgroup_root="${ZIMMER_SESSION_CGROUP_ROOT:-/sys/fs/cgroup/zimmer.sessions}"
  # Says which step gave up, and gives up. Silence here would be the worst of the
  # options: the app would run every session unbounded -- the exact state #815 is
  # about -- with nothing in the boot log to say why.
  zimmer_cgroup_skip() {
    echo "Per-session memory bounds are OFF: $1." >&2
    echo "Sessions will run unbounded, as they did before tadasant/zimmer#815. This is" >&2
    echo "expected without sysbox (a read-only /sys/fs/cgroup) -- see" >&2
    echo "docs/operate/nested-docker.md." >&2
    return 1
  }

  zimmer_delegate_cgroups() {
    local fs_root
    fs_root="$(dirname "$zimmer_cgroup_root")"
    [ -d "$fs_root" ] || { zimmer_cgroup_skip "no $fs_root"; return; }

    # The memory controller has to be available to the container at all, and
    # enabled for the root's children, before a child can carry a memory.max.
    grep -qw memory "$fs_root/cgroup.controllers" 2>/dev/null ||
      { zimmer_cgroup_skip "the memory controller is not available in this container"; return; }
    if ! grep -qw memory "$fs_root/cgroup.subtree_control" 2>/dev/null; then
      echo "+memory" > "$fs_root/cgroup.subtree_control" 2>/dev/null ||
        { zimmer_cgroup_skip "could not enable the memory controller on $fs_root"; return; }
    fi

    mkdir -p "$zimmer_cgroup_root/app" 2>/dev/null ||
      { zimmer_cgroup_skip "could not create $zimmer_cgroup_root (is /sys/fs/cgroup read-only?)"; return; }
    echo "+memory" > "$zimmer_cgroup_root/cgroup.subtree_control" 2>/dev/null ||
      { zimmer_cgroup_skip "could not enable the memory controller on $zimmer_cgroup_root"; return; }

    # Move this shell in BEFORE handing the parent over, because the chown is what
    # SessionMemoryCgroup.available? reads. Chowning first and failing here would
    # leave uid 1000 able to CREATE session cgroups but unable to move anything into
    # one -- the common ancestor would still be the root-owned container cgroup. The
    # app would then wrap every spawn, litter a cgroup per session, and report zero
    # usage forever. That state is worse than off, so it must not be reachable.
    #
    # `exec setpriv` below keeps this pid and children inherit the cgroup, so the
    # whole app lands in $zimmer_cgroup_root/app -- which is what makes the delegated
    # parent the common ancestor for every later session migration.
    echo $$ > "$zimmer_cgroup_root/app/cgroup.procs" 2>/dev/null ||
      { zimmer_cgroup_skip "could not move the app into $zimmer_cgroup_root/app"; return; }

    # Only now the three files cgroup v2 says to hand over with the directory.
    # Ownership of the directory is what permits mkdir; ownership of cgroup.procs is
    # what permits the migration.
    chown 1000 "$zimmer_cgroup_root" \
                "$zimmer_cgroup_root/cgroup.procs" \
                "$zimmer_cgroup_root/cgroup.subtree_control" \
                "$zimmer_cgroup_root/cgroup.threads" 2>/dev/null ||
      { zimmer_cgroup_skip "could not delegate $zimmer_cgroup_root to uid 1000"; return; }

    echo "Per-session memory bounds are available (delegated $zimmer_cgroup_root to uid 1000)." >&2
  }
  zimmer_delegate_cgroups || true

  # ---------------------------------------------------------------------------
  # Reclaim root-owned files in the volumes the app uses at uid 1000.
  #
  # Dropping THIS process to 1000 does not make the container safe for the app,
  # because this process is not the only thing that runs as root in it. Anything
  # that enters the container without going through this script -- `docker exec`,
  # which inherits the configured user (`user: "0:0"`) and never runs an
  # ENTRYPOINT -- is root, and since the image pins HOME=/home/rails its writes
  # land in the named volumes `web` and this role share at uid 1000. A file
  # written there at mode 0600 root:root is one uid 1000 cannot read at all.
  #
  # That is not hypothetical. On staging, `~/.claude/projects/-app/` held four
  # such files, three of them Claude Code session transcripts -- exactly what
  # transcript polling reads as uid 1000 -- plus a world-writable directory.
  # The writer was a `.agent-containers` dev stack, whose `app` service runs as
  # root and bind-mounts `${HOME}/.claude` straight into itself; the same shape
  # left 4,442 root-owned bootsnap files in a clone that uid 1000 then could not
  # delete, which is what makes `ac.sh destroy` unreliable.
  #
  # There is no way to make an arbitrary root process write as 1000 -- root is
  # root. So rather than trying to enumerate every writer, reclaim the result:
  # sweep the volume roots and hand anything not owned by 1000 back to it. This
  # is the only place in the system that can, because it is the only place that
  # is both root and knows the invariant. Once, synchronously, so the app never
  # starts on a volume it cannot read; then on a timer, because a pass that only
  # fixes what exists leaves the next exec free to recreate it.
  #
  # Eventually consistent, and honest about it: a file written by root is
  # unreadable for up to $ZIMMER_RECLAIM_INTERVAL seconds. That is fine for what
  # this protects -- the transcripts Zimmer itself polls are written by the app
  # at uid 1000 and were never the problem -- and it is the difference between a
  # volume that degrades permanently and one that heals.
  #
  # Measured on staging: one sweep of all five roots, 88,285 inodes, is 0.77s
  # wall and 0.58s CPU. At the default interval that is ~1% of one core.
  # ---------------------------------------------------------------------------

  # Named one by one rather than as "everything under $HOME", because $HOME also
  # holds container-layer state baked into the image, which is not ours to
  # rewrite and does not persist anyway. These five are exactly the volumes both
  # roles mount (config/deploy.*.yml).
  #
  # An array, so a $HOME with a space in it cannot split one root into two
  # operands -- $HOME comes from /etc/passwd and nothing here validates it.
  zimmer_reclaim_roots=()
  for d in "$HOME/.claude" "$HOME/.codex" "$HOME/.config/gh" "$HOME/.local" "$HOME/.zimmer"; do
    if [ -d "$d" ]; then
      zimmer_reclaim_roots+=("$d")
    fi
  done

  zimmer_reclaim() {
    [ "${#zimmer_reclaim_roots[@]}" -gt 0 ] || return 0

    # Collected first and chowned in batches, rather than one `chown` per file --
    # which is what keeps the 4,442-file case cheap. `xargs` still splits at
    # ARG_MAX, so a large sweep is several invocations, not one.
    #
    # -H follows a symlinked root, because `[ -d ]` above already did: without it
    # a root that became a symlink would be swept as a single inode while still
    # logging as though it had run. Symlinks *inside* a root are still not
    # followed -- only the operands are.
    #
    # -xdev because every root is named explicitly, so find never has to cross a
    # mount to reach one -- while a dev stack's own container filesystems can
    # appear *underneath* these paths, and those are not ours to rewrite.
    #
    # -h so a symlink is retargeted rather than its target, which may live
    # outside the volume entirely.
    zimmer_reclaim_list="$(mktemp)" || return 0
    find -H "${zimmer_reclaim_roots[@]}" -xdev ! -uid 1000 -print0 \
      >"$zimmer_reclaim_list" 2>/dev/null || true

    # `|| ... =0` because this is the one command here whose failure would
    # otherwise abort the boot under `-e`: a repair that takes down the app it
    # exists to protect is a worse bargain than a repair that skips a pass.
    zimmer_reclaim_n="$(tr -cd '\000' <"$zimmer_reclaim_list" | wc -c)" || zimmer_reclaim_n=0
    if [ "${zimmer_reclaim_n:-0}" -gt 0 ]; then
      xargs -0r chown -h 1000:1000 <"$zimmer_reclaim_list" 2>/dev/null || true
      echo "Reclaimed $zimmer_reclaim_n path(s) not owned by uid 1000 in the app's volumes." >&2
    fi

    rm -f "$zimmer_reclaim_list"
    return 0
  }

  zimmer_reclaim

  # `while sleep` rather than `while :; do sleep`: the loop then ends when sleep
  # does, which is what lets a test drive it to a stop instead of hanging on the
  # inherited stdout forever. An interval of 0 drops the repeat and keeps the
  # boot sweep, which is the correctness half and costs under a second.
  ZIMMER_RECLAIM_INTERVAL="${ZIMMER_RECLAIM_INTERVAL:-60}"
  if [ "$ZIMMER_RECLAIM_INTERVAL" -gt 0 ] 2>/dev/null; then
    while sleep "$ZIMMER_RECLAIM_INTERVAL"; do zimmer_reclaim; done &
  elif [ "$ZIMMER_RECLAIM_INTERVAL" != "0" ]; then
    # `[` writes "integer expression expected" to a stderr this discards, so an
    # unparseable value would otherwise turn the healing half off in silence and
    # leave a container that looks entirely healthy.
    echo "ZIMMER_RECLAIM_INTERVAL='$ZIMMER_RECLAIM_INTERVAL' is not a positive integer;" >&2
    echo "the repeat sweep is off. Root-owned files written into the app's volumes after" >&2
    echo "boot will stay unreadable at uid 1000 until the next restart. Use 0 to mean this" >&2
    echo "deliberately." >&2
  fi

  # Re-exec this same script as the app user. --init-groups picks up the
  # supplementary groups; without it the process keeps only gid 1000 and loses
  # whatever else the rails user belongs to.
  #
  # The sweep above is forked, not exec'd, so it survives this and keeps its root
  # credentials -- which it needs, since chown is root-only.
  exec setpriv --reuid=1000 --regid=1000 --init-groups "$0" "$@"
fi

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Configure git to use the gh CLI for GitHub authentication.
# The gh OAuth token from `gh auth login` is mounted as a volume at ~/.config/gh.
# Dockerfile.base bakes in `credential.https://github.com.helper = !gh auth git-credential`,
# so this step is currently belt-and-suspenders — `gh auth setup-git` reaffirms the
# helper config in case it was mutated by a downstream layer or runtime config.
if gh auth status &>/dev/null; then
    gh auth setup-git 2>/dev/null || true
fi

# Ensure image storage directory exists with correct permissions.
# Docker volumes are created with root ownership by default, but this script
# runs as user 1000:1000 (rails). The volume mount should be owned by the
# container user, so mkdir -p will work if permissions are correct.
# If the directory can't be created, log a warning but continue (the app
# will fail gracefully when trying to upload images).
IMAGE_STORAGE_DIR="/tmp/agent-orchestrator-images"
if [ ! -d "$IMAGE_STORAGE_DIR" ]; then
    mkdir -p "$IMAGE_STORAGE_DIR" 2>/dev/null || echo "Warning: Could not create $IMAGE_STORAGE_DIR - image uploads may fail"
fi

# Update Claude Code CLI and Playwright browsers in the background.
# These are network-dependent operations that can take 30s+ (npm downloads,
# Chromium installs), which blocks Rails from booting and causes the Kamal
# health check to time out. Running them in the background lets Rails start
# immediately while updates complete asynchronously.
#
# Claude CLI: ~/.local is a Docker named volume that persists across deploys,
# so the binary baked into the image gets shadowed by the volume's stale copy.
# Playwright: MCP servers use playwright-stealth-mcp-server@latest which may
# need a newer Chromium than what was installed at Docker build time.
#
# Sessions that start before the updates finish would otherwise use the prior
# version silently, so the block writes a readiness marker when it finishes and
# exports the path. BootTasksReadiness (app/services/boot_tasks_readiness.rb)
# reads it on the spawn path and waits, briefly and with a deadline, before
# launching a runtime CLI. Exporting the variable here is what arms that gate:
# processes that never run this entrypoint (dev, test, bin/dev) never wait.
export ZIMMER_BOOT_TASKS_MARKER="${ZIMMER_BOOT_TASKS_MARKER:-/tmp/zimmer-boot-tasks-ready}"
rm -f "$ZIMMER_BOOT_TASKS_MARKER" 2>/dev/null || true

{
  boot_tasks_status=""

  if command -v claude &>/dev/null; then
    claude update 2>&1 || {
      echo "Warning: Claude CLI update failed, continuing with existing version"
      boot_tasks_status="${boot_tasks_status}claude-update-failed "
    }
  fi

  if [ -x "./bin/ensure-playwright-browsers" ]; then
    ./bin/ensure-playwright-browsers || boot_tasks_status="${boot_tasks_status}playwright-install-failed "
  fi

  # Always write the marker, including on failure: the gate must unblock either
  # way. The contents are what tell the spawn path whether to warn.
  #
  # Written to a temp path and renamed, because a plain `>` truncates the target
  # before the content lands: a reader polling in that gap would see a marker that
  # exists and is empty, read it as a clean finish, and drop the very warning this
  # block exists to raise. Rename within one directory is atomic.
  if echo "${boot_tasks_status:-ok}" > "$ZIMMER_BOOT_TASKS_MARKER.tmp" 2>/dev/null; then
    mv -f "$ZIMMER_BOOT_TASKS_MARKER.tmp" "$ZIMMER_BOOT_TASKS_MARKER" 2>/dev/null || true
  fi
} &

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
